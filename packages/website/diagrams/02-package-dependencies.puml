@startuml
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam linetype ortho

title Nerve workspace packages: purposes and allowed dependencies

package "Shared desktop foundations" as foundations {
  component "@nervekit/contracts\nTransport-neutral API, operation,\nevent, policy, and storage schemas" as contracts
  component "@nervekit/protocol\nProtocol v1 codec, sessions, RPC,\nreplay, cursors, and bounded delivery" as protocol
  component "@nervekit/harness\nModel conversation, harness,\nand agent loop runtime" as harness
  component "@nervekit/tools\nCanonical coding tool catalog,\nexecutors, and policy contracts" as tools
  component "@nervekit/native\nNormalized Rust N-API Git, process,\nplatform, and runtime primitives" as native
  component "@nervekit/ui-kit\nContract-free shadcn-svelte primitives,\ntheme, utilities, and renderers" as ui_kit
}

package "Desktop workbench" as local {
  component "@nervekit/workbench-server\nHTTP/WebSocket daemon, persistence, host use cases,\nprocess drivers, runtime, and static web host" as workbench_server
  component "@nervekit/workbench-app\nSvelte browser entrypoint, product presentation,\nand feature state/effect adapters" as workbench_app
  component "@nervekit/desktop-shell\nElectron launcher, desktop capabilities,\nand local-server ownership" as desktop_shell
}

protocol -[#3567a8]-> contracts
harness -[#3567a8]-> contracts
tools -[#3567a8]-> contracts

workbench_server -[#3567a8]-> contracts
workbench_server -[#3567a8]-> protocol
workbench_server -[#3567a8]-> harness
workbench_server -[#3567a8]-> tools
workbench_server -[#3567a8]-> native
workbench_app -[#3567a8]-> contracts
workbench_app -[#3567a8]-> protocol
workbench_app -[#3567a8]-> ui_kit
desktop_shell -[#3567a8]-> contracts
desktop_shell -[#3567a8]-> workbench_server

rectangle "Runtime link (not a package import)" as runtime_links {
  component "workbench-app" as rt_workbench_app
  component "workbench-server" as rt_workbench_server
  rt_workbench_app <..> rt_workbench_server : HTTP / WebSocket\nworkspace and conversation streams
}
runtime_links -[hidden]down-> local

note bottom of contracts
  Contracts remain transport- and framework-neutral.
end note
note bottom of ui_kit
  UI kit intentionally has no @nervekit dependency.
end note
note bottom of workbench_server
  Port-driven run semantics and concrete process drivers
  remain separate internal directory boundaries.
end note
note bottom of workbench_app
  Presentation cannot import app shells, feature state,
  or application core infrastructure.
end note

legend bottom
  |<#3567a8> solid arrow | consumer --> allowed compile-time @nervekit dependency |
  | dotted double arrow | runtime network communication, not an import dependency |
  The compile-time graph and internal purity rules are enforced by scripts/check-package-boundaries.mjs.
endlegend
@enduml
