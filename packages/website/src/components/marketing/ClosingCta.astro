---
import InstallCommand from "./InstallCommand.astro";
import Reveal from "./Reveal.astro";

const steps = [
  { step: "01", label: "Install the desktop shell", meta: "Node.js 24+" },
  { step: "02", label: "Connect a provider", meta: "API key or OAuth" },
  { step: "03", label: "Open your first project", meta: "Any local repository" },
];
---

<section class="closing-section" aria-labelledby="closing-title">
  <div class="container-page">
    <Reveal class="closing">
      <div class="closing-lead">
        <p class="eyebrow">Ready when you are</p>
        <h2 id="closing-title" class="closing-title">
          Run it on your own machine.
        </h2>
        <p class="lede">
          Three steps, no account, and nothing leaves your machine until you ask
          it to.
        </p>

        <div class="closing-actions">
          <a class="btn btn-primary" href="/start/install/">
            Get started <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="https://github.com/ThilinaTLM/nerve">
            View on GitHub
          </a>
        </div>
      </div>

      <div class="closing-setup">
        <ol class="closing-steps">
          {
            steps.map((item) => (
              <li>
                <span class="step-index">{item.step}</span>
                <span class="step-text">
                  <strong>{item.label}</strong>
                  <span class="meta-text">{item.meta}</span>
                </span>
              </li>
            ))
          }
        </ol>

        <InstallCommand class="closing-install" />
        <p class="meta-text closing-note">
          Apache-2.0 · Linux, Windows 11, and macOS · loopback by default
        </p>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .closing-section {
    padding-block: var(--section-pad);
  }

  .closing {
    display: grid;
    min-width: 0;
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--hairline);
  }

  .closing-lead {
    position: relative;
    display: grid;
    min-width: 0;
    gap: 1rem;
    align-content: start;
    justify-items: start;
  }

  /* The terminal bouton discharging once into the call to action. Created and
   * fired by the closing stage; absent with no script. */
  .closing-lead :global(.closing-discharge) {
    position: absolute;
    top: -0.75rem;
    left: -0.75rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-pill);
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--signal) 55%, transparent),
      transparent 70%
    );
    opacity: 0;
    pointer-events: none;
  }

  .closing-title {
    margin: 0;
    max-width: 15ch;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .closing-lead .lede {
    max-width: 32rem;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .closing-actions .btn,
  .closing-actions .btn:hover,
  .closing-actions .btn:focus-visible {
    box-shadow: none;
  }

  .closing-actions .btn-primary::after {
    display: none;
  }

  .closing-setup {
    display: grid;
    min-width: 0;
    gap: 1.25rem;
    align-content: start;
  }

  .closing-steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--hairline);
  }

  .closing-steps li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding-block: 1rem;
  }

  .closing-steps li + li {
    border-top: 1px solid var(--hairline);
  }

  .step-index {
    padding-top: 0.15rem;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .step-text {
    display: grid;
    min-width: 0;
    gap: 0.15rem;
  }

  .step-text strong {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .closing-setup :global(.closing-install),
  .closing-setup :global(.closing-install:hover),
  .closing-setup :global(.closing-install:focus-within) {
    max-width: none;
    box-shadow: none;
  }

  .closing-note {
    margin: 0;
  }

  @media (max-width: 479px) {
    .closing-actions,
    .closing-actions .btn {
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    .closing {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.85fr);
      align-items: start;
    }
  }
</style>