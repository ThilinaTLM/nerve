---
/* The finale, kept calm. One short heartbeat accent sits above the headline,
 * the copyable install command is the hero, and a compact three-step row and
 * a single line of trust chips quietly close the page.
 *
 * The authored markup is the finished state. `closingStage` only replays the
 * flatline-to-beat entrance of the accent and settles the steps in. */
import InstallCommand from "./InstallCommand.astro";
import Reveal from "./Reveal.astro";

const steps = ["Install", "Connect a provider", "Open a project"];

const trust = [
  "Local loopback daemon",
  "State in ~/.nerve",
  "No account or analytics",
  "Apache-2.0",
  "Linux · macOS · Windows 11",
];

/* Flat, then a single beat, then flat again. */
const trace = "M 0 50 L 170 50 L 190 50 L 204 8 L 220 92 L 234 50 L 400 50";
---

<section class="closing-section" aria-labelledby="closing-title">
  <div class="container-page">
    <Reveal class="closing">
      <div class="closing-pulse" aria-hidden="true">
        <svg viewBox="0 0 400 100" preserveAspectRatio="none">
          <path class="pulse-base" d={trace} pathLength="1"></path>
          <path class="pulse-live" d={trace} pathLength="1"></path>
          <path class="pulse-run" d={trace} pathLength="1"></path>
        </svg>
      </div>

      <div class="closing-lead">
        <h2 id="closing-title" class="closing-title">
          Run it on your own machine.
        </h2>
        <p class="closing-lede">
          One command starts a local daemon. Connect a provider and open a
          project.
        </p>
      </div>

      <div class="closing-cta">
        <InstallCommand class="closing-install" />
        <div class="closing-actions">
          <a class="btn btn-primary" href="/start/install/">
            Install Nerve <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="/start/">Read the docs</a>
        </div>
        <a class="closing-github" href="https://github.com/ThilinaTLM/nerve">
          Star on GitHub
        </a>
      </div>

      <ol class="closing-steps" aria-label="Getting started">
        {
          steps.map((label, index) => (
            <li>
              <span class="step-index" aria-hidden="true">
                {index + 1}
              </span>
              {label}
            </li>
          ))
        }
      </ol>

      <ul class="closing-trust" aria-label="Trust facts">
        {trust.map((fact) => <li>{fact}</li>)}
      </ul>
    </Reveal>
  </div>
</section>

<style>
  .closing-section {
    padding-block: clamp(3rem, 6vw, 6rem) clamp(2.5rem, 4vw, 4rem);
  }

  .closing {
    display: grid;
    min-width: 0;
    gap: clamp(1.75rem, 3vw, 2.5rem);
    justify-items: center;
    text-align: center;
  }

  /* One quiet heartbeat accent ---------------------------------------------- */

  .closing-pulse {
    width: min(18rem, 70%);
    height: 2.5rem;
    mask-image: linear-gradient(90deg, transparent, black 25%, black 75%, transparent);
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      black 25%,
      black 75%,
      transparent
    );
  }

  .closing-pulse svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .pulse-base,
  .pulse-live,
  .pulse-run {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .pulse-base {
    stroke: var(--myelin-dim);
    stroke-width: 1.5;
  }

  .pulse-live {
    stroke: var(--primary);
    stroke-width: 1.5;
    filter: drop-shadow(
      0 0 0.4rem color-mix(in oklab, var(--primary) 40%, transparent)
    );
  }

  /* Only the stage turns the travelling pulse on. */
  .pulse-run {
    stroke: var(--signal);
    stroke-width: 2;
    opacity: 0;
    filter: drop-shadow(0 0 0.4rem var(--signal-soft));
  }

  /* Headline ---------------------------------------------------------------- */

  .closing-lead {
    display: grid;
    gap: 1rem;
    justify-items: center;
  }

  .closing-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.2rem + 3.4vw, 3.75rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .closing-lede {
    max-width: 32rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: var(--text-lede);
    line-height: 1.5;
    text-wrap: balance;
  }

  /* Install + actions -------------------------------------------------------- */

  .closing-cta {
    display: grid;
    width: 100%;
    justify-items: center;
    gap: 1.25rem;
  }

  .closing-cta :global(.closing-install) {
    width: 100%;
    max-width: 30rem;
    text-align: left;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .closing-github {
    color: var(--muted-foreground);
    font-size: var(--text-meta);
    text-decoration: underline;
    text-decoration-color: var(--hairline);
    text-underline-offset: 0.3em;
    transition: color 0.2s;
  }

  .closing-github:hover,
  .closing-github:focus-visible {
    color: var(--foreground);
    text-decoration-color: currentColor;
  }

  @media (max-width: 479px) {
    .closing-actions,
    .closing-actions .btn {
      width: 100%;
    }
  }

  /* Steps: a compact numbered row ------------------------------------------- */

  .closing-steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted-foreground);
    font-size: var(--text-meta);
  }

  .closing-steps li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .step-index {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid var(--myelin);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--foreground);
  }

  /* Trust chips --------------------------------------------------------------- */

  .closing-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    max-width: 40rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .closing-trust li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    color: var(--muted-foreground);
    font-size: 0.72rem;
    white-space: nowrap;
  }
</style>
