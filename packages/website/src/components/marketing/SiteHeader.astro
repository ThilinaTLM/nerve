---
import NerveMark from "../NerveMark.astro";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { label: "Docs", href: "/start/overview/" },
  { label: "Guides", href: "/guides/workbench/" },
  { label: "Security", href: "/operations/security/" },
  { label: "Developers", href: "/developers/architecture/" },
];
---

<header data-site-header class="site-header">
  <div class="container-page flex h-[var(--nav-height)] items-center gap-4">
    <a class="brand" href="/" aria-label="Nerve home">
      <span class="brand-mark">
        <NerveMark size={20} />
      </span>
      <span class="brand-word">Nerve</span>
    </a>

    <nav class="ml-6 hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a class="nav-link" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <ThemeToggle />
      <a
        class="btn btn-ghost btn-sm hidden sm:inline-flex"
        href="https://github.com/ThilinaTLM/nerve"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.35-1.3-1.7-1.3-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.03 1.78 2.7 1.27 3.36.97.1-.75.4-1.27.73-1.56-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
        GitHub
      </a>
      <a class="btn btn-primary btn-sm" href="/start/install/">Get started</a>

      <details class="mobile-menu lg:hidden">
        <summary
          class="btn btn-ghost btn-icon"
          aria-label="Toggle navigation menu"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="mobile-panel surface-card">
          {
            links.map((link) => (
              <a href={link.href}>
                {link.label}
              </a>
            ))
          }
          <a href="https://github.com/ThilinaTLM/nerve">GitHub</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      border-color 300ms var(--ease-out-expo),
      background-color 300ms var(--ease-out-expo),
      backdrop-filter 300ms var(--ease-out-expo);
  }

  .site-header[data-scrolled="true"] {
    border-bottom-color: var(--hairline);
    background-color: var(--glass);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid var(--hairline);
    border-radius: 0.7rem;
    background: linear-gradient(
      150deg,
      color-mix(in oklab, var(--primary) 22%, transparent),
      transparent
    );
    transition: transform 320ms var(--ease-spring);
  }

  .brand:hover .brand-mark {
    transform: rotate(-6deg) scale(1.06);
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    display: grid;
    gap: 0.15rem;
    min-width: 12rem;
    padding: 0.5rem;
    animation: rise-in 220ms var(--ease-out-expo) both;
  }

  .mobile-panel a {
    padding: 0.55rem 0.7rem;
    border-radius: 0.6rem;
    color: var(--foreground);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms var(--ease-out-expo);
  }

  .mobile-panel a:hover,
  .mobile-panel a:focus-visible {
    background-color: color-mix(in oklab, var(--primary) 14%, transparent);
  }
</style>
