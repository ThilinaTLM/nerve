---
/* The floating install control on the home page: one compact pill that
 * links to the install guide. Hovering or focusing it reveals the install
 * command above it, ready to copy. It steps aside while the closing section,
 * which carries the same call to action, is on screen
 * (`[data-install-fab-hide]`). On touch screens only the pill shows.
 */
import InstallCommand from "./InstallCommand.astro";
---

<div class="install-fab" data-install-fab>
  <div class="install-fab-pop">
    <InstallCommand hint="" class="install-fab-command" />
  </div>
  <a class="install-fab-pill" href="/start/install/">
    <span class="install-fab-mark" aria-hidden="true">
      <img src="/favicon.svg" alt="" width="18" height="18" />
    </span>
    <span>Install Nerve</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
  </a>
</div>

<script>
  const fab = document.querySelector<HTMLElement>("[data-install-fab]");
  const closing = document.querySelector("[data-install-fab-hide]");
  if (fab && closing) {
    new IntersectionObserver(([entry]) => {
      fab.classList.toggle("is-hidden", entry?.isIntersecting ?? false);
    }).observe(closing);
  }
</script>

<style>
  .install-fab {
    position: fixed;
    right: clamp(0.75rem, 2vw, 1.75rem);
    bottom: clamp(0.75rem, 2vw, 1.75rem);
    z-index: 40;
    display: grid;
    justify-items: end;
    gap: 0.5rem;
    transition:
      opacity 300ms ease,
      translate 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .install-fab.is-hidden {
    opacity: 0;
    translate: 0 1.5rem;
    pointer-events: none;
  }

  .install-fab-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 2.9rem;
    padding: 0 1.1rem 0 0.4rem;
    border: 1px solid color-mix(in oklab, var(--primary) 45%, var(--hairline));
    border-radius: var(--radius-pill);
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, var(--primary) 18%, var(--card)),
        var(--card) 70%
      );
    color: var(--foreground);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow:
      0 0.75rem 2rem -0.75rem color-mix(in oklab, black 60%, transparent),
      0 0 0 4px color-mix(in oklab, var(--primary) 8%, transparent);
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .install-fab-pill:hover,
  .install-fab-pill:focus-visible {
    border-color: var(--primary);
    box-shadow:
      0 0.75rem 2rem -0.75rem color-mix(in oklab, black 60%, transparent),
      0 0 0 4px color-mix(in oklab, var(--primary) 18%, transparent);
  }

  .install-fab-mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--primary);
  }

  .install-fab-mark img {
    filter: brightness(0) invert(1);
  }

  .install-fab-pill svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 200ms ease;
  }

  .install-fab-pill:hover svg {
    translate: 0.15rem 0;
  }

  /* The command, revealed above the pill on hover or keyboard focus. */
  .install-fab-pop {
    opacity: 0;
    translate: 0 0.5rem;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      translate 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .install-fab:hover .install-fab-pop,
  .install-fab:focus-within .install-fab-pop {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }

  .install-fab-pop :global(.install-fab-command) {
    width: auto;
    background: var(--card);
    box-shadow: var(--depth-2);
  }

  @media (hover: none) {
    .install-fab-pop {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .install-fab {
      right: 50%;
      justify-items: center;
      translate: 50% 0;
    }

    .install-fab.is-hidden {
      translate: 50% 1.5rem;
    }
  }
</style>
