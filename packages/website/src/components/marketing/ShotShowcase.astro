---
import { Image } from "astro:assets";
import git from "../../assets/shots/d1-conversation.webp";
import pullRequest from "../../assets/shots/d3-pull-request.webp";
import tasks from "../../assets/shots/d4-tasks.webp";
import Reveal from "./Reveal.astro";
import ScreenshotFrame from "./ScreenshotFrame.astro";
const shots = [
  { image:git, eyebrow:"Inspect every action", title:"The transcript is the evidence.", body:"Prompts, reasoning, commands, edits, results, and recovery stay separate and inspectable.", alt:"Nerve conversation with command and edit tool cards", points:["Tool calls retain their inputs and output","Changes remain reviewable before shipping"] },
  { image:pullRequest, eyebrow:"Review before you merge", title:"Pull requests live beside the work.", body:"Open a pull request, read its summary, inspect files, and see check status without leaving the workbench.", alt:"Nerve pull request detail showing an open change ready to merge", points:["Mergeability is visible at a glance","Checks and changed files have dedicated views"] },
  { image:tasks, eyebrow:"Supervised processes", title:"Long-running work keeps a pulse.", body:"Run and revisit development servers, builds, tests, and other tasks with durable output and explicit controls.", alt:"Nerve tasks view with supervised process output", points:["Runs preserve status and output","Start, stop, restart, and inspect from one dock"] },
];
---
<div class="shot-showcase mt-14">
  {shots.map((shot,index)=><article class:list={["shot-row", index%2 && "shot-row-reverse"]}>
    <Reveal variant={index%2?"right":"left"}>
      <ScreenshotFrame parallax={index%2?-12:12}><Image src={shot.image} alt={shot.alt} widths={[720,1080,1600,2000]} sizes="(max-width: 1024px) 100vw, 62vw" loading="lazy" /></ScreenshotFrame>
    </Reveal>
    <Reveal variant={index%2?"left":"right"} delay={100} class="shot-copy">
      <p class="eyebrow">{shot.eyebrow}</p><h3 class="section-title">{shot.title}</h3><p class="body-text">{shot.body}</p>
      <ul>{shot.points.map(point=><li><span aria-hidden="true"></span>{point}</li>)}</ul>
    </Reveal>
  </article>)}
</div>
<style>
  .shot-showcase { display:grid; gap:clamp(5rem,10vw,9rem); }
  .shot-row { display:grid; align-items:center; gap:clamp(2rem,5vw,4rem); }
  .shot-copy { display:grid; gap:1rem; }
  .shot-copy ul { display:grid; gap:0.7rem; margin:0; padding:0; list-style:none; color:var(--muted-foreground); }
  .shot-copy li { display:flex; gap:0.75rem; align-items:center; }
  .shot-copy li span { width:0.5rem;height:0.5rem;border-radius:999px;background:var(--primary);box-shadow:0 0 0 0.25rem color-mix(in oklab,var(--primary) 15%,transparent); }
  @media(min-width:1024px){.shot-row{grid-template-columns:minmax(0,1.45fr) minmax(18rem,.55fr)}.shot-row-reverse{grid-template-columns:minmax(18rem,.55fr) minmax(0,1.45fr)}.shot-row-reverse>:first-child{order:2}}
</style>
