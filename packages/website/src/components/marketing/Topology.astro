---
import Reveal from "./Reveal.astro";

const inside = [
  { title: "You", meta: "Desktop or browser" },
  { title: "Nerve daemon", meta: "127.0.0.1:3747", primary: true },
  { title: "Your project", meta: "~/.nerve and your repositories" },
];
---

<div class="topology">
  <Reveal class="topology-copy" variant="left">
    <p class="body-text">
      Nerve stores application state under <code class="code-chip">~/.nerve</code
      > by default. The daemon connects outward only when your selected model,
      enabled integration, Git remote, or requested tool needs it.
    </p>
    <a class="link-arrow" href="/operations/security/">
      Understand the security boundary
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </Reveal>

  <Reveal variant="right" delay={120} class="topology-diagram">
    <div
      class="boundary"
      role="img"
      aria-label="Your machine contains you, the Nerve daemon on loopback, and your project. A single connection leaves your machine to the model provider and any integrations you enable."
    >
      <span class="membrane-label boundary-label">
        <span class="boundary-dot" aria-hidden="true"></span>your machine
      </span>

      <div class="membrane boundary-inner">
        <ol class="nodes">
          {
            inside.map((node, index) => (
              <li class:list={["node", node.primary && "node-primary"]}>
                {node.primary && (
                  <span class="node-pulse animate-pulse-ring" aria-hidden="true" />
                )}
                <strong>{node.title}</strong>
                <span class="meta-text">{node.meta}</span>
                {index < inside.length - 1 && (
                  <span class="link-inside" aria-hidden="true">
                    <span class="link-impulse" />
                  </span>
                )}
              </li>
            ))
          }
        </ol>

        <p class="boundary-note label-chip">
          opt in to LAN + HTTPS on 3748
        </p>
      </div>

      <div class="egress">
        <span class="egress-line" aria-hidden="true"></span>
        <span class="egress-label label-chip">only when you ask</span>
        <div class="node node-outside">
          <strong>Model provider</strong>
          <span class="meta-text">Plus integrations you enable</span>
        </div>
      </div>
    </div>
  </Reveal>
</div>

<style>
  .topology {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    /* Start-aligned so the body copy stays with the section heading instead of
     * floating to the vertical centre of the taller diagram column. */
    align-items: start;
  }

  @media (min-width: 1024px) {
    .topology {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .topology-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 32rem;
  }

  .boundary {
    position: relative;
    padding-top: 0.75rem;
  }

  .boundary-label {
    position: absolute;
    top: 0;
    left: 1.5rem;
    z-index: 2;
  }

  .boundary-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: var(--radius-pill);
    background-color: var(--membrane);
  }

  .boundary-inner {
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2.5vw, 1.75rem);
  }

  .nodes {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .node {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 1rem 0.9rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background-color: color-mix(in oklab, var(--background) 65%, transparent);
    text-align: center;
    transition:
      border-color 300ms var(--ease-out-expo),
      transform 300ms var(--ease-out-expo);
  }

  .node:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
  }

  .node strong {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .node-primary {
    border-color: color-mix(in oklab, var(--primary) 42%, var(--border));
    background: linear-gradient(
      160deg,
      color-mix(in oklab, var(--primary) 16%, transparent),
      transparent
    );
  }

  .node-pulse {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background-color: var(--success);
    color: var(--success);
  }

  /* Solid, continuously firing links inside the boundary. */
  .link-inside {
    position: absolute;
    left: 50%;
    top: 100%;
    width: 1px;
    height: 2.5rem;
    overflow: hidden;
    background-color: var(--myelin);
  }

  /* Travel is owned by the topology stage so it can be paused off-screen and
   * switched between the stacked and row layouts. */
  .link-impulse {
    position: absolute;
    left: -0.5px;
    width: 2px;
    height: 0.85rem;
    background: linear-gradient(180deg, transparent, var(--signal), transparent);
  }

  .boundary-note {
    justify-content: center;
    margin: 1.5rem 0 0;
    color: color-mix(in oklab, var(--membrane) 80%, var(--foreground));
    text-align: center;
  }

  /* Egress: one connection, rendered as the exception it is. */
  .egress {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .egress-line {
    position: relative;
    width: 1px;
    height: 2rem;
    background-image: repeating-linear-gradient(
      180deg,
      color-mix(in oklab, var(--warning) 65%, transparent) 0 4px,
      transparent 4px 9px
    );
  }

  /* The impulse that leaves the machine, and fades before it arrives. */
  .egress-spark {
    position: absolute;
    top: 0;
    left: -1.5px;
    width: 4px;
    height: 4px;
    border-radius: var(--radius-pill);
    background-color: var(--warning);
    box-shadow: 0 0 0.5rem color-mix(in oklab, var(--warning) 70%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  .egress-label {
    color: var(--warning);
  }

  .node-outside {
    width: min(18rem, 100%);
    border-style: dashed;
    background-color: transparent;
  }

  @media (min-width: 640px) {
    .nodes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3.5rem;
    }

    .link-inside {
      left: 100%;
      top: 50%;
      width: 3.5rem;
      height: 1px;
      transform: translateY(-50%);
    }

    .link-impulse {
      left: auto;
      top: -0.5px;
      width: 0.85rem;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--signal), transparent);
    }
  }
</style>
