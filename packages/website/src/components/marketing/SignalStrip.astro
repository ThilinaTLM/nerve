---
/* Five verifiable facts strung along one myelinated axon, as nodes of Ranvier.
 * A single impulse sweeps the axon on a loop and each node flashes as it
 * passes. `stage/sections.ts` reads the node state from the sweep's own
 * position, so the two can never drift apart; with no script the strip is a
 * static, complete list of facts. */

const facts = [
  { value: "Apache-2.0", label: "Free & open source" },
  { value: "Linux · macOS · Windows 11", label: "Cross-platform" },
  { value: "127.0.0.1:3747", label: "Local daemon by default" },
  { value: "API key · subscription", label: "Bring your own provider" },
  { value: "~/.nerve", label: "Your state, your disk" },
];
---

<div class="signal-strip tone-sunken">
  <div class="container-page strip-inner">
    <div class="strip-axon" aria-hidden="true">
      <span class="strip-sweep"></span>
    </div>

    <ul class="strip-list">
      {
        facts.map((fact, index) => (
          <li class="strip-item" style={`--node-index:${index}`}>
            <span class="synapse-node" aria-hidden="true" />
            <span class="strip-value">{fact.value}</span>
            <span class="strip-label">{fact.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .signal-strip {
    padding-block: 2.5rem;
  }

  .strip-inner {
    position: relative;
  }

  .strip-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Small screens: a quiet ledger. Each fact is one left-aligned row — node,
   * value, label — separated by hairlines, instead of five centered columns
   * fighting for half a phone width each. */
  .strip-item {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.8rem;
    row-gap: 0.2rem;
    align-items: center;
    justify-items: start;
    padding-block: 0.85rem;
    border-top: 1px solid var(--hairline);
    text-align: left;
  }

  .strip-item:first-child {
    border-top: 0;
  }

  .strip-item :global(.synapse-node) {
    grid-row: 1 / span 2;
  }

  .strip-value {
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .strip-label {
    color: var(--muted-foreground);
    font-size: var(--text-meta);
  }

  /* The axon is only drawn once the nodes sit on a single row. */
  .strip-axon {
    display: none;
  }

  @media (min-width: 900px) {
    .strip-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0 1rem;
    }

    .strip-item {
      grid-template-columns: none;
      justify-items: center;
      row-gap: 0.5rem;
      padding-block: 0;
      border-top: 0;
      text-align: center;
    }

    .strip-item :global(.synapse-node) {
      grid-row: auto;
    }

    .strip-axon {
      display: block;
      position: absolute;
      top: 0.35rem;
      left: 0;
      right: 0;
      height: 1px;
      overflow: hidden;
      background-image: repeating-linear-gradient(
        90deg,
        var(--myelin) 0 2.5rem,
        transparent 2.5rem 2.875rem
      );
      /* Fades into the page rather than stopping at a hard edge. */
      mask-image: linear-gradient(
        90deg,
        transparent,
        black 8%,
        black 92%,
        transparent
      );
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent,
        black 8%,
        black 92%,
        transparent
      );
    }

    .strip-sweep {
      position: absolute;
      top: 0;
      left: 0;
      width: 6rem;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        var(--signal),
        transparent
      );
      opacity: 0;
    }
  }
</style>
