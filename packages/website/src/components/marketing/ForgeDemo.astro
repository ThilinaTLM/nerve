---
/* The Forge demo: building an extension by asking, start to finish.
 *
 * Left, a Forge conversation: the request, then the tool calls that create,
 * write, build and reload the extension. Across the middle, the files it
 * writes travel into the workbench on the right. There the new extension
 * waits as Pending consent, listing what it asks for, until the user (the
 * pointer) chooses Allow; then it appears live, as a dock panel or a page
 * tab. `forge-demo.ts` cycles through requests from the marquee below.
 *
 * The markup shows the first build allowed and live, so the art reads the
 * same without script or motion.
 */
import BrandIcon from "./BrandIcon.astro";
import { profileIcons } from "./hero-profiles";
import {
  forgeDemoBuilds,
  forgeDemoSteps,
} from "../../scripts/marketing/forge-demo-builds";

const first = forgeDemoBuilds[0]!;
const steps = forgeDemoSteps(first);
---

<figure
  class="fd"
  data-forge-demo
  data-stage="live"
  data-kind={first.kind}
  aria-label="An illustration of building an extension by asking Forge: the request, the tool calls that create, build and reload it, a consent prompt listing what it asks for that you allow, and the new panel or tab appearing in the workbench."
>
  <div class="fd-chat" aria-hidden="true">
    <span class="fd-chip">
      <svg viewBox="0 0 24 24"><path d={profileIcons.forge} /></svg>
      Forge
    </span>
    <div class="fd-bubble"><span data-fd-ask>{first.ask}</span><span class="fd-caret"></span></div>
    <div class="fd-steps" data-fd-steps>
      {
        steps.map((step) => (
          <div class="fd-step is-done">
            <span class="fd-status" />
            <code>{step.tool}</code>
            <span class="fd-detail">{step.detail}</span>
          </div>
        ))
      }
    </div>
    <p class="fd-reply">Built and reloaded. It is waiting for your review.</p>
  </div>

  <div class="fd-flow" aria-hidden="true">
    <span class="fd-wire"></span>
    <span class="fd-file" data-fd-file>{first.source.split("/").pop()}</span>
  </div>

  <div class="fd-bench" aria-hidden="true">
    <div class="fd-bar">
      <span class="fd-dots"><i></i><i></i><i></i></span>
      <span class="fd-tab">aurora</span>
      <span class="fd-tab fd-newtab">
        <span class="fd-brand" data-fd-tab-brand></span>
        <span data-fd-tab-name>{first.name}</span>
      </span>
    </div>
    <div class="fd-body">
      <div class="fd-side">
        <span style="width:80%"></span><span style="width:60%"></span><span style="width:70%"></span>
        <span style="width:50%"></span>
      </div>
      <div class="fd-main">
        <div class="fd-chatlines">
          <span style="width:70%"></span><span style="width:90%"></span><span style="width:55%"></span>
          <span style="width:80%"></span>
        </div>
        <div class="fd-result fd-page" data-fd-result="page"></div>
      </div>
      <div class="fd-dock">
        <div class="fd-slot"></div>
        <div class="fd-result fd-panel" data-fd-result="panel">
          <span class="fd-result-title">
            <span class="fd-brand"></span>
            <span>{first.name}</span>
          </span>
          {
            first.rows.map((row) => (
              <span class="fd-row">
                <span class={`fd-dot is-${row.tone}`} />
                <span class="fd-row-label">{row.label}</span>
                <span class={`fd-row-meta is-${row.tone}`}>{row.meta}</span>
              </span>
            ))
          }
          <span class="fd-tag">Built by Forge</span>
        </div>
      </div>
    </div>

    <div class="fd-consent" data-fd-consent>
      <span class="fd-consent-head">
        <span class="fd-brand" data-fd-consent-brand></span>
        <b data-fd-consent-name>{first.name}</b>
        <span class="fd-pending">Pending consent</span>
      </span>
      <span class="fd-consent-label">It asks for</span>
      <ul data-fd-asks>
        {first.asks.map((ask) => <li>{ask}</li>)}
      </ul>
      <span class="fd-consent-actions">
        <span class="fd-btn">Not now</span>
        <span class="fd-btn is-allow">
          Allow
          <svg class="fd-cursor" viewBox="0 0 24 24">
            <path d="M5 3l14 8-6 1.5L10 19z" />
          </svg>
        </span>
      </span>
    </div>
  </div>

  {/* Brand marks the script swaps into the tab, panel and consent card. */}
  <template data-fd-brands>
    {
      forgeDemoBuilds.map((build) =>
        build.brand ? (
          <span data-brand={build.id}>
            <BrandIcon name={build.brand} size={13} />
          </span>
        ) : null,
      )
    }
  </template>
</figure>

<script>
  import "../../scripts/marketing/forge-demo";
</script>

<style>
  .fd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(3rem, 7vw, 6rem) minmax(0, 1.25fr);
    align-items: center;
    width: min(100%, 64rem);
    margin: 0 auto;
    text-align: left;
  }

  /* Conversation ------------------------------------------------------------ */

  .fd-chat {
    display: grid;
    gap: 0.6rem;
    padding: 1rem;
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background: var(--card);
    box-shadow: var(--depth-2);
  }

  .fd-chip {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid color-mix(in oklab, var(--signal) 55%, transparent);
    border-radius: var(--radius-pill);
    color: var(--signal);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .fd-chip svg,
  .fd-cursor {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fd-bubble {
    justify-self: end;
    max-width: 92%;
    min-height: 1.4em;
    padding: 0.5rem 0.8rem;
    border-radius: 0.8rem;
    background: color-mix(in oklab, var(--foreground) 9%, transparent);
    color: var(--foreground);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .fd-caret {
    display: none;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--primary);
    animation: caret-blink 1.1s steps(1) infinite;
  }

  .fd[data-stage="typing"] .fd-caret {
    display: inline-block;
  }

  .fd-steps {
    display: grid;
    gap: 0.35rem;
    min-height: 8.6rem;
    align-content: start;
  }

  .fd-steps :global(.fd-step) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--hairline);
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    white-space: nowrap;
    transition:
      opacity 260ms ease,
      translate 260ms ease;
  }

  .fd-steps :global(.fd-step.is-entering) {
    opacity: 0;
    translate: 0 0.4rem;
  }

  .fd-steps :global(code) {
    color: var(--foreground);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .fd-steps :global(.fd-detail) {
    overflow: hidden;
    font-family: var(--font-mono);
    text-overflow: ellipsis;
  }

  .fd-steps :global(.fd-status) {
    position: relative;
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
  }

  .fd-steps :global(.is-running > .fd-status) {
    border: 2px solid color-mix(in oklab, var(--foreground) 18%, transparent);
    border-top-color: var(--primary);
    animation: wb-spin 0.8s linear infinite;
  }

  .fd-steps :global(.is-done > .fd-status) {
    background: color-mix(in oklab, var(--success) 25%, transparent);
  }

  .fd-steps :global(.is-done > .fd-status::after) {
    content: "";
    position: absolute;
    top: 20%;
    left: 35%;
    width: 25%;
    height: 45%;
    border: solid var(--success);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .fd-reply {
    margin: 0;
    color: var(--foreground);
    font-size: 0.85rem;
    transition: opacity 300ms ease;
  }

  .fd:is([data-stage="typing"], [data-stage="building"]) .fd-reply {
    opacity: 0;
  }

  /* Flow: the file being written travels into the workbench. -------------- */

  .fd-flow {
    position: relative;
    height: 2rem;
  }

  .fd-wire {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    border-top: 1.5px dashed color-mix(in oklab, var(--signal) 50%, transparent);
  }

  .fd-file {
    position: absolute;
    top: 50%;
    left: 0;
    padding: 0.15rem 0.45rem;
    border: 1px solid color-mix(in oklab, var(--signal) 60%, transparent);
    border-radius: 0.4rem;
    background: var(--card);
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    white-space: nowrap;
    opacity: 0;
    translate: -10% -50%;
  }

  .fd-file.is-flying {
    left: 100%;
    opacity: 1;
    translate: -90% -50%;
    transition:
      left 700ms cubic-bezier(0.5, 0, 0.3, 1),
      translate 700ms cubic-bezier(0.5, 0, 0.3, 1),
      opacity 200ms ease;
  }

  /* Workbench --------------------------------------------------------------- */

  .fd-bench {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 19rem;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--card) 85%, var(--background));
    box-shadow: var(--depth-2);
  }

  .fd-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--hairline);
    color: var(--muted-foreground);
    font-size: 0.72rem;
  }

  .fd-dots {
    display: flex;
    gap: 0.3rem;
  }

  .fd-dots i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--foreground) 18%, transparent);
  }

  .fd-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.55rem;
    border-radius: 0.4rem;
  }

  /* A page tab appears only for a live page extension. */
  .fd-newtab {
    display: none;
    border: 1px solid color-mix(in oklab, var(--signal) 55%, transparent);
    background: color-mix(in oklab, var(--signal) 12%, transparent);
    color: var(--foreground);
  }

  .fd[data-stage="live"][data-kind="page"] .fd-newtab {
    display: inline-flex;
  }

  .fd-body {
    display: grid;
    grid-template-columns: 0.55fr 1.3fr 1fr;
    gap: 0.6rem;
    padding: 0.6rem;
  }

  .fd-side,
  .fd-chatlines {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 0.5rem;
    border: 1px solid var(--hairline);
    border-radius: 0.6rem;
  }

  .fd-side span,
  .fd-chatlines span {
    height: 0.45rem;
    border-radius: 1rem;
    background: color-mix(in oklab, var(--foreground) 12%, transparent);
  }

  .fd-main,
  .fd-dock {
    position: relative;
    display: grid;
  }

  .fd-main > *,
  .fd-dock > * {
    grid-area: 1 / 1;
  }

  .fd-slot {
    border: 1.5px dashed color-mix(in oklab, var(--foreground) 16%, transparent);
    border-radius: 0.6rem;
  }

  /* The extension's view: hidden until allowed, then in the dock (panel) or
   * the main area (page). */
  .fd-result {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 0.65rem;
    border: 1px solid color-mix(in oklab, var(--signal) 60%, transparent);
    border-radius: 0.6rem;
    background: var(--card);
    box-shadow: 0 0 1.5rem color-mix(in oklab, var(--signal) 22%, transparent);
    opacity: 0;
    scale: 0.94;
    transition:
      opacity 400ms ease,
      scale 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .fd[data-stage="live"][data-kind="panel"] .fd-panel,
  .fd[data-stage="live"][data-kind="page"] .fd-page {
    opacity: 1;
    scale: 1;
  }

  /* A live page takes the whole main area, as a tab does. */
  .fd[data-stage="live"][data-kind="page"] .fd-main {
    grid-column: 2 / -1;
  }

  .fd[data-stage="live"][data-kind="page"] .fd-dock {
    display: none;
  }

  .fd-result :global(.fd-result-title) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--foreground);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .fd-result :global(.fd-row) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--foreground);
    font-size: 0.72rem;
  }

  .fd-result :global(.fd-row-label) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fd-result :global(.fd-row-meta) {
    flex: none;
    margin-left: auto;
    padding: 0.05rem 0.4rem;
    border-radius: 0.3rem;
    background: color-mix(in oklab, currentcolor 14%, transparent);
    font-size: 0.65rem;
    font-weight: 600;
  }

  .fd-result :global(.fd-dot) {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentcolor;
  }

  .fd-result :global(.is-success) {
    color: var(--success);
  }

  .fd-result :global(.is-warning) {
    color: var(--warning);
  }

  .fd-result :global(.is-danger) {
    color: var(--destructive);
  }

  .fd-result :global(.is-muted) {
    color: var(--muted-foreground);
  }

  .fd-result :global(.fd-tag) {
    justify-self: start;
    margin-top: 0.2rem;
    padding: 0.1rem 0.45rem;
    border-radius: 1rem;
    background: color-mix(in oklab, var(--signal) 16%, transparent);
    color: var(--signal);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .fd :global(.fd-brand) {
    display: inline-grid;
  }

  .fd :global(.fd-brand:empty) {
    display: none;
  }

  /* Consent ----------------------------------------------------------------- */

  .fd-consent {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    gap: 0.5rem;
    width: min(18rem, 86%);
    padding: 0.9rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: 0.9rem;
    background: var(--card);
    box-shadow:
      0 1.5rem 3rem -1rem color-mix(in oklab, black 55%, transparent),
      0 0 0 100vmax color-mix(in oklab, var(--background) 45%, transparent);
    color: var(--foreground);
    font-size: 0.78rem;
    opacity: 0;
    translate: -50% -46%;
    pointer-events: none;
    transition:
      opacity 300ms ease,
      translate 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .fd[data-stage="consent"] .fd-consent {
    opacity: 1;
    translate: -50% -50%;
  }

  .fd-consent-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .fd-pending {
    margin-left: auto;
    padding: 0.1rem 0.45rem;
    border-radius: 1rem;
    background: color-mix(in oklab, var(--warning) 16%, transparent);
    color: var(--warning);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .fd-consent-label {
    color: var(--muted-foreground);
    font-size: 0.7rem;
  }

  .fd-consent ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding-left: 1rem;
  }

  .fd-consent-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.4rem;
    margin-top: 0.2rem;
  }

  .fd-btn {
    position: relative;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--hairline);
    border-radius: 0.45rem;
    font-weight: 600;
    transition: scale 150ms ease;
  }

  .fd-btn.is-allow {
    border-color: transparent;
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .fd.is-pressing .fd-btn.is-allow {
    scale: 0.92;
  }

  /* The user's pointer: it travels to Allow and presses it. */
  .fd-cursor {
    position: absolute;
    top: 55%;
    left: 60%;
    width: 1.1rem;
    height: 1.1rem;
    fill: var(--foreground);
    stroke: var(--background);
    stroke-width: 1.5;
    opacity: 0;
    translate: 2.5rem 2rem;
    transition:
      translate 700ms cubic-bezier(0.3, 0, 0.2, 1),
      opacity 200ms ease;
  }

  .fd.is-pointing .fd-cursor {
    opacity: 1;
    translate: 0 0;
  }

  /* Narrow screens: conversation over workbench, the file falling between. */
  @media (max-width: 47.99rem) {
    .fd {
      grid-template-columns: minmax(0, 1fr);
    }

    .fd-flow {
      height: 3rem;
    }

    .fd-wire {
      top: 0;
      bottom: 0;
      left: 50%;
      right: auto;
      border-top: 0;
      border-left: 1.5px dashed color-mix(in oklab, var(--signal) 50%, transparent);
    }

    .fd-file {
      top: 0;
      left: 50%;
      translate: -50% 0;
    }

    .fd-file.is-flying {
      top: 100%;
      left: 50%;
      translate: -50% -100%;
      transition:
        top 700ms cubic-bezier(0.5, 0, 0.3, 1),
        translate 700ms cubic-bezier(0.5, 0, 0.3, 1),
        opacity 200ms ease;
    }

    .fd-body {
      grid-template-columns: 0.4fr 1.1fr 1fr;
    }
  }
</style>
