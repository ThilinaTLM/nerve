---
/* The Forge demo: one conversation that fits Nerve to a project.
 *
 * Left, a Forge conversation: the setup request from `forge-setup.ts`, then
 * the tool calls that write each item and check and reload the project.
 * Right, the workbench drawn in the hero's style. As each item is made, a
 * chip naming it flies to where it shows up: the launch in Launches, the
 * prompt suggestion above the composer, and the skill, MCP server and
 * extension in an "Added to aurora" card, waiting for review. The bell then
 * counts them under "Waiting for your review"; the user (the pointer)
 * reviews each one and allows the extension on its Pending consent card,
 * and the Sentry errors panel goes live in the dock.
 *
 * A quiet link to the guide sits under it.
 *
 * `forge-demo.ts` plays it. The markup shows the finished setup, every item
 * live, so the art reads the same without script or motion.
 */
import BrandIcon from "./BrandIcon.astro";
import { profileIcons } from "./hero-profiles";
import {
  type ForgeSetupItem,
  forgeSetupAsk,
  forgeSetupChecks,
  forgeSetupConsent,
  forgeSetupItems,
  forgeSetupProject,
  forgeSetupReviewCount,
} from "../../scripts/marketing/forge-setup";

const byKind = (kind: ForgeSetupItem["kind"]) =>
  forgeSetupItems.find((item) => item.kind === kind)!;
const launch = byKind("launch");
const suggestion = byKind("suggestion");
const extension = byKind("extension");
const [launchLabel, launchCommand] = launch.name.split(" · ");
const reviewed = forgeSetupItems.filter((item) => item.review);
const steps = [
  ...forgeSetupItems.flatMap((item) => item.steps),
  ...forgeSetupChecks,
];
const reply = `Set up ${forgeSetupItems.length} things. ${forgeSetupReviewCount} wait for your review.`;

/* The state badges the app shows: a skill or MCP entry Needs review until
 * trusted; an extension is Pending consent until allowed. */
const waiting = (item: ForgeSetupItem) =>
  item.kind === "extension" ? "Pending consent" : "Needs review";
const live = (item: ForgeSetupItem) =>
  item.kind === "extension" ? "Allowed" : "Trusted";

const errors = [
  { label: "TypeError in booking.ts", meta: "42 events", tone: "danger" },
  { label: "Timeout on /venues", meta: "9 events", tone: "warning" },
];

const glyph = {
  chats:
    "M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2zM18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1",
  files: "M4 4h5l2 2h7v4H4zM4 14h5l2 2h7v4H4zM2 4v16",
  search: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-4.3-4.3",
  terminal: "m4 17 6-6-6-6M12 19h8",
  bell: "M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0",
  gear: "M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1",
  branch:
    "M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 9a9 9 0 0 1-9 9",
  pr: "M6 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM18 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM6 9v12M13 6h3a2 2 0 0 1 2 2v7",
  play: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM10 8.5v7l6-3.5z",
};
---

<div class="fd-wrap">
<figure
  class="fd"
  data-forge-demo
  data-stage="live"
  data-overlay="none"
  aria-label={`An illustration of setting Nerve up for a project in one Forge conversation. You ask: “${forgeSetupAsk}” Forge writes a skill, an MCP server entry for Linear, a Sentry errors extension, a dev server launch and a prompt suggestion, then checks and reloads the project. The launch and the suggestion work at once; the skill, the MCP server and the extension wait in the notification bell under Waiting for your review until you trust them and allow the extension, which then shows Sentry errors in a dock panel.`}
>
  <div class="fd-chat" aria-hidden="true">
    <div class="fd-chat-head">
      <span class="fd-chip">
        <svg class="fd-glyph" viewBox="0 0 24 24"><path d={profileIcons.forge} /></svg>
        Forge
      </span>
      <span class="fd-chat-title">Set up {forgeSetupProject}</span>
    </div>
    <div class="fd-bubble">
      <span class="fd-ask-ghost">{forgeSetupAsk}</span>
      <span class="fd-ask"><span data-fd-ask>{forgeSetupAsk}</span><span class="fd-caret"></span></span>
    </div>
    <div class="fd-steps" data-fd-steps>
      {
        steps.map((step) => (
          <div class="fd-step is-done">
            <span class="fd-status" />
            <code>{step.tool}</code>
            <span class="fd-detail">{step.detail}</span>
          </div>
        ))
      }
    </div>
    <p class="fd-reply">{reply}</p>
  </div>

  <div class="fd-stage">
  <div class="fd-bench" data-fd-bench aria-hidden="true">
    <div class="fd-titlebar">
      <img class="fd-logo" src="/favicon.svg" alt="" width="16" height="16" />
      <span class="fd-tab is-active">{forgeSetupProject}</span>
      <span class="fd-tab">northstar</span>
      <span class="fd-titlebar-end">
        <span class="fd-bell" data-fd-bell>
          <svg class="fd-glyph" viewBox="0 0 24 24"><path d={glyph.bell} /></svg>
          <span class="fd-badge" data-fd-badge>{forgeSetupReviewCount}</span>
        </span>
        <svg class="fd-glyph" viewBox="0 0 24 24"><path d={glyph.gear} /></svg>
      </span>
    </div>

    <div class="fd-body">
      <div class="fd-panel fd-side">
        <div class="fd-icon-tabs">
          <svg class="fd-glyph" viewBox="0 0 24 24"><path d={glyph.chats} /></svg>
          <svg class="fd-glyph" viewBox="0 0 24 24"><path d={glyph.files} /></svg>
          <svg class="fd-glyph" viewBox="0 0 24 24"><path d={glyph.search} /></svg>
          <svg class="fd-glyph is-current" viewBox="0 0 24 24"><path d={glyph.terminal} /></svg>
        </div>
        <span class="fd-title">Launches</span>
        <div class="fd-launch is-off">
          <svg class="fd-glyph" viewBox="0 0 24 24"><path d={glyph.play} /></svg>
          <span class="fd-launch-name">tests · watch</span>
          <span class="fd-launch-state"></span>
        </div>
        <div class="fd-launch fd-land" data-fd-target={launch.id} data-state="live">
          <svg class="fd-glyph" viewBox="0 0 24 24"><path d={glyph.play} /></svg>
          <span class="fd-launch-name">{launchLabel}<small>{launchCommand}</small></span>
          <span class="fd-launch-state"></span>
        </div>
      </div>

      <div class="fd-panel fd-main">
        <div class="fd-chat-tab">
          <span class="fd-dot is-primary"></span>
          <span>New conversation</span>
        </div>
        <div class="fd-lines">
          <span style="width:62%"></span><span style="width:84%"></span><span style="width:48%"></span>
        </div>
        <span class="fd-suggest fd-land" data-fd-target={suggestion.id} data-state="live">
          {suggestion.name}
        </span>
        <div class="fd-composer">
          <span class="fd-placeholder">Ask the local Nerve agent</span>
          <span class="fd-composer-bar">
            <span class="fd-profile">
              <svg class="fd-glyph" viewBox="0 0 24 24"><path d={profileIcons.coding} /></svg>
              Coding
            </span>
            <span class="fd-send"></span>
          </span>
        </div>
      </div>

      <div class="fd-panel fd-dock" data-fd-panel data-state="live">
        <div class="fd-icon-tabs">
          <svg class="fd-glyph" viewBox="0 0 24 24"><path d={glyph.branch} /></svg>
          <svg class="fd-glyph" viewBox="0 0 24 24"><path d={glyph.pr} /></svg>
          <span class="fd-dock-tab">{extension.brand && <BrandIcon name={extension.brand} size={13} />}</span>
        </div>
        <div class="fd-dock-body">
          <div class="fd-slot"></div>
          <div class="fd-errors">
            <span class="fd-title">{extension.name}</span>
            {
              errors.map((row) => (
                <span class="fd-error">
                  <span class={`fd-dot is-${row.tone}`} />
                  <span class="fd-error-label">{row.label}</span>
                  <span class={`fd-meta is-${row.tone}`}>{row.meta}</span>
                </span>
              ))
            }
            <span class="fd-tag">Built by Forge</span>
          </div>
        </div>
      </div>
    </div>

    <div class="fd-statusbar">
      <span class="fd-mono">~/{forgeSetupProject}</span>
      <span class="fd-status-end"><span class="fd-dot is-success"></span>Connected</span>
    </div>

    <!-- What waits for review, in the bell's own group. -->
    <div class="fd-notifs" data-fd-notifs>
      <span class="fd-group">
        Waiting for your review <b data-fd-count>{forgeSetupReviewCount}</b>
      </span>
      {
        reviewed.map((item) => (
          <div class="fd-notif" data-fd-review={item.id}>
            <span class="fd-notif-text">
              <b>{item.name}</b>
              <span>{item.kindLabel} · {forgeSetupProject}</span>
            </span>
            <span class="fd-btn" data-fd-review-button>Review</span>
            <span class="fd-check" />
          </div>
        ))
      }
    </div>

    <div class="fd-consent" data-fd-consent>
      <span class="fd-consent-head">
        {extension.brand && <BrandIcon name={extension.brand} size={13} />}
        <b>{extension.name}</b>
        <span class="fd-pill is-warning">Pending consent</span>
      </span>
      <span class="fd-consent-label">It asks for</span>
      <ul>
        {forgeSetupConsent.map((ask) => <li>{ask}</li>)}
      </ul>
      <span class="fd-consent-actions">
        <span class="fd-btn">Not now</span>
        <span class="fd-btn is-allow" data-fd-allow>Allow</span>
      </span>
    </div>

    <svg class="fd-cursor" data-fd-cursor viewBox="0 0 24 24">
      <path d="M5 3l14 8-6 1.5L10 19z" />
    </svg>
  </div>

  <!-- Hangs off the window: the items that wait for the user. -->
  <div class="fd-added" aria-hidden="true">
    <span class="fd-heading">Added to {forgeSetupProject}</span>
    {
      reviewed.map((item) => (
        <div class="fd-added-row fd-land" data-fd-target={item.id} data-state="live">
          <span class="fd-kind">{item.kindLabel}</span>
          {item.brand && <BrandIcon name={item.brand} size={12} />}
          <span class="fd-added-name">{item.name}</span>
          <span class="fd-pill is-warning fd-when-waiting">{waiting(item)}</span>
          <span class="fd-pill is-success fd-when-live">{live(item)}</span>
        </div>
      ))
    }
  </div>
  </div>

  {/* Brand marks the script copies into the flying chips. */}
  <template data-fd-brands>
    {
      forgeSetupItems.map((item) =>
        item.brand ? (
          <span data-brand={item.id}>
            <BrandIcon name={item.brand} size={12} />
          </span>
        ) : null,
      )
    }
  </template>
</figure>

<a class="link-arrow fd-link" href="/guides/configure-by-chat/">
  How Forge works <span aria-hidden="true">→</span>
</a>
</div>

<script>
  import "../../scripts/marketing/forge-demo";
</script>

<style>
  .fd-wrap {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .fd-link {
    font-size: 0.95rem;
  }

  .fd {
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
    width: min(100%, 68rem);
    margin: 0 auto;
    padding-bottom: 3rem;
    text-align: left;
  }

  /* Shared pieces ----------------------------------------------------------- */

  .fd-glyph {
    flex: none;
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fd-title {
    color: var(--foreground);
    font-weight: 700;
  }

  .fd-mono {
    font-family: var(--font-mono);
  }

  .fd :global(.fd-dot) {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--foreground) 25%, transparent);
  }

  .fd :global(.fd-dot.is-primary) {
    background: var(--primary);
  }

  .fd :global(.fd-dot.is-success) {
    background: var(--success);
  }

  .fd :global(.fd-dot.is-warning) {
    background: var(--warning);
  }

  .fd :global(.fd-dot.is-danger) {
    background: var(--destructive);
  }

  .fd-pill,
  .fd-meta {
    flex: none;
    padding: 0.05rem 0.4rem;
    border-radius: 0.3rem;
    background: color-mix(in oklab, currentcolor 14%, transparent);
    font-size: 0.62rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .is-warning {
    color: var(--warning);
  }

  .is-success {
    color: var(--success);
  }

  .is-danger {
    color: var(--destructive);
  }

  /* A check in a soft green disc, drawn with borders. */
  .fd-check,
  .fd-steps :global(.is-done > .fd-status) {
    position: relative;
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--success) 25%, transparent);
  }

  .fd-check::after,
  .fd-steps :global(.is-done > .fd-status::after) {
    content: "";
    position: absolute;
    top: 20%;
    left: 35%;
    width: 25%;
    height: 45%;
    border: solid var(--success);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .fd-btn {
    flex: none;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--hairline);
    border-radius: 0.4rem;
    color: var(--foreground);
    font-size: 0.7rem;
    font-weight: 600;
    transition: scale 150ms ease;
  }

  .fd-btn.is-allow {
    border-color: transparent;
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .fd :global(.is-pressed) {
    scale: 0.9;
  }

  /* Conversation ------------------------------------------------------------ */

  .fd-chat {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background: var(--card);
    box-shadow: var(--depth-2);
  }

  .fd-chat-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--hairline);
  }

  .fd-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid color-mix(in oklab, var(--signal) 55%, transparent);
    border-radius: var(--radius-pill);
    color: var(--signal);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .fd-chat-title {
    color: var(--muted-foreground);
    font-size: 0.78rem;
  }

  /* The ask types over an invisible copy of itself, so the bubble keeps its
   * final height from the first letter. */
  .fd-bubble {
    display: grid;
    justify-self: end;
    max-width: 94%;
    padding: 0.55rem 0.8rem;
    border-radius: 0.8rem;
    background: color-mix(in oklab, var(--foreground) 9%, transparent);
    color: var(--foreground);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .fd-bubble > * {
    grid-area: 1 / 1;
  }

  .fd-ask-ghost {
    visibility: hidden;
  }

  .fd-caret {
    display: none;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--primary);
    animation: caret-blink 1.1s steps(1) infinite;
  }

  .fd[data-stage="typing"] .fd-caret {
    display: inline-block;
  }

  /* Tool calls collect at the bottom; older ones fade out of the top. */
  .fd-steps {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    height: 15.5rem;
    overflow: hidden;
    mask-image: linear-gradient(transparent, black 3rem);
    -webkit-mask-image: linear-gradient(transparent, black 3rem);
  }

  .fd-steps :global(.fd-step) {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0.55rem;
    border: 1px solid var(--hairline);
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.72rem;
    white-space: nowrap;
    transition:
      opacity 260ms ease,
      translate 260ms var(--ease);
  }

  .fd-steps :global(.fd-step.is-entering) {
    opacity: 0;
    translate: 0 0.4rem;
  }

  .fd-steps :global(code) {
    color: var(--foreground);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .fd-steps :global(.fd-detail) {
    overflow: hidden;
    font-family: var(--font-mono);
    text-overflow: ellipsis;
  }

  .fd-steps :global(.fd-status) {
    position: relative;
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
  }

  .fd-steps :global(.is-running > .fd-status) {
    border: 2px solid color-mix(in oklab, var(--foreground) 18%, transparent);
    border-top-color: var(--primary);
    animation: wb-spin 0.8s linear infinite;
  }

  .fd-reply {
    margin: 0;
    color: var(--foreground);
    font-size: 0.86rem;
    font-weight: 600;
    transition: opacity 300ms ease;
  }

  .fd:is([data-stage="typing"], [data-stage="building"]) .fd-reply {
    opacity: 0;
  }

  /* A chip naming an item, flying from its tool call to where it lands. */
  .fd :global(.fd-fly) {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid color-mix(in oklab, var(--signal) 60%, transparent);
    border-radius: var(--radius-pill);
    background: var(--card);
    box-shadow: 0 0.6rem 1.4rem -0.4rem color-mix(in oklab, var(--signal) 45%, transparent);
    color: var(--foreground);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 700ms cubic-bezier(0.5, 0, 0.25, 1),
      opacity 220ms ease;
  }

  .fd :global(.fd-fly .fd-kind) {
    color: var(--signal);
  }

  .fd :global(.fd-fly > span:not(.fd-kind)) {
    display: inline-grid;
  }

  /* Workbench --------------------------------------------------------------- */

  .fd-bench {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--card) 92%, var(--background));
    box-shadow:
      0 2rem 4rem -1.5rem color-mix(in oklab, black 45%, transparent),
      0 0 0 1px color-mix(in oklab, var(--primary) 8%, transparent);
    color: var(--muted-foreground);
    font-size: 0.72rem;
  }

  .fd-titlebar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem 0.8rem;
    border-bottom: 1px solid var(--hairline);
  }

  .fd-logo {
    width: 1rem;
    height: 1rem;
  }

  .fd-tab.is-active {
    padding: 0.1rem 0.5rem;
    border-radius: 0.4rem;
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    color: var(--foreground);
  }

  .fd-titlebar-end {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-left: auto;
  }

  .fd-bell {
    position: relative;
    display: grid;
    color: var(--foreground);
  }

  .fd-badge {
    position: absolute;
    top: -0.45rem;
    right: -0.55rem;
    display: grid;
    place-items: center;
    min-width: 0.85rem;
    height: 0.85rem;
    padding-inline: 0.2rem;
    border-radius: 1rem;
    background: var(--warning);
    color: var(--background);
    font-size: 0.55rem;
    font-weight: 700;
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 250ms ease,
      scale 350ms var(--ease);
  }

  .fd[data-stage="review"] .fd-badge {
    opacity: 1;
    scale: 1;
  }

  .fd-body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr) minmax(0, 1.1fr);
    gap: 0.5rem;
    padding: 0.5rem;
    min-height: 20rem;
  }

  .fd-panel {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
    padding: 0.6rem;
    border: 1px solid var(--hairline);
    border-radius: 0.6rem;
    background: var(--card);
  }

  .fd-icon-tabs {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--hairline);
  }

  .fd-icon-tabs .is-current {
    color: var(--foreground);
  }

  /* Items that land: hidden until made, waiting until reviewed, then live. */
  .fd-land {
    transition:
      opacity 400ms ease,
      scale 450ms var(--ease),
      border-color 400ms ease;
  }

  .fd-land[data-state="hidden"] {
    opacity: 0;
    scale: 0.92;
  }

  .fd-launch {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.45rem;
    border: 1px solid var(--hairline);
    border-radius: 0.45rem;
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .fd-launch .fd-glyph {
    color: var(--success);
  }

  .fd-launch-name {
    display: grid;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .fd-launch-name small {
    color: var(--muted-foreground);
    font-size: 0.6rem;
  }

  .fd-launch-state {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    margin-left: auto;
    border-radius: 50%;
    background: var(--success);
  }

  .fd-launch.is-off {
    color: var(--muted-foreground);
  }

