---
/* The simulated live-run panel.
 *
 * One markup contract shared by the hero and the hot-swap lab, styled after
 * the real workbench transcript: bare tool-call headers with a status icon and
 * mono arguments, an inset output box, a line-count footer, italic thinking,
 * plain prose replies, and the composer: editor text above a single toolbar.
 *
 * The rows passed in are the complete static transcript: what no-JS and
 * reduced-motion visitors read, and what `scripts/run-sim.ts` replaces when it
 * takes over. Row shapes mirror `SimRow` in `run-sim.ts`.
 */

export interface StaticRow {
  kind: "prompt" | "thinking" | "prose" | "tool" | "gate" | "note";
  text?: string;
  tool?: { name: string; args: string; out: string[]; lines: string };
  noteTone?: "config" | "policy";
  noteStatus?: string;
}

interface Props {
  sim: string;
  rows: StaticRow[];
  hint?: string;
  description: string;
}

const {
  sim,
  rows,
  hint = "Ask the local Nerve agent",
  description,
} = Astro.props;
---

<div class="run-panel" data-run-sim={sim}>
  <p class="visually-hidden" id={`run-description-${sim}`}>{description}</p>

  <ol
    class="run-feed"
    data-run-feed
    aria-label="Simulated agent transcript"
    aria-describedby={`run-description-${sim}`}
  >
    {
      rows.map((row) => {
        if (row.kind === "tool" && row.tool) {
          return (
            <li
              class="run-item run-tool"
              data-state="done"
              data-tool={row.tool.name}
            >
              <div class="run-tool-head">
                <span class="run-tool-status">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9.5" />
                    <path d="m8.5 12.5 2.5 2.5 4.5-5" />
                  </svg>
                </span>
                <b class="run-tool-name">{row.tool.name}</b>
                <code class="run-tool-args">{row.tool.args}</code>
              </div>
              <div class="run-tool-out">
                <pre>{row.tool.out.join("\n")}</pre>
              </div>
              <div class="run-tool-foot">
                <span class="run-tool-lines">{row.tool.lines}</span>
                <span class="run-tool-more">Show 7 more items</span>
              </div>
            </li>
          );
        }

        if (row.kind === "prompt") {
          return (
            <li class="run-item run-prompt">
              <span class="run-prompt-label">You</span>
              <p>{row.text}</p>
            </li>
          );
        }

        if (row.kind === "thinking") {
          return (
            <li class="run-item run-thinking">
              <p>{row.text}</p>
            </li>
          );
        }

        if (row.kind === "gate") {
          return (
            <li class="run-item run-gate" data-gate-state="approved">
              <span class="run-gate-dot" aria-hidden="true" />
              <b>approval</b>
              <span class="run-gate-text">{row.text}</span>
              <span class="run-gate-status">approved</span>
            </li>
          );
        }

        if (row.kind === "note") {
          return (
            <li class="run-item run-note" data-tone={row.noteTone ?? "config"}>
              <code>{row.text}</code>
              <span class="run-note-status">{row.noteStatus}</span>
            </li>
          );
        }

        return (
          <li class="run-item run-prose">
            <p>{row.text}</p>
          </li>
        );
      })
    }
  </ol>
  <p class="visually-hidden" data-run-status aria-live="polite"></p>

  <div class="run-composer">
    <p class="run-composer-hint">{hint}</p>

    <div class="run-composer-bar">
      <span class="run-tb-btn run-tb-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"/></svg></span>
      <span class="run-tb-sep"></span>
      <span class="run-tb-btn run-tb-profile" title="Agent profile: Coding or Planning">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
        <select class="run-tb-label" data-run-profile aria-label="Agent profile"><option value="coding">Coding</option><option value="planning">Planning</option></select>
      </span>
      <span class="run-tb-btn run-tb-model">
        <span class="run-tb-label" data-run-model>Opus (High)</span>
      </span>
      <span class="run-tb-btn run-tb-perm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
        <span class="run-tb-label" data-run-permission data-value="supervised">supervised</span>
      </span>
      <span class="run-tb-btn run-tb-icon run-tb-caps"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="7" x="14" y="3" rx="1"/><path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"/></svg></span>
      <span class="run-composer-spacer"></span>
      <span class="run-tb-ctx">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="3" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="var(--border)"></circle>
          <circle cx="12" cy="12" r="9" stroke="var(--primary)" stroke-linecap="round" pathLength="100" stroke-dasharray="21 100" transform="rotate(-90 12 12)"></circle>
        </svg>
        <b>21%</b>
      </span>
      <span class="run-tb-btn run-tb-icon run-tb-mic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19v3"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><rect x="9" y="2" width="6" height="13" rx="3"/></svg></span>
      <span class="run-tb-send"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg></span>
    </div>
  </div>
</div>

<style>
  select[data-run-profile] {
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  /* Top-anchored: the turn fills the panel from the first row and, once full,
   * the sim scrolls to the newest row. (The shared default is bottom-anchored,
   * which leaves the upper half of the panel empty while a turn is starting.)
   * The authored static transcript scrolls instead of clipping, so no-JS and
   * reduced-motion visitors can still reach every row. */
  .run-panel :global(.run-feed) {
    position: relative;
    justify-content: flex-start;
    overflow-x: clip;
    overflow-y: auto;
    scrollbar-width: none;
    mask-image: none;
    -webkit-mask-image: none;
  }

  .run-panel :global(.run-feed) {
    height: clamp(20rem, 44vh, 24.5rem);
  }

  .run-panel :global(.run-feed::-webkit-scrollbar) {
    display: none;
  }

  /* Once live the feed is unclipped: the sim prunes rows that no longer fit,
   * so there is no scroller to flatten the 3D stack in the hero. */
  .run-panel :global(.run-feed[data-live]) {
    overflow: visible;
  }
</style>
