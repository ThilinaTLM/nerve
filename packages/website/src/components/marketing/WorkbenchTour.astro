---
import conversationDark from "../../assets/screenshots/desktop/conversation-dark.webp";
import conversationLight from "../../assets/screenshots/desktop/conversation-light.webp";
import pullRequestDark from "../../assets/screenshots/desktop/pull-request-dark.webp";
import pullRequestLight from "../../assets/screenshots/desktop/pull-request-light.webp";
import tasksDark from "../../assets/screenshots/desktop/tasks-dark.webp";
import tasksLight from "../../assets/screenshots/desktop/tasks-light.webp";
import gitDark from "../../assets/screenshots/desktop/git-dark.webp";
import gitLight from "../../assets/screenshots/desktop/git-light.webp";
import DeviceFrame from "./DeviceFrame.astro";
import Reveal from "./Reveal.astro";
import ThemeScreenshot from "./ThemeScreenshot.astro";

/* The media column is pinned while the copy column scrolls, so each shot gets
 * the full width of the section instead of a narrow half-column. `tourStage()`
 * in `stage/tour.ts` writes `data-active`; with no script the first shot
 * stays visible and every copy block is still readable. */

const stops = [
  {
    eyebrow: "Inspect every action",
    title: "The transcript is the evidence.",
    body: "Prompts, reasoning, commands, edits, results, and recovery stay separate and inspectable.",
    points: [
      "Tool calls retain their inputs and their bounded output",
      "Changes stay reviewable before they ship",
    ],
    dark: conversationDark,
    light: conversationLight,
    label: "nerve · conversation",
    alt: "Nerve conversation showing file edits, a background verification task, retained output, and the composer",
  },
  {
    eyebrow: "Every change, accounted for",
    title: "Git is a panel, not a second tool.",
    body: "Watch the working tree change as the agent works. Stage, unstage, discard, fetch, pull, push, and sync from the same shell as the conversation.",
    points: [
      "The diff the agent produced is the diff you review",
      "Destructive actions ask before they run",
    ],
    dark: gitDark,
    light: gitLight,
    label: "nerve · git",
    alt: "Nerve workbench with a conversation on the left and the Git panel listing unstaged changes on the right",
  },
  {
    eyebrow: "Review before you merge",
    title: "Pull requests live beside the work.",
    body: "Open a pull request, read its summary, inspect files, and see check status without leaving the workbench.",
    points: [
      "Mergeability is visible at a glance",
      "Checks and changed files have dedicated views",
    ],
    meta: "Requires a GitHub remote plus gh auth login.",
    dark: pullRequestDark,
    light: pullRequestLight,
    label: "nerve · pull request",
    alt: "Nerve pull request view with summary, mergeability overview, and a ready-to-merge panel",
  },
  {
    eyebrow: "Supervised processes",
    title: "Long-running work keeps a pulse.",
    body: "Run and revisit development servers, builds, and tests with durable output and explicit start, stop, and restart controls.",
    points: [
      "Runs preserve their status and output",
      "Up to 24 hours of runtime per task run",
    ],
    dark: tasksDark,
    light: tasksLight,
    label: "nerve · tasks",
    alt: "Nerve tasks view listing task runs with status pills beside streamed process output",
  },
];
---

<div class="tour" data-tour data-active="0">
  <div class="tour-copy">
    {
      stops.map((stop, index) => (
        <Reveal
          class="tour-stop"
          data-tour-stop
          data-stop-active={index === 0 ? "true" : "false"}
        >
          <span class="tour-index label-chip">
            {String(index + 1).padStart(2, "0")}
          </span>
          <p class="eyebrow">{stop.eyebrow}</p>
          <h3 class="section-title tour-title">{stop.title}</h3>
          <p class="body-text">{stop.body}</p>
          <ul class="tour-points">
            {stop.points.map((point) => (
              <li>
                <span class="bouton" aria-hidden="true" />
                {point}
              </li>
            ))}
          </ul>
          {stop.meta && <p class="meta-text">{stop.meta}</p>}

          {/* At narrow widths each stop carries its own frame instead of
              relying on a pinned media column. */}
          <div class="tour-inline-media">
            <DeviceFrame label={stop.label} depth={2}>
              <ThemeScreenshot
                dark={stop.dark}
                light={stop.light}
                alt={stop.alt}
                widths={[720, 1080, 1440, 2000, 2880]}
                sizes="100vw"
                loading="lazy"
              />
            </DeviceFrame>
          </div>
        </Reveal>
      ))
    }
  </div>

  <div class="tour-media" aria-hidden="true">
    <div class="tour-sticky">
      <DeviceFrame label="nerve" depth={3} tilt class="tour-frame">
        <div class="tour-shots">
          {
            stops.map((stop, index) => (
              <div class="tour-shot" data-shot={index}>
                <ThemeScreenshot
                  dark={stop.dark}
                  light={stop.light}
                  alt=""
                  widths={[720, 1080, 1600, 2000, 2880]}
                  sizes="62vw"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </div>
            ))
          }
        </div>
      </DeviceFrame>

      <div class="tour-legend">
        {
          stops.map((stop, index) => (
            <span class="legend-item" data-legend={index}>
              {stop.label}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .tour {
    display: grid;
    gap: var(--stack-gap);
  }

  .tour-copy {
    display: grid;
    gap: var(--stack-gap);
  }

  .tour-stop {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .tour-index {
    color: var(--primary);
  }

  .tour-title {
    /* Sized for the copy column, not for a full-width heading: the previous
     * value wrapped this to four lines in a narrow column. */
    font-size: clamp(1.45rem, 1.15rem + 0.9vw, 1.9rem);
  }

  .tour-points {
    display: grid;
    gap: 0.6rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted-foreground);
    font-size: 0.95rem;
  }

  .tour-points li {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .tour-points .bouton {
    flex: none;
    box-shadow: 0 0 0 0.25rem color-mix(in oklab, var(--primary) 14%, transparent);
  }

  .tour-inline-media {
    margin-top: 1.25rem;
  }

  /* The pinned column only exists where there is room for it. */
  .tour-media {
    display: none;
  }

  .tour-shots {
    position: relative;
  }

  .tour-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 1024px) {
    .tour {
      grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
      gap: clamp(2.5rem, 4vw, 4rem);
      /* Stretch, not start: the media column must be as tall as the copy
       * column or its sticky child has no distance to travel and the frame
       * scrolls away from the text it belongs to. */
      align-items: stretch;
    }

    .tour-copy {
      gap: 26vh;
      /* Runway on both ends. The first stop starts beside the centred sticky
       * frame instead of at the section's top edge — without the inset there
       * is no scroll position where stop 01 and the screenshot actually sit
       * side by side (26rem ≈ the height of one stop). The final stop needs
       * half a usable viewport so the frame stays centred instead of
       * colliding with the tour boundary. */
      padding-block: max(
          2vh,
          calc((100svh - var(--nav-height) - 26rem) / 2)
        )
        calc((100svh - var(--nav-height)) / 2);
    }

    .tour-inline-media {
      display: none;
    }

    .tour-media {
      display: block;
      height: 100%;
    }

    /* A full-height sticky box that centres its own content. Centring with a
     * translate instead would paint the frame outside the column and over the
     * section heading above it. */
    .tour-sticky {
      position: sticky;
      top: var(--nav-height);
      height: calc(100svh - var(--nav-height));
      display: grid;
      align-content: center;
      gap: 1rem;
      padding-block: 1.5rem;
    }

    /* `.tour-frame` is applied to a component root, so the scoped selector has
     * to reach through with :global. */
    :global(.tour-frame) {
      transform: translateY(var(--stage-parallax, 0px))
        rotateX(var(--stage-rotate, 0deg));
      transform-style: preserve-3d;
    }

    /* Shots are stacked; only the active one is opaque and forward. */
    .tour-shot {
      position: absolute;
      inset: 0;
      visibility: hidden;
      opacity: 0;
      transform: translateZ(-24px) scale(0.99);
      pointer-events: none;
      transition:
        visibility 0s linear 200ms,
        opacity 200ms var(--ease-out-expo),
        transform 200ms var(--ease-out-expo);
    }

    .tour-shot:first-child {
      position: relative;
    }

    .tour[data-active="0"] .tour-shot[data-shot="0"],
    .tour[data-active="1"] .tour-shot[data-shot="1"],
    .tour[data-active="2"] .tour-shot[data-shot="2"],
    .tour[data-active="3"] .tour-shot[data-shot="3"] {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0ms;
      pointer-events: auto;
    }

    /* Once the stage is driving the change it owns opacity, scale, and blur, so
     * the CSS cross-fade steps aside. Without script the rules above still
     * switch shots on `data-active`. */
    .tour-shots[data-shots-live] .tour-shot {
      visibility: visible;
      transition: none;
    }

    .tour-legend {
      display: flex;
      gap: 1.25rem;
      justify-content: center;
    }

    .legend-item {
      position: relative;
      padding-bottom: 0.3rem;
      color: var(--muted-foreground);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      opacity: 0.4;
      transition:
        color 320ms var(--ease-out-expo),
        opacity 320ms var(--ease-out-expo);
    }

    .legend-item::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 1px;
      background-color: var(--primary);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 420ms var(--ease-out-expo);
    }

    .tour[data-active="0"] [data-legend="0"],
    .tour[data-active="1"] [data-legend="1"],
    .tour[data-active="2"] [data-legend="2"],
    .tour[data-active="3"] [data-legend="3"] {
      color: var(--primary);
      opacity: 1;
    }

    .tour[data-active="0"] [data-legend="0"]::after,
    .tour[data-active="1"] [data-legend="1"]::after,
    .tour[data-active="2"] [data-legend="2"]::after,
    .tour[data-active="3"] [data-legend="3"]::after {
      transform: scaleX(1);
    }

    /* Inactive copy recedes so the active stop reads as the current one, but
     * never so far that it looks like a rendering fault. */
    /* Dimmed with `filter`, not `opacity`: the reveal system owns each stop's
     * opacity with a stronger selector, so an opacity rule here silently lost
     * and every stop stayed equally bright. */
    .tour-stop {
      position: relative;
      padding-left: 2.9rem;
      transition: filter 420ms var(--ease-out-expo);
    }

    /* Only dim once something is actually driving the active stop. Without the
     * stage — no script, or reduced motion — nothing would ever restore these
     * blocks, so they stay at full contrast. */
    .tour[data-rail-live] .tour-stop {
      filter: opacity(0.42);
    }

    .tour[data-rail-live] .tour-stop[data-stop-active="true"] {
      filter: none;
    }

    /* One rail, not four bars. Each stop's segment reaches halfway into the
     * gap on either side, so the track reads as a single line down the
     * chapter list and the fill can run continuously through it. */
    .tour-stop::before,
    .tour-stop::after {
      content: "";
      position: absolute;
      top: -13vh;
      bottom: -13vh;
      left: 0.78rem;
      width: 2px;
    }

    .tour-stop:first-child::before,
    .tour-stop:first-child::after {
      top: 0.4rem;
    }

    .tour-stop:last-child::before,
    .tour-stop:last-child::after {
      bottom: 0.4rem;
    }

    .tour-stop::before {
      background-color: var(--hairline);
    }

    /* Scrubbed by `tourStage()`: the fill tracks reading position rather than
     * snapping when a stop becomes active. */
    .tour-stop::after {
      background: linear-gradient(
        180deg,
        var(--primary),
        color-mix(in oklab, var(--primary) 60%, var(--signal))
      );
      transform: scaleY(var(--stop-progress, 0));
      transform-origin: top;
    }

    /* Without the scrub there is no progress value to read, so the segment
     * simply fills while its stop is the active one. */
    .tour:not([data-rail-live]) .tour-stop[data-stop-active="true"]::after {
      transform: scaleY(1);
      transition: transform 560ms var(--ease-out-expo);
    }

    /* The chapter number becomes the rail's node, instead of floating above
     * the eyebrow with nothing to attach to. */
    .tour-stop .tour-index {
      position: absolute;
      /* Above the rail: the fill pseudo-element paints after in-flow children,
       * so without this the line runs straight through the node. */
      z-index: 1;
      top: 0.1rem;
      left: 0;
      display: grid;
      place-items: center;
      width: 1.7rem;
      height: 1.7rem;
      border: 1px solid var(--hairline);
      border-radius: 999px;
      background-color: var(--background);
      color: var(--muted-foreground);
      transition:
        color 420ms var(--ease-out-expo),
        border-color 420ms var(--ease-out-expo),
        box-shadow 420ms var(--ease-out-expo);
    }

    .tour-stop[data-stop-active="true"] .tour-index {
      border-color: color-mix(in oklab, var(--primary) 55%, var(--border));
      background-color: color-mix(in oklab, var(--primary) 10%, var(--background));
      box-shadow: 0 0 0 0.3rem
        color-mix(in oklab, var(--primary) 10%, transparent);
      color: var(--primary);
    }
  }
</style>
