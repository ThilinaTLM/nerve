---
import { Image } from "astro:assets";
import desktop from "../../assets/shots/d1-conversation.webp";
import phone from "../../assets/shots/m1-conversation.webp";
import InstallCommand from "./InstallCommand.astro";
import NeuralField from "./NeuralField.astro";
import PhoneFrame from "./PhoneFrame.astro";
import Reveal from "./Reveal.astro";
import ScreenshotFrame from "./ScreenshotFrame.astro";
---
<section class="signal-hero" data-signal-section>
  <NeuralField /><div class="grain" aria-hidden="true"></div>
  <div class="container-wide hero-shell">
    <div class="hero-copy">
      <Reveal><span class="badge"><span class="badge-dot animate-pulse-ring" aria-hidden="true"></span>Open source · local first · beta</span></Reveal>
      <Reveal delay={80}><h1 class="display-title">See the work.<br/><span class="gradient-text signal-title">Keep control.</span></h1></Reveal>
      <Reveal delay={160}><p class="lede">Nerve is a transparent desktop coding harness with the focus of a small agent and the workflow of a complete workbench. Messages, reasoning, tool calls, approvals, tasks, and changes stay visible.</p></Reveal>
      <Reveal delay={240}><div class="hero-actions"><a class="btn btn-primary" href="/start/install/">Get started <span aria-hidden="true">→</span></a><a class="btn btn-ghost" href="https://github.com/ThilinaTLM/nerve">View on GitHub</a></div></Reveal>
      <Reveal delay={320}><InstallCommand /></Reveal>
    </div>
    <Reveal variant="scale" delay={140} class="device-cluster">
      <span class="device-glow" aria-hidden="true"></span>
      <ScreenshotFrame parallax={18} class="desktop-device"><Image src={desktop} alt="Nerve conversation showing reasoning, tool calls, a code diff, and composer controls" widths={[720,1080,1600,2000]} sizes="(max-width:1024px) 96vw, 58vw" loading="eager" /></ScreenshotFrame>
      <PhoneFrame parallax={-26} class="hero-phone"><Image src={phone} alt="Nerve conversation and composer at phone width" widths={[390,600,900]} sizes="20vw" loading="eager" /></PhoneFrame>
    </Reveal>
  </div>
</section>
<style>
  .signal-hero{position:relative;isolation:isolate;overflow:hidden;min-height:calc(100svh - var(--nav-height));padding-block:clamp(4rem,9vw,8rem)}.hero-shell{position:relative;z-index:2;display:grid;align-items:center;gap:clamp(3rem,6vw,6rem)}.hero-copy{display:grid;gap:1.5rem}.hero-copy .lede{max-width:38rem}.hero-actions{display:flex;flex-wrap:wrap;gap:.75rem}.badge-dot{width:.45rem;height:.45rem;border-radius:999px;background:var(--success);color:var(--success)}.signal-title{position:relative}.signal-title::after{content:"";position:absolute;left:0;right:0;bottom:-.15em;height:2px;background:linear-gradient(90deg,transparent,var(--primary),var(--brand-2),transparent);transform-origin:left;animation:axon-charge 1.4s var(--ease-out-expo) both}.device-cluster{position:relative;padding:2rem 1rem 3rem}.device-glow{position:absolute;inset:15%;background:var(--primary);opacity:.15;filter:blur(80px)}.desktop-device{position:relative;z-index:1}.hero-phone{position:absolute;z-index:3;left:-2%;bottom:-2%;width:24%;min-width:8rem}
  @media(min-width:1024px){.hero-shell{grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr)}}@media(max-width:639px){.hero-phone{display:none}.device-cluster{padding-inline:0}}
</style>
