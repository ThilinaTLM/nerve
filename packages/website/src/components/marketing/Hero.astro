---
/* The hero.
 *
 * Centered copy over one wide picture: a workbench assembling itself from four
 * plain requests (`ForgeStage`, replayed by `scripts/marketing/forge-stage.ts`).
 * The stage is flat on purpose: a 3D tilt rasterizes small UI text.
 * `stage/hero.ts` owns the entrance and the scroll-out.
 */

import DendriteField from "./DendriteField.astro";
import ForgeStage from "./ForgeStage.astro";
import Reveal from "./Reveal.astro";
---

<section class="hero" data-hero>
  <DendriteField class="hero-dendrites" />
  <span class="hero-glow" aria-hidden="true"></span>
  <div class="grain" aria-hidden="true"></div>

  <div class="container-page hero-shell">
    <div class="hero-copy" data-hero-copy>
      <Reveal>
        <span class="badge">
          <span class="badge-dot animate-pulse-ring" aria-hidden="true"></span>
          New: the Forge profile
        </span>
      </Reveal>

      <Reveal delay={80}>
        <h1 class="display-title">
          The coding workbench that <span class="gradient-text hero-charge"
            >builds itself</span
          >.
        </h1>
      </Reveal>

      <Reveal delay={160}>
        <p class="lede hero-lede">
          AI agents that write, test and ship your code. Need a panel, a
          workflow or a tool? Ask, and Forge builds it.
        </p>
      </Reveal>

      <Reveal delay={240}>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/start/install/">
            Install Nerve <span aria-hidden="true">→</span>
          </a>
          <a
            class="btn btn-ghost"
            href="https://github.com/ThilinaTLM/nerve"
            aria-label="Nerve on GitHub"
            data-github-star-link
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.35-1.3-1.7-1.3-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.03 1.78 2.7 1.27 3.36.97.1-.75.4-1.27.73-1.56-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
              ></path>
            </svg>
            <span>Star on GitHub</span>
            <span class="hero-star-separator" aria-hidden="true"></span>
            <span
              class="hero-star-count"
              data-github-star-count
              aria-hidden="true"
              >00</span
            >
          </a>
        </div>
      </Reveal>

      <Reveal delay={320} class="hero-install">
        <p class="meta-text">Free &amp; open source · Linux · macOS · Windows</p>
      </Reveal>
    </div>

    <Reveal variant="scale" delay={140} class="hero-stage">
      <div class="hero-deck" data-hero-deck>
        <ForgeStage />
      </div>
    </Reveal>
  </div>
</section>

<script>
  import "../../scripts/marketing/github-stars";
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: calc(100svh - var(--nav-height));
    /* Tight enough that the headline, lede, install command, and the whole
     * device land inside one viewport at common laptop heights. */
    padding-block: clamp(1.5rem, 3.5vw, 4rem) clamp(2.25rem, 5vw, 5rem);
    display: grid;
    align-content: center;
  }

  .hero-dendrites {
    z-index: 0;
    transform: translateZ(var(--z-back));
  }

  /* Keep the dendrite branches out of the centered headline: they show at the
   * sides and fade toward the middle. */
  .hero-dendrites {
    mask-image: radial-gradient(ellipse 38% 45% at 50% 32%, transparent 40%, black 100%);
    -webkit-mask-image: radial-gradient(
      ellipse 38% 45% at 50% 32%,
      transparent 40%,
      black 100%
    );
  }

  .hero-glow {
    position: absolute;
    z-index: 0;
    inset: 45% 15% 0 15%;
    background: radial-gradient(circle, var(--primary), transparent 62%);
    opacity: 0.18;
    filter: blur(90px);
    pointer-events: none;
  }

  :global(:root[data-theme="light"]) .hero-glow {
    opacity: 0.12;
  }

  .hero-shell {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-copy {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 1.8vh, 1.5rem);
    max-width: 52rem;
    text-align: center;
    transform: translateY(var(--copy-shift, 0px));
    will-change: transform;
  }

  .hero-copy .display-title {
    font-size: clamp(2.5rem, 1.2rem + 2.8vw, 3.9rem);
  }

  .hero-lede {
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero-star-separator {
    width: 1px;
    height: 1rem;
    background-color: var(--hairline);
  }

  .hero-star-count {
    min-width: 1.6em;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .hero-install {
    display: grid;
    gap: 0.6rem;
  }

  .badge-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-pill);
    background: var(--warning);
    color: var(--warning);
  }

  /* The headline's second line charges like an axon on first paint. `--charge`
   * is 1 in the authored state, so the underline exists with no script. */
  .hero-charge {
    position: relative;
  }

  .hero-charge::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.14em;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--primary),
      var(--signal),
      transparent
    );
    opacity: var(--charge, 1);
    transform: scaleX(var(--charge, 1));
    transform-origin: left;
  }

  :global(html[data-motion-ready]) .hero-charge {
    --charge: 0;
  }

  /* Stage ---------------------------------------------------------------- */

  .hero-stage {
    position: relative;
    width: min(64rem, 100%);
  }

  /* The scroll stage writes --deck-lift, --deck-scale and the entrance writes
   * --deck-enter-y. Translate and scale only: no rotation, so text stays
   * sharp. Nothing animates `transform` directly. */
  .hero-deck {
    position: relative;
    transform: translateY(calc(var(--deck-lift, 0px) + var(--deck-enter-y, 0px)))
      scale(var(--deck-scale, 1));
  }

  @media (max-width: 1199px) {
    .hero {
      min-height: 0;
    }
  }
</style>
