---
/* The hero.
 *
 * One tilted 3D device with the live simulated run (`run-simulation.ts`). Each
 * typed event lands as a glass card that rises off the transcript into depth;
 * the approval card hangs highest until it is approved, then snaps back. The
 * scroll-out collapses the layers flat (`stage/hero.ts`). The rows authored
 * below are the canonical turn, so no-JS and reduced-motion visitors read a
 * complete, flat transcript.
 */

import DendriteField from "./DendriteField.astro";
import DeviceFrame from "./DeviceFrame.astro";
import InstallCommand from "./InstallCommand.astro";
import Reveal from "./Reveal.astro";
import RunPanel, { type StaticRow } from "./RunPanel.astro";

/* Mirrors `buildTurn(TASKS[0], defaults)` with the gate already resolved. */
const staticRows: StaticRow[] = [
  { kind: "prompt", text: "Add a retry budget to the run recovery path." },
  {
    kind: "thinking",
    text: "Recovery lives in run-recovery.ts. A budget needs the retry count and the base delay in one place, so both call sites read one constant.",
  },
  {
    kind: "tool",
    tool: {
      name: "read",
      args: "packages/harness/src/run-recovery.ts",
      out: ["Read 214 lines"],
      lines: "214 lines",
    },
  },
  { kind: "gate", text: "edit needs review" },
  {
    kind: "tool",
    tool: {
      name: "edit",
      args: "packages/harness/src/run-recovery.ts",
      out: ["+12 −3 · retry budget wired into the recovery loop"],
      lines: "2 hunks",
    },
  },
  {
    kind: "tool",
    tool: {
      name: "bash",
      args: "pnpm test --filter @nervekit/harness -- run-recovery",
      out: ["✓ recovery continues from checkpoint (12 tests)", "Done in 3.2s"],
      lines: "6 lines",
    },
  },
  {
    kind: "prose",
    text: "Retry budget added: three attempts on a 2s exponential base.",
  },
];
---

<section class="hero" data-hero>
  <DendriteField class="hero-dendrites" />
  <span class="hero-glow" aria-hidden="true"></span>
  <div class="grain" aria-hidden="true"></div>

  <div class="container-page hero-shell">
    <div class="hero-copy" data-hero-copy>
      <Reveal>
        <span class="badge">
          <span class="badge-dot animate-pulse-ring" aria-hidden="true"></span>
          Free &amp; open source · Beta
        </span>
      </Reveal>

      <Reveal delay={80}>
        <h1 class="display-title">
          More work per token.<br /><span class="gradient-text hero-charge"
            >More control per run.</span
          >
        </h1>
      </Reveal>

      <Reveal delay={160}>
        <p class="lede hero-lede">
          An open-source coding workbench on a lean, well-tested harness — your
          subscription goes to your problem, and every step stays in plain
          sight.
        </p>
      </Reveal>

      <Reveal delay={240}>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/start/install/">
            Install Nerve <span aria-hidden="true">→</span>
          </a>
          <a
            class="btn btn-ghost"
            href="https://github.com/ThilinaTLM/nerve"
            aria-label="Nerve on GitHub"
            data-github-star-link
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.35-1.3-1.7-1.3-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.03 1.78 2.7 1.27 3.36.97.1-.75.4-1.27.73-1.56-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
              ></path>
            </svg>
            <span>Star on GitHub</span>
            <span class="hero-star-separator" aria-hidden="true"></span>
            <span
              class="hero-star-count"
              data-github-star-count
              aria-hidden="true"
              >00</span
            >
          </a>
        </div>
      </Reveal>

      <Reveal delay={320} class="hero-install">
        <InstallCommand />
        <p class="meta-text">Linux · macOS · Windows · local-first</p>
      </Reveal>
    </div>

    <Reveal variant="scale" delay={140} class="hero-stage stage-3d">
      <div
        class="hero-deck tilt-target"
        data-hero-deck
        data-tilt
        data-tilt-max="5"
      >
        <DeviceFrame label="nerve · live run" depth={3}>
          <RunPanel
            sim="hero"
            rows={staticRows}
            description="Simulated Nerve run: the user prompt, the agent's reasoning, a read tool call with its bounded output, an approval gate for an edit, the applied diff, a verification command, and the final reply."
          />
        </DeviceFrame>
      </div>
    </Reveal>
  </div>
</section>

<script>
  import "../../scripts/marketing/github-stars";
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: calc(100svh - var(--nav-height));
    /* Tight enough that the headline, lede, install command, and the whole
     * device land inside one viewport at common laptop heights. */
    padding-block: clamp(1.5rem, 3.5vw, 4rem) clamp(2.25rem, 5vw, 5rem);
    display: grid;
    align-content: center;
  }

  .hero-dendrites {
    z-index: 0;
    transform: translateZ(var(--z-back));
  }

  /* The dendrite field belongs behind the run panel, not behind the headline:
   * fade it out across the copy column so branches never run through type. */
  @media (min-width: 1200px) {
    .hero-dendrites {
      mask-image:
        linear-gradient(
          to bottom,
          transparent,
          black 18%,
          black 72%,
          transparent
        ),
        linear-gradient(to right, transparent 6%, black 46%);
      -webkit-mask-image:
        linear-gradient(
          to bottom,
          transparent,
          black 18%,
          black 72%,
          transparent
        ),
        linear-gradient(to right, transparent 6%, black 46%);
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
    }
  }

  .hero-glow {
    position: absolute;
    z-index: 0;
    inset: 20% 8% 25% 40%;
    background: radial-gradient(circle, var(--primary), transparent 62%);
    opacity: 0.18;
    filter: blur(90px);
    pointer-events: none;
  }

  :global(:root[data-theme="light"]) .hero-glow {
    opacity: 0.12;
  }

  .hero-shell {
    position: relative;
    z-index: 2;
    display: grid;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .hero-copy {
    display: grid;
    gap: clamp(0.85rem, 1.4vh, 1.25rem);
    transform: translateY(var(--copy-shift, 0px));
    will-change: transform;
  }

  /* The hero headline runs one step smaller than the section display size:
   * at full size it wraps to four lines and pushes the install command out of
   * the first viewport. */
  .hero-copy .display-title {
    font-size: clamp(2.3rem, 1.15rem + 2.3vw, 3.35rem);
  }

  .hero-lede {
    max-width: 34rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-star-separator {
    width: 1px;
    height: 1rem;
    background-color: var(--hairline);
  }

  .hero-star-count {
    min-width: 1.6em;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .hero-install {
    display: grid;
    gap: 0.6rem;
  }

  .badge-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-pill);
    background: var(--warning);
    color: var(--warning);
  }

  /* The headline's second line charges like an axon on first paint. `--charge`
   * is 1 in the authored state, so the underline exists with no script. */
  .hero-charge {
    position: relative;
  }

  .hero-charge::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.14em;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--primary),
      var(--signal),
      transparent
    );
    opacity: var(--charge, 1);
    transform: scaleX(var(--charge, 1));
    transform-origin: left;
  }

  :global(html[data-motion-ready]) .hero-charge {
    --charge: 0;
  }

  /* Stage --------------------------------------------------------------- */

  .hero-stage {
    position: relative;
  }

  /* One composed transform, several owners: the scroll stage writes
   * --deck-rotate-x and --deck-lift, the entrance writes --deck-enter-*, and
   * pointer tilt writes --tilt-*. Nothing animates `transform` directly. */
  .hero-deck {
    position: relative;
    transform: rotateX(
        calc(
          var(--deck-rotate-x, 3deg) + var(--tilt-x, 0deg) +
            var(--deck-enter-rotate, 0deg)
        )
      )
      rotateY(calc(-7deg + var(--tilt-y, 0deg)))
      translateY(calc(var(--deck-lift, 0px) + var(--deck-enter-y, 0px)))
      scale(var(--deck-scale, 1));
    transform-style: preserve-3d;
    transition: transform 120ms linear;
  }

  /* The exploded run ----------------------------------------------------- *
   * The deck is one preserve-3d stack: device plate at z=0, each transcript
   * event a glass card floating above it. Every ancestor between the deck and
   * the cards must stay unclipped and unfiltered or the browser flattens the
   * stack, so the clipping the shared frame normally does is handed to the
   * plate's own background and radius. */

  .hero-deck :global(.device-wrap),
  .hero-deck :global(.device),
  .hero-deck :global(.device-screen),
  .hero-deck :global(.run-panel),
  .hero-deck :global(.run-feed[data-live]) {
    transform-style: preserve-3d;
  }

  .hero-deck :global(.device),
  .hero-deck :global(.device-screen) {
    overflow: visible;
  }

  .hero-deck :global(.run-panel) {
    border-radius: 0 0 var(--radius-screen) var(--radius-screen);
  }

  /* The plate's soft ground shadow sells the height of the layers above it. */
  .hero-deck :global(.device) {
    box-shadow: 0 40px 80px -40px color-mix(in oklab, black 55%, transparent);
  }

  /* Live feed: top-anchored, unclipped. The sim prunes rows that no longer
   * fit, so nothing needs a scroller (a scroller would flatten the stack). */
  .hero-deck :global(.run-feed[data-live]) {
    position: relative;
    overflow: visible;
    mask-image: none;
    -webkit-mask-image: none;
    gap: 0.7rem;
  }

  /* Depth is data: --zk is the kind's resting height, --r is recency (1 for
   * the newest card, sinking for older ones), --lift-k collapses everything
   * (the scroll-out scrubs it to 0). Pointer parallax is free: the deck tilts
   * in 3D, so layers at different z shift by different amounts. */
  .hero-deck :global(.run-feed[data-live] .run-item) {
    --zk: 72px;
    --r: 0.4;
    --z: calc(var(--zk) * var(--r) * var(--lift-k, 1));
    position: relative;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background-color: color-mix(in oklab, var(--card) 92%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in oklab, white 10%, transparent);
    transform: translate3d(0, 0, var(--z))
      rotateX(calc(var(--r) * var(--lift-k, 1) * -3deg))
      rotateZ(calc(var(--tw, 1) * var(--r) * var(--lift-k, 1) * 0.35deg));
    transition: --r 560ms cubic-bezier(0.34, 1.5, 0.64, 1);
    animation: hero-rise 640ms cubic-bezier(0.2, 0.9, 0.25, 1.1) backwards;
  }

  .hero-deck :global(.run-feed[data-live] .run-item:nth-child(even)) {
    --tw: -1;
  }

  .hero-deck :global(.run-feed[data-live] .run-item:nth-last-child(1)) {
    --r: 1;
  }
  .hero-deck :global(.run-feed[data-live] .run-item:nth-last-child(2)) {
    --r: 0.75;
  }
  .hero-deck :global(.run-feed[data-live] .run-item:nth-last-child(3)) {
    --r: 0.55;
  }

  .hero-deck :global(.run-feed[data-live] .run-tool) {
    --zk: 100px;
  }
  .hero-deck :global(.run-feed[data-live] .run-prose) {
    --zk: 88px;
  }
  .hero-deck :global(.run-feed[data-live] .run-thinking) {
    --zk: 56px;
  }
  .hero-deck :global(.run-feed[data-live] .run-gate) {
    --zk: 120px;
  }

  /* The approval card hangs highest and breathes until it is approved, then
   * snaps back into the stack (the --r transition overshoots slightly). */
  .hero-deck :global(.run-feed[data-live] .run-gate[data-gate-state="waiting"]) {
    --r: 1.5;
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 12%, transparent),
      0 0 28px -8px color-mix(in oklab, var(--warning) 55%, transparent);
    animation:
      hero-rise 640ms cubic-bezier(0.2, 0.9, 0.25, 1.1) backwards,
      hero-gate-pulse 1.8s ease-in-out 640ms infinite;
  }

  /* A soft contact shadow under each card; opacity follows height. */
  .hero-deck :global(.run-feed[data-live] .run-item)::before {
    content: "";
    position: absolute;
    inset: 10px 10px -18px;
    z-index: -1;
    border-radius: inherit;
    background: color-mix(in oklab, black 55%, transparent);
    filter: blur(16px);
    opacity: calc(0.18 + var(--r) * 0.3);
    transform: translateZ(calc(var(--z) * -0.9));
    pointer-events: none;
  }

  :global(:root[data-theme="light"]) .hero-deck :global(.run-feed[data-live] .run-item)::before {
    background: color-mix(in oklab, var(--foreground) 40%, transparent);
  }

  @property --r {
    syntax: "<number>";
    inherits: false;
    initial-value: 1;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, calc(var(--z) * -1 - 30px)) rotateX(8deg)
        scale(0.97);
    }
  }

  @keyframes hero-gate-pulse {
    50% {
      transform: translate3d(0, 0, calc(var(--z) * 1.12))
        rotateX(calc(var(--r) * var(--lift-k, 1) * -3deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-deck :global(.run-item) {
      animation: none !important;
      transition: none !important;
    }
  }


  /* Responsive ----------------------------------------------------------- */

  @media (min-width: 1200px) {
    .hero-shell {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }
  }

  @media (max-width: 1199px) {
    .hero {
      min-height: 0;
    }

    /* Fully flat on small screens: the tilt controller does not run, and the
     * perspective context plus `will-change` promotion would rasterize the
     * panel as a texture — visibly soft text on high-DPR phone screens. */
    .hero-stage {
      perspective: none;
      transform-style: flat;
    }

    .hero-deck {
      transform: none;
      will-change: auto;
      transition: none;
    }
  }

  /* Mobile keeps depth subtle: no perspective, so each card only lifts a
   * couple of pixels with its shadow. */
  @media (max-width: 1199px) {
    .hero-deck :global(.run-feed[data-live] .run-item) {
      transform: translateY(calc(var(--r) * var(--lift-k, 1) * -2px));
    }
  }
</style>
