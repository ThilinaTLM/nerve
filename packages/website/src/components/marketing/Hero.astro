---
/* The hero: the workbench film, full bleed.
 *
 * The whole first screen is the 3D workbench (`HeroWorkbench`) playing
 * example runs, with its chapter caption as the message. It runs up under
 * the transparent site header so the two read as one surface. A small title
 * line says what Nerve is, and a floating install control (`InstallFab`)
 * carries the call to action.
 *
 * `stage/hero.ts` owns the entrance and the scroll-out.
 */

import DendriteField from "./DendriteField.astro";
import HeroWorkbench from "./HeroWorkbench.astro";
import InstallFab from "./InstallFab.astro";
---

<section class="hero" data-hero>
  <DendriteField class="hero-dendrites" />
  <span class="hero-glow" aria-hidden="true"></span>
  <div class="grain" aria-hidden="true"></div>

  <div class="hero-deck" data-hero-deck>
    <HeroWorkbench />
  </div>

  <div class="hero-title-wrap" data-hero-copy>
    <h1 class="hero-title">
      <span class="sr-only">Nerve: </span>The open-source AI coding workbench
    </h1>
  </div>
</section>

<InstallFab />

<style>
  /* Pulled up under the sticky header, which is transparent at the top of
   * the page, so the scene starts at the very top of the window. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    height: 100svh;
    min-height: 34rem;
    max-height: 70rem;
    margin-top: calc(-1 * var(--nav-height) - 1px);
  }

  .hero-dendrites {
    z-index: 0;
    transform: translateZ(var(--z-back));
    mask-image: radial-gradient(ellipse 45% 50% at 50% 50%, transparent 40%, black 100%);
    -webkit-mask-image: radial-gradient(
      ellipse 45% 50% at 50% 50%,
      transparent 40%,
      black 100%
    );
  }

  .hero-glow {
    position: absolute;
    z-index: 0;
    inset: 20% 15% 15%;
    background: radial-gradient(circle, var(--primary), transparent 62%);
    opacity: 0.16;
    filter: blur(90px);
    pointer-events: none;
  }

  :global(:root[data-theme="light"]) .hero-glow {
    opacity: 0.1;
  }

  /* The entrance writes --deck-enter-y and the scroll-out --deck-lift. */
  .hero-deck {
    position: absolute;
    inset: var(--nav-height) 0 0;
    z-index: 1;
    transform: translateY(calc(var(--deck-lift, 0px) + var(--deck-enter-y, 0px)));
  }

  .hero-title-wrap {
    position: absolute;
    top: calc(var(--nav-height) + clamp(0.75rem, 3vh, 2rem));
    left: 50%;
    z-index: 2;
    width: min(calc(100% - 2rem), 40rem);
    text-align: center;
    transform: translate(-50%, var(--copy-shift, 0px));
    pointer-events: none;
  }

  /* The nav already names Nerve; the title says what it is, quietly. */
  .hero-title {
    margin: 0;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 0.66rem + 0.25vw, 0.85rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
