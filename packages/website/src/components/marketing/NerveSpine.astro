<div class="nerve-spine" data-nerve-spine aria-hidden="true">
  <span class="spine-track"></span><span class="spine-signal"></span><span class="spine-impulse"></span>
  {Array.from({ length: 7 }, (_, index) => <span class="spine-node" style={`--node-index:${index}`}></span>)}
</div>
<style>
  .nerve-spine { position: fixed; z-index: 20; top: var(--nav-height); bottom: 0; left: 0.35rem; width: 1.25rem; pointer-events: none; }
  .spine-track,.spine-signal { position: absolute; top: 0; bottom: 0; left: 0.55rem; width: 1px; background: var(--hairline); }
  .spine-signal { bottom: auto; height: calc(var(--scroll-progress, 0) * 100%); background: linear-gradient(var(--primary),var(--brand-2)); box-shadow: var(--glow-primary); }
  .spine-impulse { position: absolute; top: calc(var(--scroll-progress, 0) * 100%); left: 0.3rem; width: 0.55rem; height: 0.55rem; border-radius: 999px; background: var(--primary); box-shadow: var(--glow-primary); transform: translateY(-50%); }
  .spine-node { position: absolute; top: calc((var(--node-index) + 1) * 12.5%); left: 0.38rem; width: 0.35rem; height: 0.35rem; border: 1px solid var(--primary); border-radius: 999px; background: var(--background); }
  @media (min-width:1280px) { .nerve-spine { left: max(1.25rem, calc((100vw - var(--container-max)) / 4)); } }
  @media (prefers-reduced-motion:reduce) { .spine-signal,.spine-impulse { display:none; } }
</style>
