---
/* Mission control: projects run side by side (left), one lead fans a named
 * batch out to sub-agents (right), and a supervised dev server runs beside
 * them. The authored markup is the finished state; `stage/team.ts` replays the
 * run as a loop. All names and results are illustrative. */

const lanes = [
  {
    project: "acme-web",
    chats: [
      { title: "Checkout form a11y", note: "running", p: 54 },
      { title: "Bump design tokens", note: "running", p: 31 },
    ],
  },
  {
    project: "acme-api",
    active: true,
    chats: [
      { title: "Add rate limiting", note: "lead", p: 78 },
      { title: "Fix flaky auth test", note: "idle", p: 100 },
    ],
  },
  {
    project: "infra",
    chats: [{ title: "Node image upgrade", note: "running", p: 66 }],
  },
];

/* `y` is the node's centre on the 1000 × 560 desktop canvas. */
const agents = [
  {
    name: "map-auth-flow",
    profile: "explore",
    trait: "read-only",
    task: "Trace the token refresh path",
    result: "report · 6 files traced",
    y: 65,
  },
  {
    name: "api-limiter",
    profile: "developer",
    trait: "autonomous",
    task: "Add rate-limit middleware",
    result: "follow-up done · tests added",
    followUp: true,
    y: 170,
  },
  {
    name: "settings-ui",
    profile: "ui-developer",
    trait: "your profile",
    custom: true,
    task: "Build the limits form",
    result: "report · 2 components edited",
    y: 275,
  },
  {
    name: "check-tests",
    profile: "explore",
    trait: "read-only",
    task: "Find uncovered branches",
    result: "report · 3 gaps found",
    y: 380,
  },
];

const task = { y: 485 };
const pct = (y: number) => `${(y / 5.6).toFixed(2)}%`;
const edge = (y: number) => `M520 280 C595 280 585 ${y} 660 ${y}`;
const laneY = [105, 280, 455];
---

<div
  class="team"
  data-team
  role="group"
  aria-label="Three projects running in parallel; in one, a lead agent hands work to four named sub-agents and a background dev server"
>
  <div class="team-stage stage-3d">
   <div class="team-plane" data-tilt data-tilt-max="4">
    <div class="team-grid" aria-hidden="true"></div>
    <svg
      class="team-wires"
      viewBox="0 0 1000 560"
      aria-hidden="true"
      focusable="false"
    >
      <path class="team-wire" data-wire="lane" d="M230 280 L330 280"></path>
      {
        agents.map((agent, i) => (
          <path class="team-wire" data-wire={i} d={edge(agent.y)} />
        ))
      }
      <path
        class="team-wire team-wire-task"
        data-wire="task"
        d={edge(task.y)}></path>
    </svg>

    <div class="team-lanes">
      {
        lanes.map((lane, li) => (
          <section
            class:list={["team-lane", { "is-active": lane.active }]}
            style={`--y:${pct(laneY[li])}`}
            aria-label={`Project ${lane.project}`}
          >
            <header class="team-lane-head">
              <span class="team-lane-name">{lane.project}</span>
              <span class="label-chip">{lane.chats.length} tabs</span>
            </header>
            <ul class="team-chats">
              {lane.chats.map((chat) => (
                <li class="team-chat">
                  <span class="team-chat-title">{chat.title}</span>
                  <span
                    class:list={[
                      "team-chat-note",
                      { "is-lead": chat.note === "lead" },
                    ]}
                  >
                    {chat.note}
                  </span>
                  <span class="team-bar" aria-hidden="true">
                    <i data-lane-bar style={`--p:${chat.p}%`} />
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="team-lead glass-panel" style={`--y:${pct(280)}`}>
      <span class="eyebrow">Lead agent</span>
      <strong class="team-lead-title">Add rate limiting</strong>
      <span class="team-lead-sub">
        <span data-lead-status>Reports in</span>
        <span class="team-lead-count"><b data-lead-count>4</b>/4</span>
      </span>
    </div>

    <ul class="team-agents">
      {
        agents.map((agent, i) => (
          <li
            class:list={["team-agent", { "is-custom": agent.custom }]}
            data-agent={i}
            data-state="done"
            style={`--y:${pct(agent.y)}`}
          >
            <div class="team-agent-top">
              <span class="team-agent-name">{agent.name}</span>
              <span class="team-state" data-state-label>
                done
              </span>
            </div>
            <div class="team-agent-meta">
              <span class="team-profile">{agent.profile}</span>
              <span class="team-trait">{agent.trait}</span>
            </div>
            <p class="team-agent-line" data-note>
              <span class="team-agent-task">{agent.task}</span>
              <span class="team-agent-result">{agent.result}</span>
            </p>
            {agent.followUp && (
              <span class="team-follow" data-follow>
                ↳ follow-up · same agent, same context
              </span>
            )}
          </li>
        ))
      }
      <li
        class="team-agent team-task"
        data-task
        data-state="running"
        style={`--y:${pct(task.y)}`}
      >
        <div class="team-agent-top">
          <span class="team-agent-name">pnpm dev</span>
          <span class="team-state" data-state-label>running</span>
        </div>
        <p class="team-agent-line">
          <span class="team-agent-task">Dev server · background task</span>
          <span class="team-agent-result">logs retained</span>
        </p>
      </li>
    </ul>

    {
      agents.map((agent, i) => (
        <span
          class="synapse-node team-end"
          data-end={i}
          data-charged="true"
          style={`--x:66%;--y:${pct(agent.y)}`}
          aria-hidden="true"
        />
      ))
    }
   </div>
  </div>

  <div class="team-facts">
    <span class="badge">Up to 10 per batch</span>
    <span class="badge">Profiles: model · thinking · permission · tools · skills</span>
    <span class="badge">Follow up by name</span>
  </div>
  <p class="meta-text team-note">Illustrative run.</p>
</div>

<style>
  .team {
    display: grid;
    gap: 1.25rem;
  }

  .team-stage {
    position: relative;
  }

  .team-plane {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .team-grid {
    display: none;
  }

  /* On mobile the wires stay in the tree (the timeline measures them) but
   * collapse out of sight; the CSS rail stands in for them. */
  .team-wires {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .team-end {
    display: none;
  }

  /* Shared surface for lane, lead, and agent nodes. */
  .team-lane,
  .team-agent {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background-color: var(--card);
  }

  /* Lanes ------------------------------------------------------------------ */
  .team-lanes {
    display: grid;
    gap: 0.5rem;
  }

  .team-lane {
    padding: 0.6rem 0.75rem;
  }

  .team-lane.is-active {
    border-color: var(--myelin);
    box-shadow: var(--glow-signal);
  }

  .team-lane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .team-lane-name {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .team-chats {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team-chat {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .team-chat-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .team-chat-note {
    color: var(--muted-foreground);
    font-size: 0.7rem;
  }

  .team-chat-note.is-lead {
    color: var(--signal);
    font-weight: 600;
  }

  .team-bar {
    grid-column: 1 / -1;
    height: 3px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background-color: var(--myelin-dim);
  }

  .team-bar i {
    display: block;
    width: var(--p);
    height: 100%;
    border-radius: inherit;
    background-color: var(--myelin);
  }

  .is-active .team-bar i {
    background-color: var(--signal);
  }

  /* Lead -------------------------------------------------------------------- */
  .team-lead {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--signal);
    border-radius: var(--radius-panel);
    box-shadow: var(--glow-signal);
  }

  .team-lead-title {
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .team-lead-sub {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .team-lead-count {
    color: var(--foreground);
    font-variant-numeric: tabular-nums;
  }

  /* Agents ------------------------------------------------------------------ */
  .team-agents {
    position: relative;
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0 0 0 1rem;
    list-style: none;
  }

  /* Mobile rail: the same edge, laid out vertically. */
  .team-agents::before {
    content: "";
    position: absolute;
    top: -0.5rem;
    bottom: 1rem;
    left: 0;
    width: 1px;
    background-color: var(--myelin);
  }

  .team-agent {
    position: relative;
    display: grid;
    gap: 0.3rem;
    padding: 0.6rem 0.75rem;
  }

  /* Glow ring: lit on arrival, report, and follow-up. Opacity only. */
  .team-agent::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    box-shadow:
      0 0 0 1px var(--glow, var(--signal)),
      0 0 1.4rem -0.2rem var(--glow, var(--signal));
    opacity: 0;
    pointer-events: none;
    transition: opacity 450ms var(--ease-out-expo);
  }

  .team-agent[data-lit="true"]::after {
    opacity: 1;
  }

  .team-agent[data-state="done"] {
    --glow: var(--success);
  }

  .team-agent::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -1rem;
    width: 1rem;
    height: 1px;
    background-color: var(--myelin);
  }

  .team-agent-top,
  .team-agent-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .team-agent-meta {
    justify-content: flex-start;
  }

  .team-agent-name {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .team-profile {
    padding: 0.05rem 0.45rem;
    border: 1px solid currentcolor;
    border-radius: var(--radius-pill);
    background-color: color-mix(in oklab, currentcolor 10%, transparent);
    color: var(--info);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .team-agent[data-agent="1"] .team-profile {
    color: var(--primary);
  }

  .is-custom .team-profile {
    border-style: dashed;
    color: var(--signal);
  }

  .team-trait {
    color: var(--muted-foreground);
    font-size: 0.7rem;
  }

  .is-custom .team-trait {
    color: var(--signal);
  }

  .team-agent-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .team-agent-task {
    color: var(--muted-foreground);
  }

  .team-agent-result {
    color: var(--success);
  }

  .team-follow {
    color: var(--signal);
    font-size: 0.7rem;
  }

  /* State pill: the word and its colour, driven by `data-state`. */
  .team-state {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--success);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .team-state::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background-color: currentcolor;
  }

  [data-state="running"] .team-state {
    color: var(--info);
  }

  [data-state="running"] .team-state::before {
    animation: team-blink 1.1s ease-in-out infinite;
  }

  [data-state="queued"] .team-state {
    color: var(--muted-foreground);
  }

  [data-state="running"] .team-agent-result,
  [data-state="queued"] .team-agent-result {
    display: none;
  }

  .team-task .team-agent-result {
    display: inline;
    color: var(--muted-foreground);
  }

  .team-task {
    border-style: dashed;
  }

  @keyframes team-blink {
    50% {
      opacity: 0.25;
    }
  }

  /* Facts ------------------------------------------------------------------- */
  .team-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .team-note {
    margin: 0;
    text-align: center;
  }

  /* Desktop: one fixed 1000 × 560 canvas so SVG edges and HTML nodes share
   * coordinates at every width. */
  @media (min-width: 1024px) {
    .team-stage {
      padding-block: 1rem;
    }

    .team-plane {
      display: block;
      aspect-ratio: 1000 / 560;
      transform-style: preserve-3d;
      transform: rotateX(calc(var(--plane-x, 6deg) + var(--tilt-x, 0deg)))
        rotateY(var(--tilt-y, 0deg));
      will-change: transform;
    }

    /* The holographic table the whole canvas sits on. */
    .team-grid {
      display: block;
      position: absolute;
      inset: -3% -2%;
      border: 1px solid var(--hairline);
      border-radius: var(--radius-panel);
      background-color: color-mix(in oklab, var(--primary) 4%, transparent);
      background-image:
        linear-gradient(var(--myelin-dim) 1px, transparent 1px),
        linear-gradient(90deg, var(--myelin-dim) 1px, transparent 1px);
      background-size: 3.5rem 3.5rem;
      mask-image: radial-gradient(
        ellipse at 50% 50%,
        black 40%,
        transparent 100%
      );
      -webkit-mask-image: radial-gradient(
        ellipse at 50% 50%,
        black 40%,
        transparent 100%
      );
      opacity: 0.7;
      pointer-events: none;
    }

    .team-wires {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 1;
      overflow: visible;
      translate: 0 0 40px;
    }

    .team-wire {
      fill: none;
      stroke: var(--myelin);
      stroke-width: 1.5;
      transition: stroke 300ms var(--ease-out-expo);
    }

    .team-wire-task {
      stroke-dasharray: 4 5;
    }

    :global(.team-wire[data-live="true"]) {
      stroke: var(--signal);
    }

    .team-end {
      display: grid;
      position: absolute;
      top: var(--y);
      left: var(--x);
      translate: -50% -50% 40px;
    }

    .team-lanes {
      display: block;
    }

    .team-lane {
      position: absolute;
      top: var(--y);
      left: 0;
      width: 23%;
      translate: 0 -50% 28px;
    }

    .team-lead {
      position: absolute;
      top: var(--y);
      left: 33%;
      width: 19%;
      translate: 0 -50% 64px;
    }

    .team-agents {
      display: block;
      position: static;
      padding: 0;
    }

    .team-agents::before,
    .team-agent::before {
      display: none;
    }

    .team-agent {
      position: absolute;
      top: var(--y);
      left: 66%;
      width: 34%;
      translate: 0 -50% 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-plane {
      transform: none !important;
    }

    .team-state::before {
      animation: none !important;
    }
  }
</style>

