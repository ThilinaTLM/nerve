---
/* The hero art: the workbench, exploded and running.
 *
 * A stylised drawing of the Nerve window tilted in 3D, its parts lifted
 * apart in layers: conversations, the chat, the dock with the panel Forge
 * built, launches, and around them what runs produce (a pull request, a
 * Jira issue, and a phone beside the laptop that gets the push). It is an
 * illustration, not a capture: chrome is reduced to skeleton lines, and the
 * words come from the demo workspace and the app's own tool names and
 * notification titles.
 *
 * `hero-workbench.ts` plays it as a short film: a camera (`data-wb-camera`)
 * moves through the scene while each example run types, works and lands,
 * and the chapter bar under the art names the run and jumps between them.
 * The markup shows the first run finished in the overview, so the art reads
 * the same without script. Sizes are in container units so the scene scales
 * with its column. Layers rise into place on load (`wb-rise`), the scene
 * follows the pointer (`data-tilt`), and a hovered layer lifts toward the
 * viewer. Nothing loops in CSS on the scene itself, so its text re-rasters
 * crisply at every camera zoom.
 */
import BrandIcon from "./BrandIcon.astro";
import { profileIcons } from "./hero-profiles";
import { heroPrompts } from "../../scripts/marketing/hero-prompts";

const first = heroPrompts[0]!;

const glyph = {
  pr: "M6 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM18 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM6 9v12M13 6h3a2 2 0 0 1 2 2v7",
  play: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM10 8.5v7l6-3.5z",
};
---

<figure
  class="wb"
  data-hero-workbench
  data-profile={first.profile}
  data-tilt
  data-tilt-max="5"
  aria-label="An illustration of the Nerve workbench running example tasks: Forge building a dock panel, a coding agent fixing a flaky test and opening a pull request, a lead splitting a migration across sub-agents, an agent working a Jira issue, and a plan reaching your phone over Tailscale."
>
  <div class="wb-frame" aria-hidden="true">
  <div class="wb-camera" data-wb-camera>
  <div class="wb-view">
  <div class="wb-tilt">
    <div class="wb-scene">
      <!-- Base: the window frame. -->
      <div class="wb-layer wb-window" style="--z:0;--d:0ms">
        <div class="wb-titlebar">
          <span class="wb-logo"><img src="/favicon.svg" alt="" /></span>
          <span class="wb-tab is-active">aurora</span>
          <span class="wb-tab">northstar</span>
          <span class="wb-tab">relayboard</span>
        </div>
        <div class="wb-statusbar">
          <span class="wb-bar" style="width:22%"></span>
          <span class="wb-dot is-success"></span>
          <span class="wb-bar" style="width:10%"></span>
        </div>
      </div>

      <!-- Conversations. -->
      <div class="wb-layer wb-panel wb-sidebar" style="--z:1.6;--d:120ms">
        <span class="wb-heading">Needs you</span>
        <div class="wb-row"><span class="wb-dot is-warning"></span><span class="wb-bar" style="width:70%"></span></div>
        <div class="wb-row"><span class="wb-dot is-danger"></span><span class="wb-bar" style="width:55%"></span></div>
        <span class="wb-heading">Today</span>
        <div class="wb-row is-active"><span class="wb-dot is-primary is-live"></span><span class="wb-bar" style="width:76%"></span></div>
        <div class="wb-row"><span class="wb-dot"></span><span class="wb-bar" style="width:62%"></span></div>
        <div class="wb-row"><span class="wb-dot"></span><span class="wb-bar" style="width:68%"></span></div>
        <div class="wb-row"><span class="wb-dot"></span><span class="wb-bar" style="width:48%"></span></div>
      </div>

      <!-- The chat: a live transcript over the composer. -->
      <div class="wb-layer wb-panel wb-chat" style="--z:3.2;--d:220ms">
        <div class="wb-transcript" data-wb-transcript>
          <div class="wb-bubble">{first.text}</div>
          {
            first.steps.map((step) =>
              "agents" in step ? null : (
                <div class="wb-step is-done">
                  <span class="wb-status" />
                  <code>{step.tool}</code>
                  <span class="wb-step-detail">{step.detail}</span>
                </div>
              ),
            )
          }
          <p class="wb-reply">{first.reply}</p>
        </div>
        <div class="wb-composer" data-wb-composer>
          <p class="wb-input">
            <span data-wb-input></span><span class="wb-caret"></span><span
              class="wb-placeholder">Ask the local Nerve agent</span
            >
          </p>
          <div class="wb-composer-bar">
            <span class="wb-chip">
              {
                Object.entries(profileIcons).map(([name, d]) => (
                  <svg class={`wb-glyph wb-profile is-${name}`} viewBox="0 0 24 24">
                    <path d={d} />
                  </svg>
                ))
              }
              <span data-wb-profile>{first.label}</span>
            </span>
            <span class="wb-send"></span>
          </div>
        </div>
      </div>

      <!-- The Forge impulse from the composer into the docked panel. -->
      <svg class="wb-layer wb-signal" style="--z:4.6;--d:500ms" viewBox="0 0 100 64" preserveAspectRatio="none">
        <path class="wb-signal-wire" d="M40 57 C 58 57, 62 20, 74 18" />
        <path class="wb-signal-impulse" d="M40 57 C 58 57, 62 20, 74 18" pathLength="100" />
      </svg>

      <!-- The panel Forge built, docked. -->
      <div class="wb-layer wb-panel wb-dock" data-wb-card="dock" style="--z:6.4;--d:340ms">
        <span class="wb-title">Environments</span>
        <div class="wb-env">
          <span class="wb-dot is-warning"></span><span>QA</span>
          <span class="wb-pill is-warning">Degraded</span>
        </div>
        <div class="wb-env">
          <span class="wb-dot is-success"></span><span>Production</span>
          <span class="wb-pill is-success">Healthy</span>
        </div>
        <span class="wb-tag">Built by Forge</span>
      </div>

      <!-- Launches. -->
      <div class="wb-layer wb-panel wb-launches" style="--z:4;--d:420ms">
        <div class="wb-row">
          <svg class="wb-glyph is-success" viewBox="0 0 24 24"><path d={glyph.play} /></svg>
          <span>dev server</span>
          <span class="wb-dot is-success is-live"></span>
        </div>
        <div class="wb-row">
          <svg class="wb-glyph is-success" viewBox="0 0 24 24"><path d={glyph.play} /></svg>
          <span>tests · watch</span>
          <span class="wb-dot is-success is-live"></span>
        </div>
      </div>

      <!-- What runs produce, floating highest. -->
      <div class="wb-layer wb-float wb-pr" style="--z:12;--d:620ms">
        <div class="wb-card" data-wb-card="pr">
          <svg class="wb-glyph is-success" viewBox="0 0 24 24"><path d={glyph.pr} /></svg>
          <span>Pull request <b>aurora-api#42</b></span>
        </div>
      </div>

      <div class="wb-layer wb-float wb-jira" style="--z:9;--d:700ms">
        <div class="wb-card" data-wb-card="jira">
          <span class="wb-brand"><BrandIcon name="jira" size={14} /></span>
          <span class="wb-lines">
            <span class="wb-bar" style="width:5em"></span>
            <span class="wb-bar" style="width:3.4em"></span>
          </span>
        </div>
      </div>

      <!-- A phone beside the laptop, reached over Tailscale. -->
      <div class="wb-layer wb-float wb-phone" style="--z:10;--d:780ms">
        <div class="wb-phone-body" data-wb-card="phone">
          <div class="wb-phone-status">
            <span>9:41</span>
            <span class="wb-phone-tailnet"><BrandIcon name="tailscale" size={9} /></span>
          </div>
          <div class="wb-notif">
            <span class="wb-notif-app"><img src="/favicon.svg" alt="" />Nerve</span>
            <b data-wb-phone-title>{first.push}</b>
            <span data-wb-phone-body>aurora · {first.title}</span>
          </div>
          <span class="wb-phone-host">aurora-dev.tail4f2a9.ts.net</span>
        </div>
      </div>
    </div>
  </div>
  </div>
  </div>
  </div>

  <div class="wb-chapters">
    <p class="wb-caption" data-wb-caption aria-live="polite">{first.caption}</p>
    <div class="wb-chapter-row" role="group" aria-label="Example runs">
      {
        heroPrompts.map((prompt, index) => (
          <button
            type="button"
            class="wb-chapter"
            aria-pressed={index === 0 ? "true" : "false"}
            data-wb-chapter
          >
            {prompt.chapter}
          </button>
        ))
      }
    </div>
  </div>
</figure>

<script>
  import "../../scripts/marketing/hero-workbench";
</script>

<style>
  .wb {
    position: relative;
    display: grid;
    gap: 0.9rem;
    width: 100%;
    margin: 0;
  }

  /* The window the film is seen through: fixed while the camera moves, its
   * edges fading so a zoomed scene does not end on a hard line. */
  .wb-frame {
    position: relative;
    aspect-ratio: 1.3;
    overflow: clip;
    mask-image:
      linear-gradient(to right, transparent, black 5%, black 95%, transparent),
      linear-gradient(to bottom, transparent, black 5%, black 92%, transparent);
    -webkit-mask-image:
      linear-gradient(to right, transparent, black 5%, black 95%, transparent),
      linear-gradient(to bottom, transparent, black 5%, black 92%, transparent);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  /* The camera zooms by resizing this container, not by scaling it: every
   * size in the scene is in container units, so a zoomed scene is laid out
   * and rasterised at its real size and its text stays sharp.
   * `hero-workbench.ts` writes the width, height and translate. One
   * container unit is 1% of the camera's width. */
  .wb-camera {
    container-type: inline-size;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .wb-view {
    position: absolute;
    inset: 0;
    perspective: 300cqw;
    perspective-origin: 50% 40%;
  }

  /* Pointer tilt (`tilt.ts` writes --tilt-x/--tilt-y on the figure) on a
   * wrapper, so it composes with the scene's own tilt and sway. */
  .wb-tilt {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
  }

  .wb-scene {
    position: absolute;
    top: 14cqw;
    left: 5cqw;
    width: 82cqw;
    height: 52cqw;
    transform-style: preserve-3d;
    transform: rotateX(38deg) rotateZ(-20deg);
    font-size: 1.6cqw;
    line-height: 1.25;
  }

  .wb-layer {
    position: absolute;
    transform: translateZ(calc(var(--z) * 1cqw));
    transition: translate 360ms cubic-bezier(0.2, 0.8, 0.2, 1);
    animation: wb-rise 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: var(--d);
  }

  /* Once risen, the layers drop the animation: Chrome keeps a layer under a
   * running or filled transform animation at the raster scale it started
   * with, which would leave the text soft when the camera zooms in. */
  .wb.is-risen .wb-layer {
    animation: none;
  }

  /* A hovered layer lifts toward the viewer. `translate` composes with the
   * transform the rise animation holds. */
  .wb-layer:not(.wb-window, .wb-signal):hover {
    translate: 0 0 2cqw;
  }

  /* Window ------------------------------------------------------------- */

  .wb-window {
    inset: 0;
    border: 1px solid var(--hairline);
    border-radius: 1.4cqw;
    background: color-mix(in oklab, var(--card) 92%, var(--background));
    box-shadow:
      0 4cqw 8cqw -2cqw color-mix(in oklab, black 45%, transparent),
      0 0 0 1px color-mix(in oklab, var(--primary) 8%, transparent);
  }

  .wb-titlebar {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    height: 7%;
    padding-inline: 1.6cqw;
    border-bottom: 1px solid var(--hairline);
    color: var(--muted-foreground);
    font-size: 1.3cqw;
  }

  .wb-logo img {
    display: block;
    width: 2cqw;
    height: 2cqw;
  }

  .wb-tab.is-active {
    color: var(--foreground);
  }

  .wb-statusbar {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    gap: 1cqw;
    height: 6%;
    padding-inline: 1.6cqw;
    border-top: 1px solid var(--hairline);
  }

  /* Panels -------------------------------------------------------------- */

  .wb-panel {
    display: flex;
    flex-direction: column;
    gap: 1.1cqw;
    padding: 1.6cqw;
    border: 1px solid var(--hairline);
    border-radius: 1cqw;
    background: var(--card);
    box-shadow: 0 1.8cqw 3cqw -1.4cqw color-mix(in oklab, black 40%, transparent);
  }

  .wb-sidebar {
    top: 10%;
    left: 1.5%;
    width: 23%;
    height: 80%;
  }

  .wb-chat {
    top: 10%;
    left: 26.5%;
    width: 44%;
    height: 80%;
  }

  .wb-dock {
    top: 10%;
    left: 72.5%;
    width: 26%;
    height: 46%;
  }

  .wb-launches {
    top: 60%;
    left: 72.5%;
    width: 26%;
    height: 30%;
    justify-content: center;
  }

  .wb-signal {
    pointer-events: none;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .wb-signal-wire {
    stroke: color-mix(in oklab, var(--signal) 55%, transparent);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
  }

  .wb-signal-impulse {
    stroke: var(--signal);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 16 200;
    stroke-dashoffset: 16;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 4px var(--signal));
    opacity: 0;
  }

  .wb.is-firing .wb-signal-impulse {
    animation: wb-impulse 1.6s ease-in-out both;
  }

  .wb-heading {
    margin-top: 0.4cqw;
    color: var(--muted-foreground);
    font-size: 1.25cqw;
    font-weight: 600;
  }

  .wb-row {
    display: flex;
    align-items: center;
    gap: 1cqw;
    padding: 0.7cqw 0.8cqw;
    border-radius: 0.6cqw;
    color: var(--foreground);
  }

  .wb-row.is-active {
    background: color-mix(in oklab, var(--primary) 12%, transparent);
  }

  .wb-bar {
    display: block;
    height: 0.9cqw;
    border-radius: 1cqw;
    background: color-mix(in oklab, var(--foreground) 14%, transparent);
  }

  .wb-lines {
    display: grid;
    gap: 0.8cqw;
  }

  .wb-dot {
    flex: none;
    width: 1cqw;
    height: 1cqw;
    border-radius: 50%;
    background: color-mix(in oklab, var(--foreground) 25%, transparent);
  }

  .wb-dot.is-primary {
    background: var(--primary);
  }

  .wb-dot.is-success {
    background: var(--success);
  }

  .wb-dot.is-warning {
    background: var(--warning);
  }

  .wb-dot.is-danger {
    background: var(--destructive);
  }

  .wb-glyph {
    flex: none;
    width: 1.9cqw;
    height: 1.9cqw;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .is-success {
    color: var(--success);
  }

  .is-warning {
    color: var(--warning);
  }

  .wb-transcript :global(.wb-bubble) {
    overflow: hidden;
    align-self: flex-end;
    max-width: 88%;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0.9cqw 1.3cqw;
    border-radius: 1cqw;
    background: color-mix(in oklab, var(--foreground) 9%, transparent);
    color: var(--foreground);
    font-weight: 600;
  }

  .wb-transcript {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.9cqw;
    min-height: 0;
    overflow: hidden;
    /* Rows pushed out of the top fade instead of cutting off. */
    mask-image: linear-gradient(transparent, black 4cqw);
    -webkit-mask-image: linear-gradient(transparent, black 4cqw);
  }

  .wb-transcript > :global(*) {
    flex: none;
    transition:
      opacity 320ms ease,
      translate 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .wb-transcript > :global(.is-entering) {
    opacity: 0;
    translate: 0 1cqw;
  }

  .wb-transcript :global(.wb-step) {
    display: flex;
    align-items: center;
    gap: 1cqw;
    padding: 0.75cqw 1.1cqw;
    border: 1px solid var(--hairline);
    border-radius: 0.7cqw;
    color: var(--muted-foreground);
    font-size: 1.3cqw;
    white-space: nowrap;
  }

  .wb-transcript :global(.wb-step code) {
    color: var(--foreground);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .wb-transcript :global(.wb-step-detail) {
    overflow: hidden;
    font-family: var(--font-mono);
    text-overflow: ellipsis;
  }

  .wb-transcript :global(.wb-agents) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6cqw;
  }

  .wb-transcript :global(.wb-agent) {
    display: flex;
    align-items: center;
    gap: 0.8cqw;
    padding: 0.6cqw 0.9cqw;
    border-radius: 0.7cqw;
    background: color-mix(in oklab, var(--primary) 9%, transparent);
    color: var(--foreground);
    font-size: 1.2cqw;
    white-space: nowrap;
  }

  /* Status: a spinning ring while running, a check once done. */
  .wb-transcript :global(.wb-status) {
    position: relative;
    flex: none;
    width: 1.5cqw;
    height: 1.5cqw;
    border-radius: 50%;
  }

  .wb-transcript :global(.is-running > .wb-status) {
    border: 0.25cqw solid color-mix(in oklab, var(--foreground) 18%, transparent);
    border-top-color: var(--primary);
    animation: wb-spin 0.8s linear infinite;
  }

  .wb-transcript :global(.is-done > .wb-status) {
    background: color-mix(in oklab, var(--success) 22%, transparent);
  }

  .wb-transcript :global(.is-done > .wb-status::after) {
    content: "";
    position: absolute;
    top: 22%;
    left: 36%;
    width: 25%;
    height: 45%;
    border: solid var(--success);
    border-width: 0 0.22cqw 0.22cqw 0;
    transform: rotate(45deg);
  }

  .wb-transcript :global(.wb-reply) {
    margin: 0;
    color: var(--foreground);
  }

  .wb-composer {
    display: grid;
    flex: none;
    gap: 1.2cqw;
    padding: 1cqw 1cqw 1cqw 1.3cqw;
    border: 1px solid var(--hairline);
    border-radius: 1cqw;
  }

  .wb-input {
    min-height: 2.6em;
    margin: 0;
    color: var(--foreground);
    font-size: 1.45cqw;
    font-weight: 500;
    line-height: 1.35;
  }

  .wb-placeholder {
    color: var(--muted-foreground);
  }

  [data-wb-input]:not(:empty) ~ .wb-placeholder {
    display: none;
  }

  .wb-caret {
    display: none;
    width: 0.12cqw;
    min-width: 1.5px;
    height: 1.1em;
    margin-left: 0.1cqw;
    vertical-align: -0.18em;
    background: var(--primary);
    animation: caret-blink 1.1s steps(1) infinite;
  }

  .wb-composer.is-typing .wb-caret {
    display: inline-block;
  }

  .wb-composer.is-typing {
    border-color: color-mix(in oklab, var(--primary) 55%, transparent);
    box-shadow: 0 0 0 0.25cqw color-mix(in oklab, var(--primary) 14%, transparent);
  }

  .wb-composer {
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .wb-send {
    transition: scale 200ms ease;
  }

  .wb-composer.is-sent .wb-send {
    scale: 0.8;
  }

  .wb-composer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wb-profile {
    display: none;
  }

  .wb[data-profile="forge"] .wb-profile.is-forge,
  .wb[data-profile="coding"] .wb-profile.is-coding,
  .wb[data-profile="planning"] .wb-profile.is-planning,
  .wb[data-profile="lead"] .wb-profile.is-lead {
    display: block;
  }

  .wb:not([data-profile="forge"]) .wb-chip {
    border-color: var(--hairline);
    color: var(--muted-foreground);
  }

  .wb-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6cqw;
    padding: 0.5cqw 1cqw;
    border: 1px solid color-mix(in oklab, var(--signal) 60%, transparent);
    border-radius: 1cqw;
    color: var(--signal);
    font-weight: 600;
  }

  .wb-send {
    width: 2.6cqw;
    height: 2.6cqw;
    border-radius: 0.6cqw;
    background: var(--primary);
  }

  .wb-dock {
    border-color: color-mix(in oklab, var(--signal) 65%, transparent);
    box-shadow:
      0 0 4cqw color-mix(in oklab, var(--signal) 30%, transparent),
      0 1.8cqw 3cqw -1.4cqw color-mix(in oklab, black 40%, transparent);
  }

  .wb-title {
    color: var(--foreground);
    font-weight: 700;
  }

  .wb-env {
    display: flex;
    align-items: center;
    gap: 0.9cqw;
    color: var(--foreground);
  }

  .wb-pill {
    margin-left: auto;
    padding: 0.2cqw 0.8cqw;
    border-radius: 0.5cqw;
    background: color-mix(in oklab, currentcolor 14%, transparent);
    font-size: 1.25cqw;
    font-weight: 600;
  }

  .wb-tag {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.3cqw 0.9cqw;
    border-radius: 1cqw;
    background: color-mix(in oklab, var(--signal) 18%, transparent);
    color: var(--signal);
    font-size: 1.2cqw;
    font-weight: 700;
  }

  .wb-launches span {
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 1.3cqw;
  }

  /* Floating results ------------------------------------------------------ */

  .wb-card {
    display: flex;
    align-items: center;
    gap: 1cqw;
    padding: 1.1cqw 1.5cqw;
