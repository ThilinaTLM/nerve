---
/* The hero art: the workbench, exploded and running.
 *
 * A stylised drawing of the Nerve window tilted in 3D, laid out like the
 * app: project tabs and the notification bell in the header; the side panel
 * with its Conversations, Files, Search and Launches tabs; the chat with the
 * Agents tray above the composer; the dock with Git changes and the panel
 * Forge built. Outside the window float what runs reach: a Jira issue, MCP
 * servers, and a phone that gets the push. It is an illustration, not a
 * capture: chrome is reduced to skeleton lines, and the words come from the
 * demo workspace and the app's own tool names, profiles and notification
 * titles.
 *
 * `hero-workbench.ts` plays it as a short film: a camera (`data-wb-camera`)
 * moves through the scene while each example run types, works and lands,
 * and the chapter bar names the run and jumps between them. The markup shows
 * the first run finished in the overview, so the art reads the same without
 * script. Sizes are in container units so the scene scales with its box;
 * the camera zooms by resizing that box, so text stays sharp. Layers rise
 * into place on load (`wb-rise`), the scene follows the pointer
 * (`data-tilt`), and a hovered layer lifts toward the viewer.
 */
import BrandIcon from "./BrandIcon.astro";
import { profileIcons } from "./hero-profiles";
import { heroPrompts } from "../../scripts/marketing/hero-prompts";

const first = heroPrompts[0]!;

/* Lucide-style glyphs for the drawn chrome. */
const glyph = {
  chats:
    "M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2zM18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1",
  files: "M4 4h5l2 2h7v4H4zM4 14h5l2 2h7v4H4zM2 4v16",
  search: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-4.3-4.3",
  terminal: "m4 17 6-6-6-6M12 19h8",
  bell: "M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0",
  gear: "M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1",
  branch:
    "M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 9a9 9 0 0 1-9 9",
  pr: "M6 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM18 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM6 9v12M13 6h3a2 2 0 0 1 2 2v7",
  puzzle:
    "M10 3.5a2 2 0 0 1 4 0V5h4a1 1 0 0 1 1 1v4h-1.5a2 2 0 0 0 0 4H19v4a1 1 0 0 1-1 1h-4v-1.5a2 2 0 0 0-4 0V19H6a1 1 0 0 1-1-1v-4h1.5a2 2 0 0 0 0-4H5V6a1 1 0 0 1 1-1h4z",
  agents:
    "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75",
  play: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM10 8.5v7l6-3.5z",
};
---

<figure
  class="wb"
  data-hero-workbench
  data-profile={first.profile}
  data-side="conversations"
  data-dock="env"
  data-tilt
  data-tilt-max="4"
  aria-label="An illustration of the Nerve workbench running example tasks: Forge building a dock panel, a coding agent fixing a flaky test and opening a pull request, a lead splitting a migration across sub-agents, agents working with Jira, Confluence and MCP servers, restarting a crashed dev server, and a plan reaching your phone over Tailscale."
>
  <div class="wb-frame" aria-hidden="true">
    <div class="wb-camera" data-wb-camera>
      <div class="wb-box">
        <div class="wb-view">
          <div class="wb-tilt">
            <div class="wb-scene">
              <!-- Base: the window, its header and status bar. -->
              <div class="wb-layer wb-window" style="--z:0;--d:0ms">
                <div class="wb-titlebar">
                  <span class="wb-logo"><img src="/favicon.svg" alt="" /></span>
                  <span class="wb-tab is-active">aurora</span>
                  <span class="wb-tab">northstar</span>
                  <span class="wb-tab">relayboard</span>
                  <span class="wb-titlebar-end">
                    <span class="wb-bell">
                      <svg class="wb-glyph" viewBox="0 0 24 24"><path d={glyph.bell} /></svg>
                      <span class="wb-badge" data-wb-badge>1</span>
                    </span>
                    <svg class="wb-glyph" viewBox="0 0 24 24"><path d={glyph.gear} /></svg>
                  </span>
                </div>
                <div class="wb-statusbar">
                  <span class="wb-mono">~/aurora</span>
                  <svg class="wb-glyph" viewBox="0 0 24 24"><path d={glyph.branch} /></svg>
                  <span class="wb-mono">main</span>
                  <span class="wb-status-end"><span class="wb-dot is-success"></span>Connected</span>
                </div>
              </div>

              <!-- Side panel: conversations, files, search, launches. -->
              <div class="wb-layer wb-panel wb-side" data-wb-card="launches" style="--z:1.6;--d:120ms">
                <div class="wb-icon-tabs">
                  <svg class="wb-glyph is-conversations" viewBox="0 0 24 24"><path d={glyph.chats} /></svg>
                  <svg class="wb-glyph" viewBox="0 0 24 24"><path d={glyph.files} /></svg>
                  <svg class="wb-glyph" viewBox="0 0 24 24"><path d={glyph.search} /></svg>
                  <svg class="wb-glyph is-launches" viewBox="0 0 24 24"><path d={glyph.terminal} /></svg>
                </div>
                <div class="wb-pane wb-pane-conversations">
                  <span class="wb-title">Conversations</span>
                  <span class="wb-field"></span>
                  <span class="wb-heading">Today</span>
                  <div class="wb-row is-active">
                    <span class="wb-ring"></span>
                    <span class="wb-row-text" data-wb-conv-title>{first.title}</span>
                  </div>
                  <div class="wb-row"><span class="wb-ring is-idle"></span><span class="wb-bar" style="width:62%"></span></div>
                  <div class="wb-row"><span class="wb-ring is-idle"></span><span class="wb-bar" style="width:70%"></span></div>
                  <span class="wb-heading">Yesterday</span>
                  <div class="wb-row"><span class="wb-ring is-idle"></span><span class="wb-bar" style="width:54%"></span></div>
                  <div class="wb-row"><span class="wb-ring is-idle"></span><span class="wb-bar" style="width:66%"></span></div>
                </div>
                <div class="wb-pane wb-pane-launches">
                  <span class="wb-title">Launches</span>
                  <div class="wb-launch" data-wb-launch="ok">
                    <svg class="wb-glyph" viewBox="0 0 24 24"><path d={glyph.play} /></svg>
                    <span>dev server</span>
                    <span class="wb-launch-state"></span>
                  </div>
                  <div class="wb-launch" data-wb-launch-static="ok">
                    <svg class="wb-glyph" viewBox="0 0 24 24"><path d={glyph.play} /></svg>
                    <span>tests · watch</span>
                    <span class="wb-launch-state"></span>
                  </div>
                  <div class="wb-launch" data-wb-launch-static="off">
                    <svg class="wb-glyph" viewBox="0 0 24 24"><path d={glyph.play} /></svg>
                    <span>storybook</span>
                    <span class="wb-launch-state"></span>
                  </div>
                </div>
              </div>

              <!-- The chat: transcript, the Agents tray and the composer. -->
              <div class="wb-layer wb-panel wb-chat" style="--z:3.2;--d:220ms">
                <div class="wb-chat-tab">
                  <span class="wb-dot is-primary"></span>
                  <span data-wb-chat-title>{first.title}</span>
                </div>
                <div class="wb-transcript" data-wb-transcript>
                  <div class="wb-bubble">{first.text}</div>
                  {
                    first.steps.map((step) =>
                      "tool" in step ? (
                        <div class="wb-step is-done">
                          <span class="wb-status" />
                          <code>{step.tool}</code>
                          <span class="wb-step-detail">{step.detail}</span>
                        </div>
                      ) : null,
                    )
                  }
                  <p class="wb-reply">{first.reply}</p>
                </div>
                <div class="wb-tray" data-wb-tray data-wb-card="agents">
                  <div class="wb-tray-rows" data-wb-tray-rows></div>
                  <div class="wb-tray-bar">
                    <svg class="wb-glyph" viewBox="0 0 24 24"><path d={glyph.agents} /></svg>
                    <span>Agents <b data-wb-tray-count>0</b></span>
                  </div>
                </div>
                <div class="wb-composer" data-wb-composer>
                  <p class="wb-input">
                    <span data-wb-input></span><span class="wb-caret"></span><span
                      class="wb-placeholder">Ask the local Nerve agent</span
                    >
                  </p>
                  <div class="wb-composer-bar">
                    <span class="wb-chip">
                      {
                        Object.entries(profileIcons).map(([name, d]) => (
                          <svg class={`wb-glyph wb-profile is-${name}`} viewBox="0 0 24 24">
                            <path d={d} />
                          </svg>
                        ))
                      }
                      <span data-wb-profile>{first.label}</span>
                    </span>
                    <span class="wb-send"></span>
                  </div>
                </div>
              </div>

              <!-- The Forge impulse from the composer into the dock. -->
              <svg class="wb-layer wb-signal" style="--z:4;--d:500ms" viewBox="0 0 100 64" preserveAspectRatio="none">
                <path class="wb-signal-wire" d="M33 58 C 56 58, 62 22, 76 20" />
                <path class="wb-signal-impulse" d="M33 58 C 56 58, 62 22, 76 20" pathLength="100" />
              </svg>

              <!-- The dock: Git changes, the pull request, and the panel Forge built. -->
              <div class="wb-layer wb-panel wb-dock" data-wb-card="dock" style="--z:4.8;--d:340ms">
                <div class="wb-icon-tabs">
                  <svg class="wb-glyph is-git" viewBox="0 0 24 24"><path d={glyph.branch} /></svg>
                  <svg class="wb-glyph is-git" viewBox="0 0 24 24"><path d={glyph.pr} /></svg>
                  <svg class="wb-glyph is-env" viewBox="0 0 24 24"><path d={glyph.puzzle} /></svg>
                </div>
                <div class="wb-pane wb-pane-git">
                  <span class="wb-title">Git changes</span>
                  <div class="wb-pr" data-wb-card="pr">
                    <span class="wb-pr-head">
                      <svg class="wb-glyph is-success" viewBox="0 0 24 24"><path d={glyph.pr} /></svg>
                      <b data-wb-pr-number>#42</b>
                    </span>
                    <span data-wb-pr-title>Add rate limiting to the booking API</span>
                    <span class="wb-pr-checks"><span class="wb-check"></span>checks passed</span>
                  </div>
                  <span class="wb-heading">Changes</span>
                  <div class="wb-change"><span class="wb-bar" style="width:70%"></span><b>M</b></div>
                  <div class="wb-change"><span class="wb-bar" style="width:55%"></span><b>M</b></div>
                  <div class="wb-change"><span class="wb-bar" style="width:62%"></span><b class="is-add">A</b></div>
                </div>
                <div class="wb-pane wb-pane-env">
                  <span class="wb-title">Environments</span>
                  <div class="wb-env">
                    <span class="wb-dot is-warning"></span><span>QA</span>
                    <span class="wb-pill is-warning">Degraded</span>
                  </div>
                  <div class="wb-env">
                    <span class="wb-dot is-success"></span><span>Production</span>
                    <span class="wb-pill is-success">Healthy</span>
                  </div>
                  <span class="wb-tag">Built by Forge</span>
                </div>
              </div>

              <!-- Notification activity under the bell. -->
              <div class="wb-layer wb-float wb-notifs" style="--z:9;--d:600ms">
                <div class="wb-card wb-notifs-card" data-wb-card="notifs">
                  <span class="wb-title">Notifications</span>
                  <div class="wb-notif-rows" data-wb-notifs>
                    <div class="wb-notif-row">
                      <span class="wb-check"></span>
                      <span>{first.title}</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Outside the window: Jira, MCP servers, a phone. -->
              <div class="wb-layer wb-float wb-jira" style="--z:9;--d:700ms">
                <div class="wb-card" data-wb-card="jira">
                  <span class="wb-brand-jira"><BrandIcon name="jira" size={14} /></span>
                  <span class="wb-lines">
                    <b>Slow venue search</b>
                    <span class="wb-bar" style="width:6em"></span>
                  </span>
                </div>
              </div>

              <div class="wb-layer wb-float wb-mcp" style="--z:8;--d:740ms">
                <div class="wb-card wb-mcp-card" data-wb-card="mcp">
                  <span class="wb-mcp-title">
                    <span class="wb-brand"><BrandIcon name="modelcontextprotocol" size={12} /></span>
                    MCP servers
                  </span>
                  <span class="wb-mcp-row"><span class="wb-dot is-success"></span>github</span>
                  <span class="wb-mcp-row"><span class="wb-dot is-success"></span>docs</span>
                </div>
              </div>

              <div class="wb-layer wb-float wb-phone" style="--z:10;--d:780ms">
                <div class="wb-phone-body" data-wb-card="phone">
                  <div class="wb-phone-status">
                    <span>9:41</span>
                    <span class="wb-brand"><BrandIcon name="tailscale" size={9} /></span>
                  </div>
                  <div class="wb-notif">
                    <span class="wb-notif-app"><img src="/favicon.svg" alt="" />Nerve</span>
                    <b data-wb-phone-title>{first.push}</b>
                    <span data-wb-phone-body>aurora · {first.title}</span>
                  </div>
                  <span class="wb-phone-host">aurora-dev.tail4f2a9.ts.net</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wb-scrim" aria-hidden="true"></div>

  <div class="wb-chapters">
    <p class="wb-caption">
      <span class="wb-caption-num" data-wb-num aria-hidden="true">01</span>
      <span data-wb-caption aria-live="polite">{first.caption}</span>
    </p>
    <div class="wb-track" role="group" aria-label="Example runs">
      {
        heroPrompts.map((prompt, index) => (
          <button
            type="button"
            class="wb-seg"
            aria-pressed={index === 0 ? "true" : "false"}
            style={index === 0 ? "--p:1" : undefined}
            data-wb-chapter
          >
            <span class="wb-seg-bar"><span class="wb-seg-fill" /></span>
            <span class="wb-seg-label">{prompt.chapter}</span>
          </button>
        ))
      }
    </div>
  </div>
</figure>

<script>
  import "../../scripts/marketing/hero-workbench";
</script>

<style>
  /* The art fills whatever box the hero gives it. */
  .wb {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  /* The window the film is seen through: fixed while the camera moves, its
   * edges fading into the page. */
  .wb-frame {
    position: absolute;
    inset: 0;
    overflow: clip;
    mask-image:
      linear-gradient(to right, transparent, black 5%, black 95%, transparent),
      linear-gradient(to bottom, transparent, black 10%, black 88%, transparent);
    -webkit-mask-image:
      linear-gradient(to right, transparent, black 5%, black 95%, transparent),
      linear-gradient(to bottom, transparent, black 10%, black 88%, transparent);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  /* The camera zooms by resizing this container, not by scaling it: every
   * size in the scene is in container units, so a zoomed scene is laid out
   * and rasterised at its real size and its text stays sharp.
   * `hero-workbench.ts` writes the width, height and translate. */
  .wb-camera {
    container-type: size;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* The scene's own box: as large as the camera allows in both directions.
   * Inside it one container unit is 1% of the box width, the unit every
   * size in the scene is written in. */
  .wb-box {
    container-type: inline-size;
    position: absolute;
    top: 46%;
    left: 50%;
    width: min(86cqw, 128cqh);
    aspect-ratio: 1.3;
    transform: translate(-50%, -50%);
  }

  @media (max-width: 47.99rem) {
    .wb-box {
      top: 40%;
      width: min(118cqw, 110cqh);
    }
  }

  .wb-view {
    position: absolute;
    inset: 0;
    perspective: 300cqw;
    perspective-origin: 50% 40%;
  }

  /* Pointer tilt (`tilt.ts` writes --tilt-x/--tilt-y on the figure) on a
   * wrapper, so it composes with the scene's own tilt. */
  .wb-tilt {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
  }

  .wb-scene {
    position: absolute;
    top: 14cqw;
    left: 9cqw;
    width: 82cqw;
    height: 52cqw;
    transform-style: preserve-3d;
    transform: rotateX(38deg) rotateZ(-20deg);
    font-size: 1.5cqw;
    line-height: 1.25;
  }

  .wb-layer {
    position: absolute;
    transform: translateZ(calc(var(--z) * 1cqw));
    transition: translate 360ms cubic-bezier(0.2, 0.8, 0.2, 1);
    animation: wb-rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: var(--d);
  }

  /* Once risen, the layers drop the animation: Chrome keeps a layer under a
   * running or filled transform animation at the raster scale it started
   * with, which would leave the text soft when the camera zooms in. */
  .wb.is-risen .wb-layer {
    animation: none;
  }

  /* A hovered layer lifts toward the viewer. `translate` composes with the
   * layer's own transform. */
  .wb-layer:not(.wb-window, .wb-signal):hover {
    translate: 0 0 1.6cqw;
  }

  /* Shared pieces ---------------------------------------------------------- */

  .wb-glyph {
    flex: none;
    width: 1.7cqw;
    height: 1.7cqw;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wb-title {
    color: var(--foreground);
    font-weight: 700;
  }

  .wb-heading {
    margin-top: 0.4cqw;
    color: var(--muted-foreground);
    font-size: 1.15cqw;
    font-weight: 600;
  }

  .wb-mono {
    font-family: var(--font-mono);
  }

  .wb-bar {
    display: block;
    height: 0.8cqw;
    border-radius: 1cqw;
    background: color-mix(in oklab, var(--foreground) 14%, transparent);
  }

  .wb-lines {
    display: grid;
    gap: 0.5cqw;
  }

  .wb-dot {
    flex: none;
    width: 0.9cqw;
    height: 0.9cqw;
    border-radius: 50%;
    background: color-mix(in oklab, var(--foreground) 25%, transparent);
  }

  .wb-dot.is-primary {
    background: var(--primary);
  }

  .wb-dot.is-success {
    background: var(--success);
  }

  .wb-dot.is-warning {
    background: var(--warning);
  }

  .is-success {
    color: var(--success);
  }

  .is-warning {
    color: var(--warning);
  }

  .wb-brand {
    display: grid;
  }

  .wb-brand-jira {
    display: grid;
    color: #2684ff;
  }

  /* A check in a soft green disc, drawn with borders. */
  .wb-check,
  .wb-transcript :global(.is-done > .wb-status) {
    position: relative;
    flex: none;
    width: 1.4cqw;
    height: 1.4cqw;
    border-radius: 50%;
    background: color-mix(in oklab, var(--success) 22%, transparent);
  }

  .wb-check::after,
  .wb-transcript :global(.is-done > .wb-status::after) {
    content: "";
    position: absolute;
    top: 22%;
    left: 36%;
    width: 25%;
    height: 45%;
    border: solid var(--success);
    border-width: 0 0.2cqw 0.2cqw 0;
    transform: rotate(45deg);
  }

  /* Window ------------------------------------------------------------------ */

  .wb-window {
    inset: 0;
    border: 1px solid var(--hairline);
    border-radius: 1.4cqw;
    background: color-mix(in oklab, var(--card) 92%, var(--background));
    box-shadow:
      0 4cqw 8cqw -2cqw color-mix(in oklab, black 45%, transparent),
      0 0 0 1px color-mix(in oklab, var(--primary) 8%, transparent);
  }

  .wb-titlebar {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    height: 7%;
    padding-inline: 1.6cqw;
    border-bottom: 1px solid var(--hairline);
    color: var(--muted-foreground);
    font-size: 1.25cqw;
  }

  .wb-logo img {
    display: block;
    width: 1.9cqw;
    height: 1.9cqw;
  }

  .wb-tab.is-active {
    padding: 0.2cqw 0.8cqw;
    border-radius: 0.5cqw;
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    color: var(--foreground);
  }

  .wb-titlebar-end {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    margin-left: auto;
  }

  .wb-bell {
    position: relative;
    display: grid;
    color: var(--foreground);
  }

  .wb-badge {
    position: absolute;
    top: -0.7cqw;
    right: -0.9cqw;
    display: grid;
    place-items: center;
    min-width: 1.4cqw;
    height: 1.4cqw;
    padding-inline: 0.3cqw;
    border-radius: 1cqw;
    background: var(--warning);
    color: var(--background);
    font-size: 0.9cqw;
    font-weight: 700;
    transition: scale 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .wb.is-notifying .wb-badge {
    scale: 1.3;
  }

  .wb-statusbar {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    gap: 0.8cqw;
    height: 5.5%;
    padding-inline: 1.6cqw;
    border-top: 1px solid var(--hairline);
    color: var(--muted-foreground);
    font-size: 1.05cqw;
  }

  .wb-statusbar .wb-glyph {
    width: 1.2cqw;
    height: 1.2cqw;
  }

  .wb-status-end {
    display: flex;
    align-items: center;
    gap: 0.6cqw;
    margin-left: auto;
  }

  /* Panels ---------------------------------------------------------------- */

  .wb-panel {
    display: flex;
    flex-direction: column;
    gap: 1cqw;
    padding: 1.3cqw;
    border: 1px solid var(--hairline);
    border-radius: 1cqw;
    background: var(--card);
    box-shadow: 0 1.8cqw 3cqw -1.4cqw color-mix(in oklab, black 40%, transparent);
  }

  .wb-side {
    top: 9.5%;
    left: 1.2%;
    width: 22.5%;
    height: 83%;
  }

  .wb-chat {
    top: 9.5%;
    left: 25%;
    width: 47%;
    height: 83%;
  }

  .wb-dock {
    top: 9.5%;
