---
const items = [
  "Transparent execution",
  "Local-first daemon",
  "Approval gates",
  "Git & pull requests",
  "Background tasks",
  "Explore sub-agents",
  "Skills & resources",
  "History & branches",
  "Voice & images",
  "Custom providers",
];

const track = [...items, ...items];
---

<div class="marquee-band">
  <div class="marquee container-wide">
    <div class="marquee-track animate-marquee">
      {
        track.map((item, index) => (
          <span class="item" aria-hidden={index >= items.length ? "true" : undefined}>
            <span class="dot" aria-hidden="true" />
            {item}
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .marquee-band {
    padding-block: 1.25rem;
    border-block: 1px solid var(--hairline);
    background-color: color-mix(in oklab, var(--card) 45%, transparent);
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted-foreground);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .dot {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background-color: var(--primary);
  }
</style>
