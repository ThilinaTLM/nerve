---
const items=[
  ["Conversations","Branch, search, compact, import, and export durable project histories.","/guides/conversations/"],
  ["Composer","Choose authority, mode, model, and thinking level before a run.","/guides/composer/"],
  ["Git & GitHub","Review changes, branches, pull requests, and checks in the same shell.","/guides/git-and-github/"],
  ["Tasks & Explore","Supervise long-running processes and parallel read-only investigations.","/guides/tasks/"],
  ["Models","Use supported providers while keeping Nerve itself local-first.","/models/providers-and-auth/"],
  ["Desktop & browser","Use the desktop shell or connect securely from another device on your LAN.","/operations/lan-mobile/"],
];
---
<div class="nerve-map mt-14">
  <svg viewBox="0 0 1000 620" aria-hidden="true"><circle class="soma-halo" cx="500" cy="310" r="92"/><circle class="soma" cx="500" cy="310" r="42"/>{items.map((_,i)=>{const y=100+i%3*210;const x=i<3?180:820;return <path d={`M500 310 C${i<3?390:610} ${y}, ${i<3?310:690} ${y}, ${x} ${y}`}/>})}</svg>
  <div class="map-soma"><strong>Nerve</strong><span>Local workbench</span></div>
  <div class="map-items">{items.map((item,index)=><a href={item[2]} class={`map-node node-${index+1}`}><span>{String(index+1).padStart(2,"0")}</span><strong>{item[0]}</strong><p>{item[1]}</p></a>)}</div>
</div>
<style>
  .nerve-map{position:relative;min-height:38rem}.nerve-map svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.nerve-map path{fill:none;stroke:color-mix(in oklab,var(--primary) 35%,var(--border));stroke-width:1.5;stroke-dasharray:8 7}.soma-halo{fill:color-mix(in oklab,var(--primary) 8%,transparent);stroke:color-mix(in oklab,var(--primary) 20%,transparent)}.soma{fill:var(--surface-elevated);stroke:var(--primary)}
  .map-soma{position:absolute;left:50%;top:50%;display:grid;text-align:center;transform:translate(-50%,-50%);pointer-events:none}.map-soma strong{font-family:var(--font-display);font-size:var(--text-h3)}.map-soma span{color:var(--muted-foreground);font-size:var(--text-meta)}
  .map-node{position:absolute;width:min(18rem,28%);padding:1rem;border:1px solid var(--hairline);border-radius:var(--radius-xl);background:var(--glass);color:var(--foreground);text-decoration:none;backdrop-filter:blur(14px);transition:transform 240ms var(--ease-out-expo),border-color 240ms}.map-node:hover,.map-node:focus-visible{transform:translateY(-4px);border-color:var(--primary)}.map-node span{color:var(--primary);font-family:var(--font-mono);font-size:var(--text-meta)}.map-node strong{display:block;margin-top:.35rem}.map-node p{margin:.35rem 0 0;color:var(--muted-foreground);font-size:var(--text-meta);line-height:1.5}.node-1,.node-4{top:2%}.node-2,.node-5{top:36%}.node-3,.node-6{bottom:2%}.node-1,.node-2,.node-3{left:0}.node-4,.node-5,.node-6{right:0}
  @media(max-width:1023px){.nerve-map{min-height:0}.nerve-map svg,.map-soma{display:none}.map-items{display:grid;gap:1rem}.map-node{position:relative;inset:auto;width:auto}}
</style>
