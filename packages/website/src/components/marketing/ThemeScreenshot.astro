---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: "eager" | "lazy" | null;
  draggable?: boolean;
  class?: string;
}

const {
  light,
  dark,
  alt,
  widths,
  sizes,
  loading = "lazy",
  draggable,
  class: className = "",
} = Astro.props;
---

<span
  class:list={["theme-screenshot theme-screenshot-dark", className]}
  data-screenshot-theme="dark"
>
  <Image
    src={dark}
    {alt}
    {widths}
    {sizes}
    {loading}
    {draggable}
  />
</span>
<span
  class:list={["theme-screenshot theme-screenshot-light", className]}
  data-screenshot-theme="light"
>
  <Image
    src={light}
    {alt}
    {widths}
    {sizes}
    {loading}
    {draggable}
  />
</span>

<style>
  .theme-screenshot {
    display: block;
    width: 100%;
    height: 100%;
    line-height: 0;
  }

  .theme-screenshot-light {
    display: none;
  }

  :global(:root[data-theme="light"]) .theme-screenshot-dark {
    display: none;
  }

  :global(:root[data-theme="light"]) .theme-screenshot-light {
    display: block;
  }
</style>
