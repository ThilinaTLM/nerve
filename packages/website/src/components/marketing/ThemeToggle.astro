---
/* Cycles dark → light → auto. Wired by `src/scripts/theme.ts`, which shares
 * Starlight's storage key so the docs shell stays in sync. */
---

<button
  type="button"
  data-theme-toggle
  class="btn btn-ghost btn-icon"
  aria-label="Change color theme"
>
  <svg
    class="theme-icon theme-icon-dark"
    width="17"
    height="17"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
  <svg
    class="theme-icon theme-icon-light"
    width="17"
    height="17"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class="theme-icon theme-icon-auto"
    width="17"
    height="17"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M2 20h20"></path>
  </svg>
</button>

<style>
  .theme-icon {
    position: absolute;
    opacity: 0;
    transform: rotate(-35deg) scale(0.7);
    transition:
      opacity 220ms var(--ease-out-expo),
      transform 220ms var(--ease-spring);
  }

  /* `auto` is the default state before the script resolves a stored choice. */
  [data-theme-toggle] .theme-icon-auto,
  [data-theme-toggle][data-state="auto"] .theme-icon-auto,
  [data-theme-toggle][data-state="dark"] .theme-icon-dark,
  [data-theme-toggle][data-state="light"] .theme-icon-light {
    opacity: 1;
    transform: none;
  }

  [data-theme-toggle][data-state="dark"] .theme-icon-auto,
  [data-theme-toggle][data-state="light"] .theme-icon-auto {
    opacity: 0;
    transform: rotate(-35deg) scale(0.7);
  }
</style>
