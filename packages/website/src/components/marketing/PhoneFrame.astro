---
interface Props {
  caption?: string;
  class?: string;
}

const { caption, class: className = "" } = Astro.props;
---

<figure class:list={["phone-wrap", className]}>
  <div class="phone-frame">
    <span class="phone-speaker" aria-hidden="true"></span>
    <div class="phone-screen"><slot /></div>
  </div>
  {caption && <figcaption class="label-chip phone-caption">{caption}</figcaption>}
</figure>

<style>
  .phone-wrap {
    display: grid;
    justify-items: center;
    margin: 0;
  }

  .phone-frame {
    position: relative;
    width: 100%;
    padding: 0.4rem;
    border: 1px solid var(--myelin);
    /* Phones genuinely are this round, unlike the desktop frame. */
    border-radius: var(--radius-phone);
    background: var(--surface-elevated);
    /* Elevation only. The previous permanent primary glow haloed every phone. */
    box-shadow: var(--depth-2);
  }

  .phone-speaker {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    left: 50%;
    width: 18%;
    height: 0.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--background);
    transform: translateX(-50%);
  }

  .phone-screen {
    overflow: hidden;
    border-radius: var(--radius-phone-screen);
    background-color: var(--background);
    aspect-ratio: 390 / 844;
  }

  .phone-screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phone-caption {
    margin-top: 0.75rem;
  }
</style>
