---
import { Image } from "astro:assets";
import conversation from "../../assets/preview-conversation-and-pr.webp";
import Reveal from "./Reveal.astro";
import ScreenshotFrame from "./ScreenshotFrame.astro";

const steps = [
  {
    title: "Open a project.",
    body:
      "Organize conversations, files, context, notes, Git, pull requests, and tasks in one navigable shell.",
  },
  {
    title: "Choose authority.",
    body:
      "Work read-only, supervised, or autonomous, with a separate planning mode and visible review gates.",
  },
  {
    title: "Stay in the loop.",
    body:
      "Queue a correction, answer a question, inspect a diff, continue from failure, or branch from history.",
  },
  {
    title: "Use the right capability.",
    body:
      "Enable optional Web, Python, Jira, Confluence, skills, and read-only Explore sub-agents.",
  },
];
---

<div class="workflow mt-14">
  <Reveal variant="left" class="order-2 lg:order-1">
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li>
            <span class="marker">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <strong>{step.title}</strong>
              <p class="body-text mt-1">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <a class="link-arrow mt-8" href="/start/first-task/">
      Walk through a first task
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </Reveal>

  <Reveal variant="right" delay={120} class="order-1 lg:order-2">
    <ScreenshotFrame parallax={10}>
      <Image
        src={conversation}
        alt="Nerve conversation showing tool results, composer controls, and pull request checks"
        widths={[720, 1080, 1440]}
        sizes="(max-width: 1024px) 100vw, 52vw"
        loading="lazy"
      />
    </ScreenshotFrame>
  </Reveal>
</div>

<style>
  .workflow {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .workflow {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }

  .steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.4rem;
  }

  .steps li::before {
    content: "";
    position: absolute;
    left: 1.05rem;
    top: 2.6rem;
    bottom: -0.4rem;
    width: 1px;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--primary) 55%, transparent),
      transparent
    );
  }

  .steps li:last-child::before {
    display: none;
  }

  .marker {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid color-mix(in oklab, var(--primary) 35%, var(--border));
    border-radius: 999px;
    background-color: color-mix(in oklab, var(--primary) 12%, transparent);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: transform 320ms var(--ease-spring);
  }

  .steps li:hover .marker {
    transform: scale(1.08);
  }

  .steps strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
</style>
