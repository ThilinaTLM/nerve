---
/* The section after the hero: what Nerve connects to out of the box, then
 * the model providers. Marks are monochrome and take the text colour, so
 * they sit quietly in both themes. */
import BrandIcon from "./BrandIcon.astro";
import type { BrandIconName } from "./brand-icons";

interface Mark {
  icon: BrandIconName;
  label: string;
}

const integrations: Mark[] = [
  { icon: "github", label: "GitHub" },
  { icon: "jira", label: "Jira" },
  { icon: "confluence", label: "Confluence" },
  { icon: "modelcontextprotocol", label: "MCP servers" },
  { icon: "tailscale", label: "Tailscale" },
];

const models: Mark[] = [
  { icon: "anthropic", label: "Anthropic" },
  { icon: "openai", label: "OpenAI" },
  { icon: "githubcopilot", label: "GitHub Copilot" },
  { icon: "openrouter", label: "OpenRouter" },
];
---

<section class="strip" aria-labelledby="strip-title">
  <div class="container-page strip-inner">
    <h2 id="strip-title" class="strip-title">
      Your stack, <span class="gradient-text">your models.</span>
    </h2>
    <div class="strip-group">
      <p class="strip-label">Built in</p>
      <ul class="strip-marks">
        {
          integrations.map((mark) => (
            <li class="strip-mark">
              <BrandIcon name={mark.icon} size={24} />
              <span>{mark.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="strip-group">
      <p class="strip-label">Your models</p>
      <ul class="strip-marks">
        {
          models.map((mark) => (
            <li class="strip-mark">
              <BrandIcon name={mark.icon} size={24} />
              <span>{mark.label}</span>
            </li>
          ))
        }
        <li class="strip-mark strip-more">+ any OpenAI-compatible API</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .strip {
    position: relative;
    padding-block: clamp(4rem, 9vw, 7rem);
    border-block: 1px solid var(--hairline);
    background: var(--surface-sunken);
  }

  .strip-inner {
    display: grid;
    justify-items: center;
    gap: clamp(1.75rem, 3vw, 2.5rem);
    text-align: center;
  }

  .strip-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.3rem + 2vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .strip-group {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .strip-label {
    margin: 0;
    color: var(--primary);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .strip-marks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .strip-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted-foreground);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    font-weight: 600;
    transition: color 160ms ease;
  }

  .strip-mark:hover {
    color: var(--foreground);
  }

  .strip-more {
    font-size: 0.9rem;
    font-weight: 400;
  }
</style>
