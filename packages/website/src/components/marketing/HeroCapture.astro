---
/* The hero picture: the real `forge-build` capture, spotlit.
 *
 * Nothing here is mocked. The capture shows a Forge conversation that built an
 * extension, with its Environments panel docked on the right. A vector
 * overlay dims the rest of the workbench (still visible: conversations,
 * status bar, the whole window) and cuts two holes: the conversation with
 * the Forge profile in the composer, and the panel Forge built. Two labels
 * name them and a signal travels between the holes.
 *
 * Crispness: the capture is 1440×900 CSS px at 2x. It is shown at native
 * size where the viewport allows, re-encoded at quality 100, loaded eagerly
 * at high priority, and never scaled or rotated (the overlay is SVG on top,
 * so the pixels are never resampled by an effect).
 *
 * Hole and label coordinates are in capture CSS px (viewBox 1440×900); move
 * them with the capture if the scene changes.
 */
import DeviceFrame from "./DeviceFrame.astro";
import ThemeScreenshot from "./ThemeScreenshot.astro";
import forgeDark from "../../assets/screenshots/desktop/forge-build-dark.webp";
import forgeLight from "../../assets/screenshots/desktop/forge-build-light.webp";

const holes = {
  chat: { x: 286, y: 348, w: 790, h: 520, r: 14 },
  dock: { x: 1096, y: 80, w: 344, h: 362, r: 12 },
};

const pct = (value: number, of: number) => `${((value / of) * 100).toFixed(2)}%`;

/* From the chat hole's right edge, across the gutter, into the panel. */
const signal = "M1076 600 C 1088 600, 1084 300, 1100 300";
---

<figure class="capture">
  <DeviceFrame label="nerve · aurora" depth={3}>
    <div class="capture-stage">
      <ThemeScreenshot
        light={forgeLight}
        dark={forgeDark}
        alt="Nerve with the Forge profile: the conversation where Forge built and loaded an extension, and the Environments panel it added, docked on the right, showing QA as degraded and Production as healthy with their versions and recent deploys."
        widths={[1440, 2160, 2880]}
        sizes="(min-width: 1520px) 1440px, calc(100vw - 2rem)"
        quality={100}
        loading="eager"
        fetchpriority="high"
      />

      <svg
        class="capture-overlay"
        viewBox="0 0 1440 900"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <mask id="capture-spot" maskUnits="userSpaceOnUse">
            <rect width="1440" height="900" fill="white"></rect>
            {
              Object.values(holes).map((hole) => (
                <rect
                  x={hole.x}
                  y={hole.y}
                  width={hole.w}
                  height={hole.h}
                  rx={hole.r}
                  fill="black"
                />
              ))
            }
          </mask>
        </defs>
        <rect class="capture-dim" width="1440" height="900" mask="url(#capture-spot)"></rect>
        {
          Object.values(holes).map((hole) => (
            <rect
              class="capture-ring"
              x={hole.x}
              y={hole.y}
              width={hole.w}
              height={hole.h}
              rx={hole.r}
              pathLength="1"
            />
          ))
        }
        <path class="capture-wire" d={signal}></path>
        <path class="capture-impulse" d={signal} pathLength="1"></path>
      </svg>

      <span
        class="capture-label"
        style={`left:${pct(holes.chat.x, 1440)};top:${pct(holes.chat.y, 900)}`}
        aria-hidden="true"
      >
        <b>1</b>Forge builds it in your conversation
      </span>
      <span
        class="capture-label"
        style={`left:${pct(holes.dock.x + 12, 1440)};top:${pct(holes.dock.y + holes.dock.h + 18, 900)}`}
        aria-hidden="true"
      >
        <b>2</b>The new panel, live in your workbench
      </span>
    </div>
  </DeviceFrame>
</figure>

<style>
  .capture {
    margin: 0;
  }

  .capture-stage {
    position: relative;
    line-height: 0;
  }

  .capture-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .capture-dim {
    fill: color-mix(in oklab, var(--background) 58%, transparent);
  }

  .capture-ring {
    fill: none;
    stroke: var(--primary);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 10px color-mix(in oklab, var(--primary) 55%, transparent));
  }

  .capture-wire {
    fill: none;
    stroke: color-mix(in oklab, var(--primary) 55%, transparent);
    stroke-width: 2;
    stroke-dasharray: 5 6;
    vector-effect: non-scaling-stroke;
  }

  .capture-impulse {
    fill: none;
    stroke: var(--primary);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 0.18 2;
    stroke-dashoffset: 0.18;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 6px var(--primary));
    animation: capture-impulse 2.4s ease-in-out infinite;
  }

  /* Labels sit just outside their hole, in the dimmed area. */
  .capture-label {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem 0.4rem 0.4rem;
    border: 1px solid var(--myelin);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--card) 92%, transparent);
    box-shadow: var(--depth-2);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    transform: translateY(calc(-100% - 0.6rem));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .capture-label + .capture-label {
    transform: none;
  }

  .capture-label b {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: var(--radius-pill);
    background: var(--primary);
    color: var(--primary-foreground);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  @media (max-width: 860px) {
    .capture-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capture-impulse {
      display: none;
    }
  }
</style>
