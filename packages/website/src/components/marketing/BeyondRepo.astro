---
/* Beyond the repo: one quick_script call reaching Jira, Confluence, the web,
 * and local files, with each SDK call listed as it is checked. Static markup in
 * the transcript idiom (see RunPanel); illustrative, not a live capture. */
import Reveal from "./Reveal.astro";

interface Call {
  op: string;
  target: string;
  risk: "external_read" | "external_write" | "read";
}

const calls: Call[] = [
  { op: "jira.issues.search", target: "jira:project/APP", risk: "external_read" },
  { op: "web.fetch", target: "https://docs.example.com/changelog", risk: "external_read" },
  { op: "files.read", target: "release-notes.md", risk: "read" },
  { op: "confluence.pages.update", target: "confluence:page/123", risk: "external_write" },
];

const riskLabel = {
  external_read: "external read",
  external_write: "external write",
  read: "read",
} as const;

const namespaces = ["Jira", "Confluence", "Web", "Files", "Diagrams", "Images"];
const libraries = ["XLSX", "Papa", "docx", "PptxGenJS", "JSZip"];
---

<div class="br grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-center">
  <Reveal>
    <figure
      class="br-card"
      aria-label="Illustrative quick_script tool card listing four SDK calls and the risk each is checked as"
    >
      <figcaption class="br-head">
        <span class="br-tool">quick_script</span>
        <span class="br-arg">Summarize APP sprint into the release page</span>
      </figcaption>
      <ol class="br-calls">
        {
          calls.map((call) => (
            <li class="br-call" data-risk={call.risk}>
              <code class="br-op">{call.op}</code>
              <span class="br-target">{call.target}</span>
              <span class="br-risk">{riskLabel[call.risk]}</span>
              <span class="br-check">checked</span>
            </li>
          ))
        }
      </ol>
      <p class="br-foot">
        One script. Each call is checked against your permission rules as it
        runs, and appears here as it happens.
      </p>
    </figure>
  </Reveal>

  <Reveal delay={120}>
    <div class="grid gap-6">
      <article class="grid content-start gap-2">
        <h3 class="card-title">One script instead of ten round trips.</h3>
        <p class="body-text">
          <code>quick_script</code> runs TypeScript in a sandbox with no
          filesystem, network or timers of its own. Everything it touches goes
          through the SDK, so batching never widens what your rules allow.{" "}
          <a class="text-primary" href="/guides/quick-script/">Learn Quick script →</a>
        </p>
        <ul class="br-chips" aria-label="SDK namespaces">
          {namespaces.map((name) => <li>{name}</li>)}
        </ul>
        <ul class="br-chips" aria-label="Document libraries">
          {libraries.map((name) => <li>{name}</li>)}
        </ul>
      </article>
      <article class="grid content-start gap-2">
        <h3 class="card-title">Extensions you switch on.</h3>
        <p class="body-text">
          Atlassian, Web Search, Diagrams, Image generation and Image
          explanation live under Settings → Extensions, each with its own
          switch and accounts. Permission rule sets treat external reads and
          external writes as separate risks, and Read-only allows the reads.{" "}
          <a class="text-primary" href="/integrations/extensions/">Explore extensions →</a>
        </p>
      </article>
      <article class="grid content-start gap-2">
        <h3 class="card-title">Know what your subscription has left.</h3>
        <p class="body-text">
          Usage for Anthropic, OpenAI Codex and GitHub Copilot subscriptions
          shows used and remaining quota, including the Copilot monthly
          allowance.{" "}
          <a class="text-primary" href="/models/usage/">How usage works →</a>
        </p>
      </article>
    </div>
  </Reveal>
</div>

<style>
  .br-card {
    margin: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background-color: var(--card);
    box-shadow: var(--shadow-card, none);
    overflow: hidden;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
  }

  .br-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--hairline);
    background-color: var(--surface-elevated);
  }

  .br-tool {
    color: var(--foreground);
    font-weight: 600;
  }

  .br-arg {
    color: var(--muted-foreground);
  }

  .br-calls {
    display: grid;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
  }

  .br-call {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0.15rem 0.75rem;
    padding: 0.5rem 0.5rem;
    border-radius: var(--radius-sm, 0.375rem);
  }

  .br-op {
    color: var(--foreground);
    grid-column: 1;
  }

  .br-target {
    grid-column: 1;
    color: var(--muted-foreground);
    overflow-wrap: anywhere;
  }

  .br-risk {
    grid-column: 2;
    grid-row: 1;
    color: var(--muted-foreground);
  }

  .br-check {
    grid-column: 3;
    grid-row: 1;
    color: var(--success);
  }

  .br-call[data-risk="external_write"] .br-risk {
    color: var(--warning);
  }

  .br-foot {
    margin: 0;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--hairline);
    color: var(--muted-foreground);
    font-family: var(--font-sans, inherit);
    font-size: 0.8125rem;
  }

  .br-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .br-chips li {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }
</style>
