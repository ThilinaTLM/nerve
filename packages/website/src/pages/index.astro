---
import overview from "../assets/preview-workbench-overview.webp";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import BentoFeatures from "../components/marketing/BentoFeatures.astro";
import CapabilityGrid from "../components/marketing/CapabilityGrid.astro";
import ClosingCta from "../components/marketing/ClosingCta.astro";
import Hero from "../components/marketing/Hero.astro";
import Marquee from "../components/marketing/Marquee.astro";
import Section from "../components/marketing/Section.astro";
import Topology from "../components/marketing/Topology.astro";
import TranscriptDemo from "../components/marketing/TranscriptDemo.astro";
import WorkflowSteps from "../components/marketing/WorkflowSteps.astro";

const title = "Nerve — transparent, local-first coding harness";
const description =
  "See the agent work, control its authority, and manage coding workflows from an open-source desktop workbench that runs with your local projects.";
const ogImage = new URL(overview.src, Astro.site).href;
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://nerve.tlmtech.dev/"
  ogImage={ogImage}
  structuredData
>
  <Hero />

  <Marquee />

  <Section
    id="capabilities-overview"
    eyebrow="Built for understandable agency"
    title="A focused agent inside a real project workbench"
    lede="Every run is legible: what the agent is thinking, which tools it calls, what it changed, and where it needs you."
    rule={false}
  >
    <BentoFeatures />
  </Section>

  <Section
    id="transparency"
    eyebrow="Nothing happens off-screen"
    title="Watch the run, not a spinner"
    lede="The transcript renders prompts, reasoning, tool calls, results, approvals, and recovery as separate, inspectable events."
    align="center"
  >
    <TranscriptDemo />
  </Section>

  <Section
    id="workflow"
    eyebrow="One continuous workflow"
    title="Direct the agent. Review the evidence. Ship deliberately."
  >
    <WorkflowSteps />
  </Section>

  <Section
    id="capabilities"
    eyebrow="More than a chat window"
    title="The everyday mechanics are already here"
  >
    <CapabilityGrid />
  </Section>

  <Section
    id="topology"
    eyebrow="Local-first topology"
    title="Your workbench talks to your daemon, not a hosted Nerve service."
  >
    <Topology />
  </Section>

  <ClosingCta />
</MarketingLayout>
