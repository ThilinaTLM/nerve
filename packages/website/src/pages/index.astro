---
import socialPreview from "../assets/social-preview.png";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import ClosingCta from "../components/marketing/ClosingCta.astro";
import Hero from "../components/marketing/Hero.astro";
import LiveRun from "../components/marketing/LiveRun.astro";
import ParallelTeam from "../components/marketing/ParallelTeam.astro";
import Section from "../components/marketing/Section.astro";
import TokenLedger from "../components/marketing/TokenLedger.astro";
import WorkbenchMap from "../components/marketing/WorkbenchMap.astro";

/* Six beats, one argument: a lean harness (hero, ledger), a transcript you can
 * see through and steer (live run), the workbench around it, parallel work,
 * and the install. Everything else lives in the docs. */
const title = "Nerve — more work per token, more control per run";
const description =
  "Free, open-source coding workbench for AI agents. A lean harness, parallel teammates, Git and PR review, an integrated prompt composer, and visible background work — on your subscription or API key.";
const ogImage = new URL(socialPreview.src, Astro.site).href;
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://nerve.tlmtech.dev/"
  ogImage={ogImage}
  structuredData
>
  <Hero />

  <Section
    id="lean"
    tone="sunken"
    eyebrow="Lean by design"
    title="Your tokens go to your problem."
    lede="A concise base prompt, tools selected for the run, and bounded output keep context focused. Project guidance and skills add what the work needs; full tool output stays available for inspection."
  >
    <TokenLedger />
  </Section>

  <Section
    id="run"
    eyebrow="Transparent by default"
    title="Watch every step. Steer without stopping."
    lede="Follow streaming text and tool cards that fill in place, from draft arguments to approval and results. Queue a follow-up, change the next request's settings, or branch from an earlier entry."
  >
    <LiveRun />
  </Section>

  <Section
    id="workbench"
    tone="sunken"
    eyebrow="The whole loop, one window"
    title="From prompt to pull request without leaving."
    lede="Review staged and unstaged changes, see the current branch's PR, and check review status without losing the conversation. Background Git operations report progress and failures in the header's Activity popover."
  >
    <WorkbenchMap />
    <div class="grid gap-8 md:grid-cols-3">
      <article class="grid content-start gap-3">
        <h3 class="card-title">Less friction between thought and prompt.</h3>
        <p class="body-text">
          Reference files, paste images, insert path chips, and find commands in
          grouped suggestions. Model and permission controls share one toolbar. Agent
          questions get individual answer fields with completion, dictation, and
          saved drafts.
          <a class="text-primary" href="/guides/composer/">Explore the composer →</a>
        </p>
      </article>
      <article class="grid content-start gap-3">
        <h3 class="card-title">Background work, foreground feedback.</h3>
        <p class="body-text">
          The header’s Activity popover puts requests that need you first,
          followed by running work and finished results. Inspect Git failures,
          retry supported operations, or return to the conversation that needs
          your attention.
          <a class="text-primary" href="/guides/workbench/">Find your way around →</a>
        </p>
      </article>
      <article class="grid content-start gap-3">
        <h3 class="card-title">Less waiting around the work.</h3>
        <p class="body-text">
          Rust-backed search matches and ranks completion suggestions, including
          project paths. Single-pass storage accounting and leaner startup
          recovery reduce housekeeping around your next session.
          <a class="text-primary" href="/developers/architecture/">See the architecture →</a>
        </p>
      </article>
    </div>
  </Section>

  <Section
    id="parallel"
    eyebrow="Parallel by nature"
    title="Many projects. A team of agents. All at once."
    lede="Every conversation is its own tab in its own project. Inside one, a lead agent hands work to sub-agents you shape — and they report back with receipts."
  >
    <ParallelTeam />
  </Section>

  <ClosingCta />
</MarketingLayout>
