---
import socialPreview from "../assets/social-preview.png";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import AnywhereSection from "../components/marketing/AnywhereSection.astro";
import AskMarquee from "../components/marketing/AskMarquee.astro";
import ClosingCta from "../components/marketing/ClosingCta.astro";
import Hero from "../components/marketing/Hero.astro";
import IntegrationOrbit from "../components/marketing/IntegrationOrbit.astro";
import IntegrationStrip from "../components/marketing/IntegrationStrip.astro";
import PromiseRow from "../components/marketing/PromiseRow.astro";
import Section from "../components/marketing/Section.astro";
import TaskJourney from "../components/marketing/TaskJourney.astro";
import WorkbenchHotspots from "../components/marketing/WorkbenchHotspots.astro";

/* Glance first, read second. Each section is one picture and one headline,
 * and every section uses a different shape (bento, moving rows, orbit,
 * annotated capture, floating phone) so the page never repeats itself. The
 * detail lives in the docs. */
const title =
  "Nerve — the AI coding workbench that builds itself around your project";
const description =
  "Free, open-source workbench for AI coding agents. Ask the Forge profile for a panel, a launch or a Jira workflow and it builds the extension. Jira, Confluence, MCP and GitHub built in; parallel agents; Git and PR review; your phone through Tailscale. On your subscription or API key.";
const ogImage = new URL(socialPreview.src, Astro.site).href;
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://nerve.tlmtech.dev/"
  ogImage={ogImage}
  structuredData
>
  <Hero />
  <IntegrationStrip />

  <Section
    id="capabilities"
    align="center"
    eyebrow="How it works"
    title="One task, start to finish."
  >
    <TaskJourney />
  </Section>

  <Section
    id="forge"
    tone="sunken"
    align="center"
    eyebrow="Make it yours"
    title="Just ask."
    lede="Tell Forge what your project needs. It builds it into your workbench."
  >
    <AskMarquee />
  </Section>

  <Section
    id="connect"
    align="center"
    eyebrow="Connect"
    title="Plugged into your stack."
  >
    <IntegrationOrbit />
  </Section>

  <Section
    id="workbench"
    tone="sunken"
    align="center"
    eyebrow="The workbench"
    title="Everything around the chat."
  >
    <WorkbenchHotspots />
  </Section>

  <Section
    id="anywhere"
    align="center"
    eyebrow="Anywhere"
    title="Step away. Stay in the loop."
  >
    <AnywhereSection />
  </Section>

  <PromiseRow />
  <ClosingCta />
</MarketingLayout>
