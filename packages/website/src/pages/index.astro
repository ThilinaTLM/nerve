---
import heroImage from "../assets/shots/d1-conversation.webp";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import ClosingCta from "../components/marketing/ClosingCta.astro";
import DefaultsGrid from "../components/marketing/DefaultsGrid.astro";
import EventAnatomy from "../components/marketing/EventAnatomy.astro";
import Hero from "../components/marketing/Hero.astro";
import HotSwapLab from "../components/marketing/HotSwapLab.astro";
import LeanHarness from "../components/marketing/LeanHarness.astro";
import AuthorityDial from "../components/marketing/AuthorityDial.astro";
import PocketWorkbench from "../components/marketing/PocketWorkbench.astro";
import RepoConstellation from "../components/marketing/RepoConstellation.astro";
import Section from "../components/marketing/Section.astro";
import SignalStrip from "../components/marketing/SignalStrip.astro";
import WorkbenchTour from "../components/marketing/WorkbenchTour.astro";

const title = "Nerve — see everything, steer it live";
const description =
  "An open-source, local-first coding harness where every agent event is inspectable and a running agent can be retuned mid-run — model, mode, and authority included.";
const ogImage = new URL(heroImage.src, Astro.site).href;
---

<MarketingLayout
  title={title}
  description={description}
  canonical="https://nerve.tlmtech.dev/"
  ogImage={ogImage}
  structuredData
>
  <Hero />

  <SignalStrip />

  <Section
    id="hotswap"
    eyebrow="Retune the run while it runs"
    title="Change the model mid-thought."
    lede="Model, thinking level, agent mode, permission — change any of them on an active conversation and it applies from the next provider request. The controls below are wired to the stream."
  >
    <HotSwapLab />
  </Section>

  <Section
    id="anatomy"
    tone="sunken"
    eyebrow="Nothing happens off-screen"
    title="A run is not a spinner. It's a stack of typed events."
    lede="Prompts, reasoning, tool calls, results, approvals, and recovery are separate events. Each keeps its evidence, and all of it stays in history."
  >
    <EventAnatomy />
  </Section>

  <Section
    id="authority"
    eyebrow="Authority, not vibes"
    title="Decide what the agent may do — before it does it."
    lede="Nerve enforces permission in the harness policy layer, not just in the system prompt. Change the level and the tool policy changes with it."
  >
    <AuthorityDial />
  </Section>

  <Section
    id="lean"
    tone="sunken"
    align="center"
    eyebrow="The harness stays out of the way"
    title="Your model, at full intelligence."
    lede="No walls of instructions wrapping every request. A concise base prompt, a small polished tool surface, and constraints enforced in the policy layer — so the model's capability reaches your code intact."
  >
    <LeanHarness />
  </Section>

  <Section
    id="fullstack"
    eyebrow="One workbench, your whole stack"
    title="Open the parent directory. Work across every repo."
    lede="Point Nerve at the workspace that holds your API, web app, and mobile app. It discovers the repositories beneath it and keeps Git, diffs, and pull requests for all of them in one shell."
  >
    <RepoConstellation />
  </Section>

  <Section
    id="workbench"
    tone="sunken"
    eyebrow="The workbench is the interface"
    title="Follow the signal from intent to merge"
    lede="Real project context stays connected across the conversation, Git, pull requests, and supervised tasks."
  >
    <WorkbenchTour />
  </Section>

  <Section
    id="defaults"
    eyebrow="Tuned defaults, visible seams"
    title="When it breaks, you keep the work."
    lede="Provider failures, context limits, and wrong turns are expected states in Nerve — handled by defaults you can see and change, never by dead ends."
  >
    <DefaultsGrid />
  </Section>

  <Section
    id="mobile"
    tone="sunken"
    eyebrow="Wherever the daemon is reachable"
    title="A workbench that adapts, not a desktop squeezed onto a phone"
  >
    <PocketWorkbench />
  </Section>

  <ClosingCta />
</MarketingLayout>
