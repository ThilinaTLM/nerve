{
  "name": "@nervekit/quick-script",
  "version": "0.40.2",
  "private": true,
  "description": "quick_script tool, runtime, extension registry and built-in extensions (Atlassian, web, diagram, image generation).",
  "author": "ThilinaTLM",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThilinaTLM/nerve.git",
    "directory": "packages/quick-script"
  },
  "homepage": "https://github.com/ThilinaTLM/nerve#readme",
  "files": [
    "dist/**",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && tsx ../../scripts/build/copy-quick-script-assets.ts",
    "check": "tsc -b --pretty false",
    "pretest": "tsx ../../scripts/build/copy-quick-script-assets.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@nervekit/contracts": "workspace:*",
    "@nervekit/native": "workspace:*",
    "@nervekit/tools": "workspace:*",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "docx": "9.15.3",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "papaparse": "5.5.3",
    "pptxgenjs": "4.0.1",
    "typescript": "5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
