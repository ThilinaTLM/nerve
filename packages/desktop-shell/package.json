{
  "name": "@nervekit/desktop-shell",
  "version": "0.40.2",
  "private": true,
  "description": "Electron launcher and desktop bridge shell for Nerve.",
  "author": "ThilinaTLM",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThilinaTLM/nerve.git",
    "directory": "packages/desktop-shell"
  },
  "homepage": "https://github.com/ThilinaTLM/nerve#readme",
  "desktopName": "io.github.thilinatlm.nerve.desktop",
  "main": "dist/main.js",
  "bin": {
    "nerve-desktop": "./dist/bin.js"
  },
  "files": [
    "dist/**",
    "build/**",
    "package.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "icons": "tsx ../../scripts/build/generate-brand-assets.ts --desktop",
    "build": "pnpm run icons && tsc -b && tsx scripts/copy-preload.ts",
    "check": "tsc -b --pretty false",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "start": "node scripts/start-electron.ts",
    "dev": "tsx scripts/dev-desktop.ts",
    "dev:prod": "pnpm -w build:native && pnpm -w build:workbench-runtime && pnpm --filter @nervekit/desktop-shell build && node scripts/start-electron.ts"
  },
  "dependencies": {
    "@nervekit/contracts": "workspace:*",
    "@nervekit/workbench-server": "workspace:*"
  },
  "peerDependencies": {
    "electron": "^45.2.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "^45.2.1",
    "esbuild": "0.28.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
