{
  "name": "@nervekit/contracts",
  "version": "0.26.0",
  "private": true,
  "description": "Transport-neutral schemas, events, policies, and result contracts.",
  "author": "ThilinaTLM",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThilinaTLM/nerve.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/ThilinaTLM/nerve#readme",
  "files": [
    "dist/**",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "import": "./dist/wire/index.js"
    },
    "./operations": {
      "types": "./dist/operations/index.d.ts",
      "import": "./dist/operations/index.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots/index.d.ts",
      "import": "./dist/snapshots/index.js"
    },
    "./*": {
      "types": "./dist/domains/*/index.d.ts",
      "import": "./dist/domains/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
