{
  "name": "@nervekit/workbench-server",
  "version": "0.40.2",
  "private": true,
  "author": "ThilinaTLM",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThilinaTLM/nerve.git",
    "directory": "packages/workbench-server"
  },
  "homepage": "https://github.com/ThilinaTLM/nerve#readme",
  "files": [
    "dist/**",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./network": {
      "types": "./dist/infrastructure/network/index.d.ts",
      "import": "./dist/infrastructure/network/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "dev": "tsx src/main.ts",
    "test": "tsx --test --test-concurrency=1 \"test/**/*.test.ts\" \"src/{adapters,app,core-host,domains}/**/*.test.ts\" \"src/infrastructure/{configuration,events,storage-bootstrap}/**/*.test.ts\" \"src/infrastructure/process-host/!(port-inspector).test.ts\"",
    "test:migrations": "tsx --test --test-concurrency=1 \"src/infrastructure/migrations/**/*.test.ts\" \"test/infrastructure/persistence/*.test.ts\"",
    "test:native": "tsx --test test/infrastructure/persistence/file-mutations.test.ts test/domains/launches/process-runtime-driver.test.ts src/infrastructure/process-host/port-inspector.test.ts test/domains/launches/launch-scope.test.ts test/domains/launches/launch-supervisor.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.1",
    "@hono/node-server": "2.1.5",
    "@nervekit/contracts": "workspace:*",
    "@nervekit/conversation-core": "workspace:*",
    "@nervekit/harness": "workspace:*",
    "@nervekit/native": "workspace:*",
    "@nervekit/protocol": "workspace:*",
    "@nervekit/skills": "workspace:*",
    "@nervekit/tools": "workspace:*",
    "@peculiar/x509": "^2.2.0",
    "@simplewebauthn/server": "^14.0.3",
    "fdir": "6.5.0",
    "hono": "4.13.16",
    "parse5": "8.0.0",
    "reflect-metadata": "^0.2.2",
    "ws": "8.21.0",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
