{
  "name": "@nervekit/ui-kit",
  "version": "0.26.0",
  "description": "Contract-free Nerve UI primitives, renderers, utilities, and theme styles.",
  "private": true,
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "exports": {
    ".": "./src/lib/index.ts",
    "./styles/app.css": "./src/styles/app.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/animation.css": "./src/styles/animation.css",
    "./styles/components.css": "./src/styles/components.css",
    "./utils": "./src/lib/utils.ts",
    "./browser/*": "./src/lib/browser/*.ts",
    "./collections/*": "./src/lib/collections/*.ts",
    "./display/*": "./src/lib/display/*.ts",
    "./highlighting/*": "./src/lib/highlighting/*.ts",
    "./renderers/markdown/Markdown.svelte": "./src/lib/renderers/markdown/Markdown.svelte",
    "./renderers/markdown/markdown-render": "./src/lib/renderers/markdown/markdown-render.ts",
    "./renderers/markdown/streaming-markdown": "./src/lib/renderers/markdown/streaming-markdown.ts",
    "./renderers/mermaid/MermaidDiagram.svelte": "./src/lib/renderers/mermaid/MermaidDiagram.svelte",
    "./renderers/mermaid/mermaid-blocks": "./src/lib/renderers/mermaid/mermaid-blocks.ts",
    "./renderers/plain-text/PlainText.svelte": "./src/lib/renderers/plain-text/PlainText.svelte",
    "./scheduling/*": "./src/lib/scheduling/*.ts",
    "./terminal/*": "./src/lib/terminal/*.ts",
    "./components/ui/*": "./src/lib/components/ui/*/index.ts",
    "./components/composites/*": "./src/lib/components/composites/*/index.ts"
  },
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource/iosevka": "^5.2.5",
    "@fontsource/outfit": "^5.2.6",
    "@lucide/svelte": "^1.24.0",
    "@shikijs/core": "^4.1.0",
    "@shikijs/engine-javascript": "^4.1.0",
    "@shikijs/langs": "^4.1.0",
    "@shikijs/themes": "^4.1.0",
    "@tanstack/svelte-virtual": "^3.13.29",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.13",
    "mermaid": "11.16.1",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn-svelte": "^1.4.1",
    "svelte": "5.56.3",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "svelte-check": "4.3.3",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
