{
  "name": "@nervekit/extension-sdk",
  "version": "0.42.0",
  "description": "SDK and build tooling (`nerve-ext`) for Nerve extensions.",
  "author": "ThilinaTLM",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThilinaTLM/nerve.git",
    "directory": "packages/extension-sdk"
  },
  "homepage": "https://github.com/ThilinaTLM/nerve#readme",
  "bin": {
    "nerve-ext": "./bin/nerve-ext.js"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "env.d.ts",
    "templates",
    "examples",
    "README.md",
    "UPGRADING.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./env": {
      "types": "./env.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm prepare:declarations && tsc -b && node scripts/bundle.mjs",
    "check": "pnpm prepare:declarations && tsc -b --pretty false",
    "prepare:declarations": "node scripts/components-dts.ts",
    "prepack": "node ../../scripts/release/copy-license.mjs",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "e2e": "tsx scripts/e2e-npm.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.24.0",
    "@nervekit/extension-api": "workspace:*",
    "@nervekit/ui-kit": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "esbuild": "0.28.1",
    "jsdom": "30.1.3",
    "paneforge": "^1.0.2",
    "shadcn-svelte": "^1.4.1",
    "svelte": "5.57.3",
    "svelte-check": "4.3.3",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nervekit/contracts": "workspace:*",
    "@types/node": "24.10.1",
    "svelte2tsx": "0.7.63",
    "tsx": "4.22.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
