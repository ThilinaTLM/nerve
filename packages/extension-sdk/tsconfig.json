{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "rootDirs": ["src", "dist"],
    "outDir": "dist",
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/components/components.impl.ts"]
}
