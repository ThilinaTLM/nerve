{
  "name": "@nervekit/tools",
  "version": "0.40.2",
  "private": true,
  "description": "Canonical agent tool catalog, executors, and host runtime contracts.",
  "author": "ThilinaTLM",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThilinaTLM/nerve.git",
    "directory": "packages/tools"
  },
  "homepage": "https://github.com/ThilinaTLM/nerve#readme",
  "files": [
    "dist/**",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./result-projection": {
      "types": "./dist/result-projection/index.d.ts",
      "import": "./dist/result-projection/index.js"
    },
    "./git": {
      "types": "./dist/git/index.d.ts",
      "import": "./dist/git/index.js"
    },
    "./execution": {
      "types": "./dist/execution/index.d.ts",
      "import": "./dist/execution/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && tsx ../../scripts/build/copy-tools-assets.ts",
    "check": "tsc -b --pretty false",
    "pretest": "tsx ../../scripts/build/copy-tools-assets.ts",
    "test": "tsx --test \"test/**/*.test.ts\" \"src/**/*.test.ts\"",
    "test:native": "tsx --test test/execution/bash.test.ts test/execution/process-tree.test.ts"
  },
  "dependencies": {
    "@nervekit/contracts": "workspace:*",
    "@nervekit/native": "workspace:*",
    "@nervekit/skills": "workspace:*",
    "cross-spawn": "7.0.6",
    "diff": "^8.0.4",
    "node-html-markdown": "^2.0.0",
    "shell-quote": "^1.11.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.10.1",
    "@types/shell-quote": "^1.7.5",
    "docx": "9.15.3",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "papaparse": "5.5.3",
    "pptxgenjs": "4.0.1",
    "typescript": "5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
