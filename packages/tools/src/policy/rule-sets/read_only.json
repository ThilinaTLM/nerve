{
  "schemaVersion": 1,
  "id": "read_only",
  "name": "Read only",
  "description": "Allow interaction, local inspection, and Explore; deny all other capabilities.",
  "source": "builtin",
  "enabled": true,
  "compatibleModes": ["coding"],
  "rules": [
    {
      "id": "allow-interaction",
      "enabled": true,
      "priority": 200,
      "enforcement": "overridable",
      "when": { "baseRisks": ["interaction"] },
      "decision": "allow"
    },
    {
      "id": "allow-explore",
      "enabled": true,
      "priority": 150,
      "enforcement": "overridable",
      "when": { "toolNames": ["explore"] },
      "decision": "allow"
    },
    {
      "id": "allow-read",
      "enabled": true,
      "priority": 100,
      "enforcement": "overridable",
      "when": { "baseRisks": ["read"] },
      "decision": "allow"
    },
    {
      "id": "deny-everything-else",
      "enabled": true,
      "priority": 0,
      "enforcement": "overridable",
      "when": {},
      "decision": "deny"
    }
  ]
}
