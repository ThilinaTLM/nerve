{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{mjs,ts}", "tests/**/*.ts"],
      "project": ["scripts/**/*.{mjs,ts}", "tests/**/*.ts"],
    },
    "packages/*": {
      "entry": ["{test,src}/**/*.test.ts"],
    },
    "packages/desktop-shell": {
      "entry": ["src/preload.cjs", "{test,src}/**/*.test.ts"],
    },
    "packages/workbench-server": {
      // The doccheck script is shipped in the engineering-docs skill and invoked by the agent, not imported.
      // The configure-nerve scripts are run by the agent.
      "entry": [
        "scripts/**/*.ts",
        "{test,src}/**/*.test.ts",
        "src/builtin-skills/builtin/engineering-docs/scripts/doccheck.mjs",
        "src/builtin-skills/builtin/configure-nerve/scripts/*.mjs",
      ],
    },
    "packages/website": {
      "entry": ["scripts/**/*.ts"],
    },
    "packages/tools": {
      // Spawned as a worker by path string in git-isolated-reader.ts.
      // The extension sandbox runtime is bundled into an asset, not imported.
      "entry": [
        "{test,src}/**/*.test.ts",
        "src/git/read/git-isolated-reader-helper.ts",
        "src/extension-host/sandbox-runtime/extension-runtime.ts",
      ],
      // Types for shell-quote are consumed implicitly by tsc, not by an import.
      // Sandbox libraries are copied as assets by scripts/build/copy-quick-script-assets.ts, not imported.
      "ignoreDependencies": [
        "@types/shell-quote",
        "docx",
        "jszip",
        "mammoth",
        "papaparse",
        "pptxgenjs",
        "xlsx",
      ],
    },
    "packages/ui-kit": {
      "entry": ["{test,src}/**/*.test.ts"],
      // Type sidecar for theme-resolver.mjs, picked up by TypeScript only.
      "ignore": ["src/styles/theme-resolver.d.mts"],
    },
    "packages/workbench-app": {
      "entry": ["{test,src}/**/*.test.ts"],
      // Fixture modules are consumed via `import * as fx` in Svelte (namespace members).
      "ignore": ["src/lib/app/design-lab/sections/tool-card-*fixtures.ts"],
      // Resolved by @tailwindcss/vite (peer); kept explicit in the app.
      "ignoreDependencies": ["tailwindcss"],
    },
    "packages/extension-sdk": {
      // Public entries are listed from src so results do not depend on a built dist/.
      // assets/ are copied into extension projects (frame.css, vitest config), not imported;
      // templates/ are the files `nerve-ext init` copies into new projects.
      "entry": [
        "scripts/*.{ts,mjs}",
        "test/**/*.test.ts",
        "src/{index,build,testing,ui,cli,tools}.ts",
        "assets/frame.css",
        "assets/vitest.config.mjs",
      ],
      "ignore": ["templates/**"],
      // zod: imported by the inlined contracts schema in dist/. shadcn-svelte, tw-animate-css, tailwindcss: imported by
      // ui-kit's app.css, which the generated Vite/Tailwind build resolves from this package.
      "ignoreDependencies": [
        "zod",
        "shadcn-svelte",
        "tw-animate-css",
        "tailwindcss",
      ],
    },
    "packages/extensions": {
      // Bundled into a browser asset by the build, not imported.
      "entry": ["{test,src}/**/*.test.ts", "src/diagram/bundle.ts"],
    },
    "packages/harness": {
      "entry": ["{test,src}/**/*.test.ts"],
    },
  },
  "ignoreExportsUsedInFile": true,
  // plutil is a macOS system binary used by the desktop package smoke test.
  "ignoreBinaries": ["plutil"],
  "ignoreIssues": {
    // Migration step files are checksummed and must never be edited.
    "packages/workbench-server/src/infrastructure/migrations/steps/**": [
      "files",
      "exports",
      "types",
      "duplicates",
    ],
    // Intentional semantic aliases (event/request schemas) in the public contracts.
    "packages/contracts/src/domains/maintenance/maintenance.ts": ["duplicates"],
    "packages/contracts/src/domains/providers/providers.ts": ["duplicates"],
  },
}
