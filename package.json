{
  "name": "nerve",
  "version": "0.39.1",
  "private": true,
  "author": "ThilinaTLM",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build && tsx scripts/build/copy-workbench-app-dist-to-workbench-server.ts && tsx scripts/checks/check-built-package-exports.ts",
    "build:native": "pnpm --filter @nervekit/native build:native",
    "build:workbench-runtime": "pnpm --filter @nervekit/workbench-app... --filter @nervekit/workbench-server... build && tsx scripts/build/copy-workbench-app-dist-to-workbench-server.ts",
    "fix": "pnpm --filter @nervekit/native fix:native && oxfmt && eslint . --fix && oxfmt",
    "check": "oxfmt --check && eslint . && tsc -p scripts && tsx scripts/checks/check-package-boundaries.ts && pnpm migrations:check && pnpm -r check",
    "fix:focused": "tsx scripts/checks/run-focused.ts fix",
    "check:focused": "tsx scripts/checks/run-focused.ts check",
    "test:focused": "tsx scripts/testing/run-focused-tests.ts",
    "knip": "knip",
    "test:scripts": "tsx --test \"scripts/**/*.test.ts\"",
    "test:packages": "pnpm --workspace-concurrency=4 -r --if-present test",
    "test:packages:coverage": "c8 pnpm run test:packages",
    "test:full": "pnpm build:native && pnpm test:scripts && pnpm test:packages",
    "test:coverage": "c8 pnpm run test:full",
    "test:browser": "pnpm build:native && pnpm build:workbench-runtime && playwright test",
    "dev": "tsx scripts/development/dev-workbench.ts all",
    "dev:ui": "tsx scripts/development/dev-workbench.ts ui",
    "desktop:dev": "tsx packages/desktop-shell/scripts/dev-desktop.mjs",
    "desktop:prod": "pnpm --filter @nervekit/desktop-shell dev:prod --",
    "storage:copy": "tsx scripts/storage-migrations/run.ts copy",
    "storage:rehearse": "tsx scripts/storage-migrations/run.ts rehearse",
    "storage:migrate": "tsx scripts/storage-migrations/run.ts migrate",
    "migrations:check": "tsx scripts/storage-migrations/run.ts check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "25.9.5",
    "@types/ws": "8.18.1",
    "c8": "^12.0.0",
    "eslint": "10.6.0",
    "eslint-plugin-svelte": "3.20.0",
    "globals": "17.7.0",
    "knip": "6.44.1",
    "oxfmt": "0.58.0",
    "png-to-ico": "3.0.2",
    "sharp": "^0.35.5",
    "svelte": "5.56.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
