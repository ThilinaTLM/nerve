{
  "name": "nerve",
  "version": "0.25.0",
  "private": true,
  "author": "ThilinaTLM",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build && node scripts/copy-workbench-app-dist-to-workbench-server.mjs",
    "build:native": "pnpm --filter @nervekit/native build:native",
    "build:workbench-runtime": "pnpm --filter @nervekit/workbench-app... --filter @nervekit/workbench-server... build && node scripts/copy-workbench-app-dist-to-workbench-server.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "fix": "pnpm fix:native && oxfmt && eslint . --fix && oxfmt",
    "fix:native": "pnpm --filter @nervekit/native fix:native",
    "check": "oxfmt --check && eslint . && pnpm check:boundaries && pnpm -r check",
    "test": "pnpm build:native && pnpm test:scripts && pnpm -r --if-present test",
    "check:native": "pnpm --filter @nervekit/native check:native",
    "test:native": "pnpm --filter @nervekit/native test:native",
    "dev": "pnpm build:native && pnpm --filter @nervekit/contracts --filter @nervekit/protocol --filter @nervekit/harness --filter @nervekit/tools build && pnpm --parallel --stream --filter @nervekit/workbench-server --filter @nervekit/workbench-app dev",
    "dev:ui": "pnpm --filter @nervekit/contracts --filter @nervekit/protocol --filter @nervekit/harness --filter @nervekit/tools build && pnpm --filter @nervekit/workbench-app dev",
    "desktop": "pnpm --filter @nervekit/desktop-shell dev --",
    "performance:summarize": "node scripts/summarize-performance-jsonl.mjs",
    "release:bump-version": "node scripts/bump-release-version.mjs",
    "release:verify-tag": "node scripts/verify-release-tag.mjs",
    "release:verify-native": "node scripts/verify-native-prebuilds.mjs",
    "release:verify-npm": "node scripts/verify-npm-tarballs.mjs",
    "release:smoke:workbench": "node scripts/smoke-workbench-release.mjs",
    "release:smoke:desktop": "node scripts/smoke-desktop-release.mjs",
    "release:smoke:desktop-package": "node scripts/smoke-desktop-package.mjs",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.6.0",
    "eslint-plugin-svelte": "3.20.0",
    "globals": "17.7.0",
    "oxfmt": "0.58.0",
    "png-to-ico": "3.0.2",
    "sharp": "^0.35.3",
    "svelte": "5.56.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
